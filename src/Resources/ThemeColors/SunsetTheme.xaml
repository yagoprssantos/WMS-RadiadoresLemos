<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores Base -->
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="PanelBackgroundColor">#FFE8D6</Color>
    <Color x:Key="PrimaryColor">#FFD4B2</Color>
    <Color x:Key="SecondaryColor">#FFEEDE</Color>
    <Color x:Key="AccentColor">#B22500</Color>
    <Color x:Key="TextColor">#5C1200</Color>

    <!-- Cores de Estado -->
    <Color x:Key="HoverBackgroundColor">#FFBF8C</Color>
    <Color x:Key="HoverForegroundColor">#3D0C00</Color>
    <Color x:Key="CancelColor">#D00000</Color>
    <Color x:Key="CancelHoverColor">#A30000</Color>

    <!-- Brushes Principais -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />

    <!-- Brushes de Estado -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="CancelButtonBrush" Color="{StaticResource CancelColor}" />
    <SolidColorBrush x:Key="CancelButtonHoverBrush" Color="{StaticResource CancelHoverColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="HoverForegroundBrush" Color="{StaticResource HoverForegroundColor}" />
</ResourceDictionary>