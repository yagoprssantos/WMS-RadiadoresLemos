<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores Base -->
    <Color x:Key="BackgroundColor">#121212</Color>
    <Color x:Key="PanelBackgroundColor">#202020</Color>
    <Color x:Key="PrimaryColor">#2A2A2A</Color>
    <Color x:Key="SecondaryColor">#383838</Color>
    <Color x:Key="AccentColor">#7C9EFF</Color>
    <Color x:Key="TextColor">#E6E6E6</Color>

    <!-- Cores de Estado -->
    <Color x:Key="HoverBackgroundColor">#3A3A3A</Color>
    <Color x:Key="HoverForegroundColor">#FFFFFF</Color>
    <Color x:Key="CancelColor">#E53E3E</Color>
    <Color x:Key="CancelHoverColor">#FF0000</Color>

    <!-- Brushes Principais -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />

    <!-- Brushes de Estado -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="CancelButtonBrush" Color="{StaticResource CancelColor}" />
    <SolidColorBrush x:Key="CancelButtonHoverBrush" Color="{StaticResource CancelHoverColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="HoverForegroundBrush" Color="{StaticResource HoverForegroundColor}" />
</ResourceDictionary>