<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores Base -->
    <Color x:Key="BackgroundColor">#0A160A</Color>
    <Color x:Key="PanelBackgroundColor">#142814</Color>
    <Color x:Key="PrimaryColor">#1E3A1E</Color>
    <Color x:Key="SecondaryColor">#284C28</Color>
    <Color x:Key="AccentColor">#1D7A1D</Color> <!-- Verde mais escuro -->
    <Color x:Key="TextColor">#E0FFE0</Color>

    <!-- Cores de Estado -->
    <Color x:Key="HoverBackgroundColor">#325E32</Color>
    <Color x:Key="HoverForegroundColor">#FFFFFF</Color>
    <Color x:Key="CancelColor">#D42020</Color>
    <Color x:Key="CancelHoverColor">#FF0000</Color>

    <!-- Brushes Principais -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />

    <!-- Brushes de Estado -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="CancelButtonBrush" Color="{StaticResource CancelColor}" />
    <SolidColorBrush x:Key="CancelButtonHoverBrush" Color="{StaticResource CancelHoverColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="HoverForegroundBrush" Color="{StaticResource HoverForegroundColor}" />
</ResourceDictionary>