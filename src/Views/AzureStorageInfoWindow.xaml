<Window x:Class="WMS_RadiadoresLemos_WPF.Views.AzureStorageInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.Views"
        mc:Ignorable="d"
        Title="Informações do Azure Storage" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Informações do Azure Storage" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Espaço Total Usado:" 
                       FontSize="16" 
                       Margin="0,0,0,10"/>
            <TextBlock x:Name="TotalSpaceText" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>

            <TextBlock Text="Total de Arquivos:" 
                       FontSize="16" 
                       Margin="0,0,0,10"/>
            <TextBlock x:Name="TotalFilesText" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>

            <TextBlock Text="Última Modificação:" 
                       FontSize="16" 
                       Margin="0,0,0,10"/>
            <TextBlock x:Name="LastModifiedText" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>

            <TextBlock Text="Últimos Arquivos:" 
                       FontSize="16" 
                       Margin="0,0,0,10"/>
            <ListView x:Name="FilesListView" 
                      Height="200" 
                      Margin="0,0,0,20">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nome" 
                                      DisplayMemberBinding="{Binding FileName}" 
                                      Width="200"/>
                        <GridViewColumn Header="Data" 
                                      DisplayMemberBinding="{Binding Date}" 
                                      Width="150"/>
                        <GridViewColumn Header="Tamanho" 
                                      DisplayMemberBinding="{Binding Size}" 
                                      Width="100"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

        <Button Grid.Row="2" 
                Content="Fechar" 
                Click="CloseButton_Click" 
                Width="100" 
                Height="30" 
                HorizontalAlignment="Right"/>

        <Button Grid.Row="2" 
                Content="Ver Histórico" 
                Click="ShowHistoryButton_Click" 
                Width="120" 
                Height="30" 
                HorizontalAlignment="Left"/>
    </Grid>
</Window> 