<UserControl x:Class="WMS_RadiadoresLemos_WPF.UsuariosUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <DockPanel Margin="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" DockPanel.Dock="Bottom">
                <Button Content="Adicionar Usuário" Click="AdicionarUsuario_Click" Width="200" Margin="10" Style="{StaticResource EmphasisButtonStyle}" FontSize="18"/>
                <Button Content="Editar Usuário" Click="EditarUsuario_Click" Width="150" Margin="10" Style="{StaticResource EmphasisButtonStyle}" FontSize="18"/>
                <Button Content="Deletar Usuário" Click="DeletarUsuario_Click" Width="150" Margin="10" Style="{StaticResource CancelButtonStyle}" FontSize="18"/>
            </StackPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Pesquisar:" VerticalAlignment="Center" FontSize="18" Margin="0,0,10,0" Foreground="{StaticResource TextBrush}"/>
                <TextBox Name="SearchBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontSize="18"/>
                <Button Content="↺" ToolTip="Atualizar" Click="AtualizarDataGrid_Click" HorizontalAlignment="Center" VerticalAlignment="Top" Background="Transparent" Foreground="{StaticResource TextBrush}" Margin="7, 0, 0, 0" FontSize="33" Grid.Column="3"/>
            </Grid>

            <DataGrid x:Name="UsuariosDataGrid" FontSize="18"
                        AutoGenerateColumns="False" IsReadOnly="True" 
                        SelectionMode="Single" SelectionUnit="FullRow"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                        Margin="0,0,0,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="Auto"
                        AlternatingRowBackground="{StaticResource AlternativeLineBrush}" AlternationCount="2"
                        CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                        ColumnWidth="*"
                        MouseDoubleClick="UsuariosDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" IsReadOnly="True" Width="*" MinWidth="150" MaxWidth="500"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" IsReadOnly="True" Width="*" MinWidth="166" MaxWidth="500"/>
                    <DataGridTextColumn Header="Matrícula" Binding="{Binding Matrícula}" IsReadOnly="True" Width="*" MinWidth="150" MaxWidth="100"/>
                    <DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" IsReadOnly="True" Width="*" MinWidth="150" MaxWidth="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
