<Window x:Class="WMS_RadiadoresLemos_WPF.src.Views.ImportSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sucesso" Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <Grid Grid.Row="0" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="18" Padding="10" Margin="5,0,5,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="✅ Banco de dados importado com sucesso!" Foreground="{StaticResource TextBrush}" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Conteúdo -->
        <Border Grid.Row="1" CornerRadius="15" Background="{StaticResource SecondaryBrush}" Padding="15" Margin="0,10">
            <StackPanel>
                <TextBlock Text="📦 Backup do banco anterior:" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock x:Name="NomeBackupText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="20,0,0,5"/>
                <TextBlock x:Name="DataBackupText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="20,0,0,15"/>
                <TextBlock Text="🔄 O aplicativo será reiniciado para aplicar as alterações." Foreground="{StaticResource TextBrush}" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Botões -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelarButton" Content="CANCELAR" Style="{StaticResource EmphasisButtonStyle}" Click="CancelarButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="ConfirmarButton" Content="REINICIAR" Style="{StaticResource EmphasisButtonStyle}" Click="ConfirmarButton_Click"/>
        </StackPanel>
    </Grid>
</Window> 