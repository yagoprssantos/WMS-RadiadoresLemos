<Window x:Class="WMS_RadiadoresLemos_WPF.Views.ImportSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importação Concluída" Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="✅ Importação concluída com sucesso!"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,10">
            <TextBlock Text="Detalhes da importação:"
                       Foreground="White"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            
            <TextBlock x:Name="BackupInfoText"
                       Foreground="White"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>
            
            <TextBlock Text="⚠️ Importante:"
                       Foreground="#FFFFD700"
                       FontWeight="Bold"
                       Margin="0,10,0,5"/>
            
            <TextBlock Text="• O banco de dados foi substituído com sucesso&#x0a;• Um backup do banco anterior foi criado automaticamente&#x0a;• Você pode restaurar o banco anterior a qualquer momento"
                       Foreground="White"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Confirmar" 
                    Click="ConfirmButton_Click"
                    Style="{StaticResource ButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window> 