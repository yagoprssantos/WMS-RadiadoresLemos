<Window x:Class="WMS_RadiadoresLemos_WPF.Views.ImportSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importação Concluída" Height="300" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="✅ Importação concluída com sucesso!" 
                   FontSize="18" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock x:Name="FileNameText" Margin="0,0,0,10"/>
            <TextBlock x:Name="DateText" Margin="0,0,0,10"/>
            <TextBlock x:Name="SourceText" Margin="0,0,0,10"/>
            <TextBlock x:Name="DestinationText" Margin="0,0,0,10"/>
        </StackPanel>

        <Button Grid.Row="2" 
                x:Name="CloseButton"
                Content="Fechar" 
                Width="100" 
                HorizontalAlignment="Center"
                Click="CloseButton_Click"/>
    </Grid>
</Window> 