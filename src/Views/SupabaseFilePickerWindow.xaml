<Window x:Class="WMS_RadiadoresLemos_WPF.src.Views.SupabaseFilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher Backup" Height="350" Width="400" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="10">
        <TextBlock Text="Selecione um arquivo de backup:" FontWeight="Bold" Margin="0,0,0,10"/>
        <ListBox x:Name="ArquivosListBox" Height="200" DisplayMemberPath="name"/>
        <Button Content="Importar Selecionado" Margin="0,10,0,0" Click="ImportarSelecionado_Click"/>
    </StackPanel>
</Window>
