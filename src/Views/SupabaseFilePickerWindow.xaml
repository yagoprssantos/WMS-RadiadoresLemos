<Window x:Class="WMS_RadiadoresLemos_WPF.SupabaseFilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.src.Views"
        Title="Selecionar Arquivo do Supabase"
        Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <local:DateTimeToLocalConverter x:Key="DateTimeToLocalConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <Border Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="15" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="Selecione um arquivo do Supabase:" 
                    Foreground="{StaticResource TextBrush}"
                    FontSize="16" 
                    HorizontalAlignment="Center"/>
        </Border>

        <!-- Lista de arquivos -->
        <Border Grid.Row="1" CornerRadius="15" Background="{StaticResource SecondaryBrush}" Padding="5" Margin="0,10">
            <DataGrid x:Name="ArquivosDataGrid" 
                    Style="{StaticResource CustomDataGridStyle}" 
                    AutoGenerateColumns="False"
                    SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding name}" Width="*" MinWidth="200"/>
                    <DataGridTextColumn Header="Tamanho" Binding="{Binding size, StringFormat={}{0:N0} bytes}" Width="*" MinWidth="100" />
                    <DataGridTextColumn Header="Data de Criação" Binding="{Binding created_at, Converter={StaticResource DateTimeToLocalConverter}, StringFormat=dd/MM/yyyy HH:mm}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="Última Atualização" Binding="{Binding updated_at, Converter={StaticResource DateTimeToLocalConverter}, StringFormat=dd/MM/yyyy HH:mm}" Width="*" MinWidth="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Botões -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SelecionarButton" Content="SELECIONAR" Style="{StaticResource EmphasisButtonStyle}" Click="SelecionarButton_Click"/>
            <Button x:Name="CancelarButton" Content="CANCELAR" Style="{StaticResource EmphasisButtonStyle}" Click="CancelarButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
