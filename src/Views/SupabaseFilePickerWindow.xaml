<Window x:Class="WMS_RadiadoresLemos_WPF.SupabaseFilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.src.Views"
        Title="Selecionar Arquivo do Supabase"
        Height="630" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <local:DateTimeToLocalConverter x:Key="DateTimeToLocalConverter"/>
        <local:BytesToKBConverter x:Key="BytesToKBConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra de pesquisa --><!--
                <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}" CornerRadius="15" Height="36" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                              Fill="{StaticResource TextBrush}" Width="23" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Fill" Margin="10,0,10,0"/>
                        <TextBox Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" 
                                 Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="5,0" Margin="0,0,10,0"/>
                    </Grid>
                </Border>-->

                <!-- Título e Status - similar ao SupabaseWindow -->
                <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="15" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Selecione um arquivo do Supabase:" Foreground="{StaticResource TextBrush}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <ProgressBar x:Name="LoadingProgress" Height="2" Margin="0,5,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Lista de arquivos -->
                <Border Grid.Row="2" CornerRadius="15" Background="{StaticResource SecondaryBrush}" Padding="5" Margin="0,0,0,15">
                    <DataGrid x:Name="ArquivosDataGrid" 
                              Style="{StaticResource CustomDataGridStyle}" 
                              AutoGenerateColumns="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding name}" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding size, Converter={StaticResource BytesToKBConverter}}" Width="*" MinWidth="100" />
                            <DataGridTextColumn Header="Data de Criação" Binding="{Binding created_at, Converter={StaticResource DateTimeToLocalConverter}, StringFormat=dd/MM/yyyy HH:mm}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Última Atualização" Binding="{Binding updated_at, Converter={StaticResource DateTimeToLocalConverter}, StringFormat=dd/MM/yyyy HH:mm}" Width="*" MinWidth="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Botões -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="SelecionarButton" Content="Selecionar Arquivo" Style="{StaticResource EmphasisButtonStyle}" 
                            Click="SelecionarButton_Click" Width="180" Height="40" Margin="10,0,10,0"/>
                    <Button x:Name="CancelarButton" Content="Cancelar" Style="{StaticResource EmphasisButtonStyle}"
                            Background="{StaticResource HoverBackgroundBrush}"
                            Click="CancelarButton_Click" Width="120" Height="40" Margin="10,0,10,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>