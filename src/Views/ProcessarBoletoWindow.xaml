<Window x:Class="WMS_RadiadoresLemos_WPF.src.Views.ProcessarBoletoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Processar Boleto" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Processamento de Boletos" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Selecione um arquivo PDF de boleto para extrair o XML" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="SelecionarPdfButton" Content="Selecionar PDF" Click="SelecionarPdfButton_Click" Margin="0,0,10,0"/>
                <TextBlock x:Name="ArquivoSelecionadoText" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto" Background="#F5F5F5"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ProcessarButton" Content="Processar" Click="ProcessarButton_Click" 
                    Margin="0,0,10,0" Padding="20,5"/>
            <Button x:Name="FecharButton" Content="Fechar" Click="FecharButton_Click" 
                    Padding="20,5"/>
        </StackPanel>
    </Grid>
</Window> 