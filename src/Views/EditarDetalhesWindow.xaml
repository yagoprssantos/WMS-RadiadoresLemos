<Window x:Class="WMS_RadiadoresLemos_WPF.src.Views.EditarDetalhesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2005"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Editar Detalhes da Compra"
        Height="820" Width="1320"
        MinHeight="600" MinWidth="700"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <!-- Border Principal -->
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" 
                CornerRadius="15" Padding="20" Background="{StaticResource PanelBackgroundBrush}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Editar Detalhes" FontSize="22" FontWeight="Bold" 
                              Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" 
                              Margin="0,0,0,10"/>
                    <Separator Background="{StaticResource HoverBackgroundBrush}" Height="1"/>
                </StackPanel>

                <!-- Conteúdo Principal com ScrollViewer -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Coluna Esquerda: Informações da Compra -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <!-- SEÇÃO: INFORMAÇÕES DA COMPRA -->
                            <Border CornerRadius="15" Padding="15" Margin="0,0,0,15"
                                    Background="{StaticResource SecondaryBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBlock Grid.Column="0"
                                                       Text="Informações da Compra"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       Foreground="{StaticResource TextBrush}"/>

                                            <Button Grid.Column="1"
                                                    x:Name="ExpandirInfoCompraButton"
                                                    Margin="0"
                                                    Foreground="{StaticResource TextBrush}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Content="▼"
                                                    FontSize="16"
                                                    Height="30"
                                                    Width="30"
                                                    Click="ExpandirInfoCompraButton_Click"/>
                                        </Grid>
                                    </Grid>

                                    <!-- Conteúdo expansível -->
                                    <StackPanel x:Name="InfoCompraConteudo" Visibility="Visible">
                                        <!-- Nota Fiscal e Fornecedor (lado a lado) -->
                                        <Grid Margin="0,10,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Nota Fiscal -->
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="Nota Fiscal:" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="NotaFiscalTextBox" FontSize="14"
                                                             VerticalContentAlignment="Center"
                                                             Style="{StaticResource {x:Type TextBox}}" 
                                                             Background="{StaticResource PanelBackgroundBrush}"
                                                             Foreground="{StaticResource TextBrush}"/>
                                                    <Button Grid.Column="1" Content="Importar XML" Style="{StaticResource EmphasisButtonStyle}"
                                                            FontSize="12" Margin="10,0,0,0"
                                                            Click="ImportarXML_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Data da Compra e Valor Total (lado a lado) -->
                                        <Grid Margin="0,5,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Fornecedor -->
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0" >
                                                <TextBlock Text="Fornecedor:" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="FornecedorComboBox" Style="{StaticResource ComboBoxSearchStyle}"
                                                         FontSize="14" Margin="0" HorizontalAlignment="Stretch"
                                                         Background="{StaticResource PanelBackgroundBrush}"
                                                         IsEditable="True" StaysOpenOnEdit="True"
                                                         LostFocus="FornecedorComboBox_LostFocus" TextBoxBase.TextChanged="FornecedorComboBox_TextChanged"/>
                                            </StackPanel>

                                            <!-- Data da Compra -->
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="Data da Compra:" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                                <DatePicker x:Name="DataCompraDatePicker" Style="{StaticResource DatePickerStyle}"
                                                           FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Detalhes -->
                                        <StackPanel Margin="0">
                                            <TextBlock Text="Detalhes:" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                            <TextBox x:Name="DetalhesTextBox" FontSize="14" MinHeight="30"
                                                    Style="{StaticResource {x:Type TextBox}}" 
                                                    Background="{StaticResource PanelBackgroundBrush}"
                                                    Foreground="{StaticResource TextBrush}"
                                                    TextWrapping="Wrap" AcceptsReturn="True"
                                                    VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SEÇÃO: INFORMAÇÕES DE PAGAMENTO -->
                            <Border CornerRadius="15" Padding="15" Margin="0,0,0,15"
                                    Background="{StaticResource SecondaryBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBlock Grid.Column="0"
                                                        Text="Informações de Pagamento"
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        Foreground="{StaticResource TextBrush}"/>

                                            <Button Grid.Column="1"
                                                    x:Name="ExpandirPagamentoButton"
                                                    Margin="0"
                                                    Foreground="{StaticResource TextBrush}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Content="▼"
                                                    FontSize="16"
                                                    Height="30"
                                                    Width="30"
                                                    Click="ExpandirPagamentoButton_Click"/>
                                        </Grid>
                                    </Grid>


                                    <!-- Conteúdo expansível -->
                                    <StackPanel x:Name="PagamentoConteudo" Visibility="Visible">
                                        <!-- Forma de Pagamento e Parcelas (lado a lado) -->
                                        <Grid Margin="0,10,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Forma de Pagamento -->
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="Forma de Pagamento:" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="TipoPagamentoComboBox" Style="{StaticResource ComboBoxSelectStyle}"
                                                         FontSize="14" HorizontalAlignment="Stretch" Margin="0"
                                                         Background="{StaticResource PanelBackgroundBrush}"
                                                         SelectionChanged="TipoPagamentoComboBox_SelectionChanged">
                                                    <ComboBoxItem Content="À vista"/>
                                                    <ComboBoxItem Content="Parcelado"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Parcelas -->
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="Parcelas:" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                                <TextBox x:Name="ParcelasTextBox" FontSize="14" Height="34"
                                                        Style="{StaticResource {x:Type TextBox}}" 
                                                        Background="{StaticResource PanelBackgroundBrush}"
                                                        Foreground="{StaticResource TextBrush}"
                                                        PreviewTextInput="ParcelasTextBox_PreviewTextInput"
                                                        TextChanged="ParcelasTextBox_TextChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SEÇÃO: ITENS DA COMPRA -->
                            <Border CornerRadius="15" Padding="15" Margin="0,0,0,15"
                                    Background="{StaticResource SecondaryBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Height="36" VerticalAlignment="Top">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="Itens da Compra"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       Foreground="{StaticResource TextBrush}"/>

                                            <StackPanel Grid.Column="1" 
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Margin="10,0,0,0">
                                                <TextBlock Text="Total:" 
                                                           Foreground="{StaticResource TextBrush}" 
                                                           FontSize="16"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding ValorTotal, StringFormat='R$ {0:N2}'}" 
                                                           Foreground="{StaticResource AccentBrush}" 
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Adicionar Item" 
                                                    Style="{StaticResource EmphasisButtonStyle}" 
                                                    Margin="0,0,10,0"
                                                    FontSize="12"
                                                    Height="Auto"
                                                    HorizontalAlignment="Right"
                                                    Click="AdicionarItem_Click"/>
                                        </Grid>

                                        <Button Grid.Column="3"
                                                x:Name="ExpandirItensButton"
                                                Margin="0"
                                                Foreground="{StaticResource TextBrush}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Content="▼"
                                                FontSize="16"
                                                Height="30"
                                                Width="30"
                                                Click="ExpandirItensButton_Click"/>
                                    </Grid>

                                    <!-- Conteúdo expansível usando Grid -->
                                    <Grid x:Name="ItensConteudo" Visibility="Visible" Margin="0,10,0,0">
                                        <DataGrid x:Name="ItensDataGrid" 
                                                  FontSize="14"
                                                  Style="{StaticResource CustomDataGridStyle}"
                                                  Background="Transparent" 
                                                  BorderBrush="Transparent" 
                                                  BorderThickness="0"
                                                  AutoGenerateColumns="False"
                                                  VerticalScrollBarVisibility="Auto"
                                                  CellEditEnding="ItensDataGrid_CellEditEnding"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  VerticalContentAlignment="Stretch">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Produto" 
                                                                    Binding="{Binding ProdutoNome}" 
                                                                    Width="Auto" 
                                                                    FontSize="14"
                                                                    IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Quantidade" 
                                                                    Binding="{Binding Quantidade}" 
                                                                    Width="Auto" 
                                                                    MinWidth="90" 
                                                                    FontSize="14"/>
                                                <DataGridTextColumn Header="Preço" 
                                                                    Binding="{Binding Preco, StringFormat=R$ {0:N2}}" 
                                                                    Width="Auto" 
                                                                    MinWidth="110" 
                                                                    FontSize="14"/>
                                                <DataGridTextColumn Header="Subtotal" 
                                                                    Binding="{Binding Subtotal, StringFormat={}{0:C2}}" 
                                                                    Width="Auto" 
                                                                    MinWidth="110" 
                                                                    FontSize="14"/>
                                                <DataGridTemplateColumn Width="Auto" 
                                                                       MinWidth="70" 
                                                                       Header="Ações">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Editar" 
                                                                    Style="{StaticResource EmphasisButtonStyle}"
                                                                    FontSize="11" 
                                                                    Padding="5,2" 
                                                                    Margin="2"
                                                                    Click="EditarItem_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Coluna Direita: Boletos -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" x:Name="BoletosSection">
                            <!-- SEÇÃO: BOLETOS -->
                            <Border CornerRadius="15" Padding="15" Margin="0,0,0,15"
                                    Background="{StaticResource SecondaryBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBlock Grid.Column="0"
                                                        Text="Boletos"
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        Foreground="{StaticResource TextBrush}"/>

                                            <Button Grid.Column="1"
                                                    Content="Adicionar Boleto" 
                                                    Style="{StaticResource EmphasisButtonStyle}" 
                                                    Margin="0,0,10,0"
                                                    FontSize="12" 
                                                    Height="Auto"
                                                    HorizontalAlignment="Right"
                                                    Click="AdicionarBoleto_Click"/>
                                        </Grid>

                                        <Button Grid.Column="2"
                                                x:Name="ExpandirBoletosButton"
                                                Margin="0"
                                                Foreground="{StaticResource TextBrush}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Content="▼"
                                                FontSize="16"
                                                Height="30"
                                                Width="30"
                                                Click="ExpandirBoletosButton_Click"/>
                                    </Grid>

                                    <!-- Conteúdo expansível -->
                                    <StackPanel x:Name="BoletosConteudo" Visibility="Visible" Margin="0,10,0,0">
                                        <TextBlock x:Name="SemBoletosMessage" Text="Nenhum boleto cadastrado"
                                                  FontSize="14" Foreground="{StaticResource TextBrush}"
                                                  HorizontalAlignment="Center" Margin="0,10,0,0"/>

                                        <!-- Lista de Boletos -->
                                        <ItemsControl x:Name="BoletosItemsControl" HorizontalAlignment="Stretch">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5" Background="{StaticResource PanelBackgroundBrush}" 
                                                            CornerRadius="15" Padding="10" HorizontalAlignment="Stretch">
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Cabeçalho do Boleto - mais compacto -->
                                                            <DockPanel Grid.Row="0" LastChildFill="True">
                                                                <TextBlock DockPanel.Dock="Left" 
                                                                           Text="{Binding Parcela, StringFormat='Parcela {0}'}"
                                                                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                                <Button DockPanel.Dock="Right" Content="✖" 
                                                                        Style="{StaticResource DeleteButtonStyle}"
                                                                        Width="24" Height="24" VerticalAlignment="Center"
                                                                        Click="RemoverBoleto_Click" Tag="{Binding Parcela}"/>

                                                                <TextBlock Text="{Binding NomeArquivo}"
                                                                           FontSize="14" Foreground="{StaticResource TextBrush}"
                                                                           TextTrimming="CharacterEllipsis" 
                                                                           VerticalAlignment="Center"
                                                                           ToolTip="{Binding NomeArquivo}"/>
                                                            </DockPanel>

                                                            <!-- Detalhes do Boleto - layout melhorado -->
                                                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <!-- Vencimento e Pagamento - lado a lado -->
                                                                <UniformGrid Grid.Row="0" Rows="1" Columns="2" Margin="0,0,0,10">
                                                                    <!-- Vencimento -->
                                                                    <StackPanel Margin="0,0,5,0">
                                                                        <TextBlock Text="Vencimento:" FontSize="14" 
                                                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                                                        <DatePicker SelectedDate="{Binding Vencimento}" 
                                                                                    Style="{StaticResource DatePickerStyle}"
                                                                                    Height="30" FontSize="14" HorizontalAlignment="Stretch"/>
                                                                    </StackPanel>

                                                                    <!-- Pagamento -->
                                                                    <StackPanel Margin="5,0,0,0">
                                                                        <TextBlock Text="Pagamento:" FontSize="14" 
                                                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                                                        <DatePicker SelectedDate="{Binding Pagamento}" 
                                                                                    Style="{StaticResource DatePickerStyle}"
                                                                                    Height="30" FontSize="14" HorizontalAlignment="Stretch"/>
                                                                    </StackPanel>
                                                                </UniformGrid>

                                                                <!-- Arquivo - layout adaptativo -->
                                                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Container do arquivo com tamanho adaptativo -->
                                                                    <Border Grid.Column="0" Background="{StaticResource SecondaryBrush}" 
                                                                            CornerRadius="15" Padding="8,5" Margin="0,0,10,0"
                                                                            HorizontalAlignment="Stretch">
                                                                        <TextBlock Text="{Binding CaminhoArquivo}" 
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   HorizontalAlignment="Left"
                                                                                   VerticalAlignment="Center"
                                                                                   MaxWidth="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=ActualWidth, ConverterParameter=16}"
                                                                                   FontSize="12" Foreground="{StaticResource TextBrush}"
                                                                                   ToolTip="{Binding CaminhoArquivo}"/>
                                                                    </Border>

                                                                    <!-- Botão Selecionar Arquivo -->
                                                                    <Button Grid.Column="1" Content="Selecionar" 
                                                                            Style="{StaticResource EmphasisButtonStyle}"
                                                                            FontSize="12" Height="Auto" Margin="0" MinWidth="80"
                                                                            Click="SelecionarBoleto_Click" Tag="{Binding Parcela}"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Botões de Ação -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Botão Cancelar -->
                    <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource CancelButtonStyle}"
                           FontSize="14" Width="120" Height="40" Margin="0,0,15,0" Click="Cancelar_Click"/>

                    <!-- Botão Salvar -->
                    <Button Grid.Column="2" Content="Salvar Alterações" Style="{StaticResource EmphasisButtonStyle}"
                           FontSize="14" Width="160" Height="40" Margin="0" Click="Salvar_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>