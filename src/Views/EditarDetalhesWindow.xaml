<Window x:Class="WMS_RadiadoresLemos_WPF.src.Views.EditarDetalhesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2005"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Editar Detalhes da Compra"
        Height="900" Width="1000"
        MinHeight="600" MinWidth="700"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <!-- Border Principal -->
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" 
                CornerRadius="15" Padding="20" Background="{StaticResource PanelBackgroundBrush}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Editar Detalhes" FontSize="22" FontWeight="Bold" 
                              Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" 
                              Margin="0,0,0,10"/>
                    <Separator Background="{StaticResource HoverBackgroundBrush}" Height="1"/>
                </StackPanel>

                <!-- Conteúdo Principal com ScrollViewer -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Coluna Esquerda: Informações da Compra -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <!-- SEÇÃO: INFORMAÇÕES DA COMPRA -->
                            <Border CornerRadius="15" Padding="15" Margin="0,0,0,15"
                                    Background="{StaticResource SecondaryBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Informações da Compra" FontSize="18" FontWeight="SemiBold" 
                                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                                        <Button Grid.Column="1" x:Name="ExpandirInfoCompraButton" Content="▼" 
                                               Style="{StaticResource EmphasisButtonStyle}" Width="30" Height="30"
                                               Click="ExpandirInfoCompraButton_Click"/>
                                    </Grid>

                                    <!-- Conteúdo expansível -->
                                    <StackPanel x:Name="InfoCompraConteudo" Visibility="Visible">
                                        <!-- Nota Fiscal -->
                                        <StackPanel Margin="0,10,0,5">
                                            <TextBlock Text="Nota Fiscal:" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="NotaFiscalTextBox" FontSize="14" Height="35" 
                                                        Style="{StaticResource {x:Type TextBox}}" 
                                                        Background="{StaticResource PanelBackgroundBrush}"
                                                        Foreground="{StaticResource TextBrush}"/>
                                                <Button Grid.Column="1" Content="Importar XML" Style="{StaticResource EmphasisButtonStyle}"
                                                       FontSize="12" Padding="10,0" Margin="5,0,0,0" Height="35"
                                                       Click="ImportarXML_Click"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Fornecedor -->
                                        <StackPanel Margin="0,5,0,5">
                                            <TextBlock Text="Fornecedor:" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="FornecedorComboBox" Style="{StaticResource ComboBoxSearchStyle}"
                                                     FontSize="14" Height="35" 
                                                     Background="{StaticResource PanelBackgroundBrush}"
                                                     IsEditable="True" StaysOpenOnEdit="True"
                                                     LostFocus="FornecedorComboBox_LostFocus" 
                                                     TextBoxBase.TextChanged="FornecedorComboBox_TextChanged"/>
                                        </StackPanel>

                                        <!-- Data da Compra -->
                                        <StackPanel Margin="0,5,0,5">
                                            <TextBlock Text="Data da Compra:" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                            <DatePicker x:Name="DataCompraDatePicker" Style="{StaticResource DatePickerStyle}"
                                                       Height="35" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                        </StackPanel>

                                        <!-- Valor Total -->
                                        <StackPanel Margin="0,5,0,5">
                                            <TextBlock Text="Valor Total:" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="ValorTotalTextBlock" FontSize="16" FontWeight="Bold" 
                                                      Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelBackgroundBrush}"
                                                      Padding="10,8" Height="35" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Detalhes -->
                                        <StackPanel Margin="0,5">
                                            <TextBlock Text="Detalhes:" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                            <TextBox x:Name="DetalhesTextBox" FontSize="14" MinHeight="60"
                                                    Style="{StaticResource {x:Type TextBox}}" 
                                                    Background="{StaticResource PanelBackgroundBrush}"
                                                    Foreground="{StaticResource TextBrush}"
                                                    TextWrapping="Wrap" AcceptsReturn="True"
                                                    VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SEÇÃO: INFORMAÇÕES DE PAGAMENTO -->
                            <Border CornerRadius="15" Padding="15" Margin="0,0,0,15"
                                    Background="{StaticResource SecondaryBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Informações de Pagamento" FontSize="18" FontWeight="SemiBold" 
                                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                                        <Button Grid.Column="1" x:Name="ExpandirPagamentoButton" Content="▼" 
                                               Style="{StaticResource EmphasisButtonStyle}" Width="30" Height="30"
                                               Click="ExpandirPagamentoButton_Click"/>
                                    </Grid>

                                    <!-- Conteúdo expansível -->
                                    <StackPanel x:Name="PagamentoConteudo" Visibility="Visible">
                                        <!-- Tipo de Pagamento -->
                                        <StackPanel Margin="0,10,0,5">
                                            <TextBlock Text="Forma de Pagamento:" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="TipoPagamentoComboBox" Style="{StaticResource ComboBoxSelectStyle}"
                                                     FontSize="14" Height="35" 
                                                     Background="{StaticResource PanelBackgroundBrush}"
                                                     SelectionChanged="TipoPagamentoComboBox_SelectionChanged">
                                                <ComboBoxItem Content="À vista"/>
                                                <ComboBoxItem Content="Parcelado"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Parcelas -->
                                        <StackPanel Margin="0,5,0,5">
                                            <TextBlock Text="Parcelas:" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                            <TextBox x:Name="ParcelasTextBox" FontSize="14" Height="35"
                                                    Style="{StaticResource {x:Type TextBox}}" 
                                                    Background="{StaticResource PanelBackgroundBrush}"
                                                    Foreground="{StaticResource TextBrush}"
                                                    PreviewTextInput="ParcelasTextBox_PreviewTextInput"
                                                    TextChanged="ParcelasTextBox_TextChanged"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SEÇÃO: ITENS DA COMPRA -->
                            <Border CornerRadius="15" Padding="15" Margin="0,0,0,15"
                                    Background="{StaticResource SecondaryBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Itens da Compra" FontSize="18" FontWeight="SemiBold" 
                                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                                        <Button Grid.Column="1" x:Name="ExpandirItensButton" Content="▼" 
                                               Style="{StaticResource EmphasisButtonStyle}" Width="30" Height="30"
                                               Click="ExpandirItensButton_Click"/>
                                    </Grid>

                                    <!-- Conteúdo expansível -->
                                    <StackPanel x:Name="ItensConteudo" Visibility="Visible">
                                        <!-- DataGrid de Itens -->
                                        <DataGrid x:Name="ItensDataGrid" Style="{StaticResource CustomDataGridStyle}"
                                                 Background="Transparent" BorderThickness="0"
                                                 AutoGenerateColumns="False" MinHeight="150" MaxHeight="300"
                                                 Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Produto" Binding="{Binding ProdutoNome}" 
                                                                   Width="*" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" 
                                                                   Width="Auto"/>
                                                <DataGridTextColumn Header="Preço" 
                                                                   Binding="{Binding Preco, StringFormat=R$ {0:N2}}" 
                                                                   Width="Auto"/>
                                                <DataGridTemplateColumn Header="Subtotal" Width="Auto" IsReadOnly="True">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Preco}"
                                                                      VerticalAlignment="Center" Margin="5,0"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="Auto">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Editar" Style="{StaticResource EmphasisButtonStyle}"
                                                                   FontSize="11" Padding="5,2" Margin="2"
                                                                   Click="EditarItem_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Botão Adicionar Item -->
                                        <Button Content="Adicionar Item" Style="{StaticResource EmphasisButtonStyle}"
                                               FontSize="14" Padding="15,5" Margin="0,10,0,0" HorizontalAlignment="Center"
                                               Click="AdicionarItem_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Coluna Direita: Boletos -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <!-- SEÇÃO: BOLETOS -->
                            <Border CornerRadius="15" Padding="15" Margin="0,0,0,15"
                                    Background="{StaticResource SecondaryBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Boletos" FontSize="18" FontWeight="SemiBold" 
                                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"
                                                  VerticalAlignment="Center"/>

                                        <Button Grid.Column="1" Content="Adicionar Boleto" 
                                               Style="{StaticResource EmphasisButtonStyle}" Margin="0,0,10,0"
                                               FontSize="14" Padding="12,5" Height="30"
                                               Click="AdicionarBoleto_Click"/>

                                        <Button Grid.Column="2" x:Name="ExpandirBoletosButton" Content="▼" 
                                               Style="{StaticResource EmphasisButtonStyle}" Width="30" Height="30"
                                               Click="ExpandirBoletosButton_Click"/>
                                    </Grid>

                                    <!-- Conteúdo expansível -->
                                    <StackPanel x:Name="BoletosConteudo" Visibility="Visible" Margin="0,10,0,0">
                                        <TextBlock x:Name="SemBoletosMessage" Text="Nenhum boleto cadastrado"
                                                  FontSize="14" Foreground="{StaticResource TextBrush}"
                                                  HorizontalAlignment="Center" Margin="0,10,0,0"/>

                                        <!-- Lista de Boletos -->
                                        <ItemsControl x:Name="BoletosItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5" Background="{StaticResource PanelBackgroundBrush}" 
                                                           CornerRadius="10" Padding="15">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Cabeçalho do Boleto -->
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="{Binding Parcela, StringFormat='Parcela {0}'}"
                                                                          FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                                          VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                                <TextBlock Grid.Column="1" Text="{Binding NomeArquivo}"
                                                                          FontSize="14" Foreground="{StaticResource TextBrush}"
                                                                          TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                                <Button Grid.Column="2" Content="✖" Style="{StaticResource DeleteButtonStyle}"
                                                                       Width="24" Height="24" VerticalAlignment="Center"
                                                                       Click="RemoverBoleto_Click" Tag="{Binding Parcela}"/>
                                                            </Grid>

                                                            <!-- Detalhes do Boleto -->
                                                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                                <!-- Vencimento e Pagamento -->
                                                                <Grid Margin="0,0,0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Vencimento -->
                                                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                                        <TextBlock Text="Vencimento:" FontSize="14" 
                                                                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                                                        <DatePicker SelectedDate="{Binding Vencimento}" 
                                                                                   Style="{StaticResource DatePickerStyle}"
                                                                                   Height="30" FontSize="14" HorizontalAlignment="Stretch"/>
                                                                    </StackPanel>

                                                                    <!-- Pagamento -->
                                                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                                        <TextBlock Text="Pagamento:" FontSize="14" 
                                                                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                                                        <DatePicker SelectedDate="{Binding Pagamento}" 
                                                                                   Style="{StaticResource DatePickerStyle}"
                                                                                   Height="30" FontSize="14" HorizontalAlignment="Stretch"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Arquivo -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Grid.Column="0" Background="{StaticResource SecondaryBrush}" 
                                                                           CornerRadius="5" Padding="8,5" Margin="0,0,5,0">
                                                                        <TextBlock Text="{Binding CaminhoArquivo}" 
                                                                                  TextTrimming="CharacterEllipsis"
                                                                                  FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                                    </Border>

                                                                    <!-- Botão Selecionar Arquivo -->
                                                                    <Button Grid.Column="1" Content="Selecionar Arquivo" 
                                                                           Style="{StaticResource EmphasisButtonStyle}"
                                                                           FontSize="12" Padding="10,5" Height="30"
                                                                           Click="SelecionarBoleto_Click" Tag="{Binding Parcela}"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SEÇÃO: RESUMO DOS BOLETOS -->
                            <Border CornerRadius="15" Padding="15" Margin="0,0,0,15"
                                    Background="{StaticResource SecondaryBrush}">
                                <StackPanel>
                                    <TextBlock Text="Resumo dos Boletos" FontSize="18" FontWeight="SemiBold" 
                                              Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Total de Boletos:" 
                                                  Foreground="{StaticResource TextBrush}" FontSize="14" 
                                                  Margin="0,0,10,5"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TotalBoletosTextBlock" 
                                                  Foreground="{StaticResource TextBrush}" FontSize="14" 
                                                  Margin="0,0,0,5" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Próximo Vencimento:" 
                                                  Foreground="{StaticResource TextBrush}" FontSize="14" 
                                                  Margin="0,0,10,5"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProximoVencimentoTextBlock" 
                                                  Foreground="{StaticResource TextBrush}" FontSize="14" 
                                                  Margin="0,0,0,5" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" 
                                                  Foreground="{StaticResource TextBrush}" FontSize="14" 
                                                  Margin="0,0,10,5"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StatusBoletosTextBlock" 
                                                  Foreground="{StaticResource TextBrush}" FontSize="14" 
                                                  Margin="0,0,0,5" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Espaço adicional para balance visual -->
                            <Border CornerRadius="15" Padding="15" Margin="0,0,0,15"
                                    Background="{StaticResource SecondaryBrush}" MinHeight="100">
                                <StackPanel>
                                    <TextBlock Text="Diretório de Boletos" FontSize="18" FontWeight="SemiBold" 
                                              Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="DiretorioBoletosTextBox" 
                                                IsReadOnly="True"
                                                Style="{StaticResource {x:Type TextBox}}" 
                                                Background="{StaticResource PanelBackgroundBrush}"
                                                Foreground="{StaticResource TextBrush}"
                                                Margin="0,0,5,0" Height="35"/>

                                        <Button Grid.Column="1" Content="Abrir Diretório" 
                                               Style="{StaticResource EmphasisButtonStyle}"
                                               FontSize="12" Padding="10,0" Height="35"
                                               Click="AbrirDiretorio_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Botões de Ação -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Botão Cancelar -->
                    <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource CancelButtonStyle}"
                           FontSize="14" Width="120" Height="40" Margin="0,0,15,0" Click="Cancelar_Click"/>

                    <!-- Botão Salvar -->
                    <Button Grid.Column="2" Content="Salvar Alterações" Style="{StaticResource EmphasisButtonStyle}"
                           FontSize="14" Width="160" Height="40" Click="Salvar_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>