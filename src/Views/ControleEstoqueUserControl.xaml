<UserControl x:Class="WMS_RadiadoresLemos_WPF.ControleEstoqueUserControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            mc:Ignorable="d" 
            d:DesignHeight="630" d:DesignWidth="820"
            Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15, 15, 15, 0">
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,20" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="{StaticResource SecondaryBrush}" CornerRadius="18" Height="36" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                  Fill="{StaticResource TextBrush}" Width="23" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Fill" Margin="10,0,10,0"/>
                            <TextBox Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="5,0" Margin="0,0,10,0"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="2" x:Name="FiltrarButton" Content="Filtrar por" ToolTip="Filtrar" Style="{StaticResource FilterButtonStyle}" Click="FiltrarButton_Click"/>
                </Grid>

                <Border Grid.Row="1" CornerRadius="15" Background="{StaticResource SecondaryBrush}" Padding="5" Margin="0,0,0,10">
                    <DataGrid Name="EstoqueDataGrid" Style="{StaticResource CustomDataGridStyle}"
                             MouseDoubleClick="EstoqueDataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Preço" Binding="{Binding Preco, StringFormat={}{0:C2}}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade, StringFormat={}{0:N0}}" IsReadOnly="False" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Row="2">
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Button Content="Cadastrar Produto" Click="CadastrarProduto_Click" Width="160" Height="40" Margin="10, 10, 10, 0" Style="{StaticResource EmphasisButtonStyle}"/>
                        <Button Content="Editar Produto" Click="EditarProduto_Click" Width="160" Height="40" Margin="10, 10, 10, 0" Style="{StaticResource EmphasisButtonStyle}"/>
                        <Button Content="Alterar Quantidade" Click="AlterarQuantidade_Click" Width="170" Height="40" Margin="10, 10, 10, 0" Style="{StaticResource EmphasisButtonStyle}"/>
                        <Button Content="Deletar Produto" Click="DeletarProduto_Click" Width="160" Height="40" Margin="10, 10, 10, 0" Style="{StaticResource CancelButtonStyle}"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="FiltroPopup" Placement="Bottom" StaysOpen="False" PlacementTarget="{Binding ElementName=FiltrarButton}">
            <Border Background="{StaticResource PanelBackgroundBrush}" Padding="15">
                <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15">
                    <StackPanel Background="Transparent" Margin="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10, 10, 0, 5">
                            <CheckBox x:Name="EmEstoqueCheckBox" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Ver apenas itens em estoque" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="16"/>
                        </StackPanel>
                        <TextBlock Text="Filtrar por Produto" FontWeight="Bold" Margin="10, 10, 0, 5" Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="ProdutoComboBox" HorizontalAlignment="Stretch" Margin="15, 0" Style="{StaticResource ComboBoxSearchStyle}" Background="{StaticResource PanelBackgroundBrush}"/>
                        <TextBlock Text="Filtrar por Tipo" FontWeight="Bold" Margin="10, 10, 0, 5" Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="TipoComboBox" HorizontalAlignment="Stretch" Margin="15, 0" Style="{StaticResource ComboBoxSelectStyle}" Background="{StaticResource PanelBackgroundBrush}"/>
                        <TextBlock Text="Filtrar por Marca" FontWeight="Bold" Margin="10, 10, 0, 5" Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="MarcaComboBox" HorizontalAlignment="Stretch" Margin="15, 0" Style="{StaticResource ComboBoxSearchStyle}" Background="{StaticResource PanelBackgroundBrush}"/>
                        <TextBlock Text="Filtrar por Código" FontWeight="Bold" Margin="10, 10, 0, 5" Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="CodigoComboBox" HorizontalAlignment="Stretch" Margin="15, 0" Style="{StaticResource ComboBoxSearchStyle}" Background="{StaticResource PanelBackgroundBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="15, 10">
                            <Button Content="Aplicar Filtro" Click="AplicarFiltroButton_Click" Width="150" FontSize="14" Style="{StaticResource EmphasisButtonStyle}" Margin="0, 5, 0, 0"/>
                            <Button Content="Limpar" Click="LimparFiltroButton_Click" Width="Auto" FontSize="14" Style="{StaticResource EmphasisButtonStyle}" Background="{StaticResource HoverBackgroundBrush}" Margin="15, 5, 0, 0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
    </Grid>
</UserControl>
