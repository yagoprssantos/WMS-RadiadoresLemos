<UserControl x:Class="WMS_RadiadoresLemos_WPF.src.Views.CadastroUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="630" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15,15,15,0">
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho com busca e filtro -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Campo de busca -->
                    <Border Grid.Column="0" Background="{StaticResource SecondaryBrush}" CornerRadius="15" Height="36" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                  Fill="{StaticResource TextBrush}" Width="23" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Fill" Margin="10,0,10,0"/>
                            <TextBox Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="5,0" Margin="0,0,10,0" TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Botão de filtro -->
                    <Button Grid.Column="1" x:Name="FiltrarButton" Content="Filtrar por" ToolTip="Filtrar" Style="{StaticResource FilterButtonStyle}" Click="FiltrarButton_Click"/>

                    <!-- ComboBox para seleção de tabela -->
                    <ComboBox Grid.Column="2" x:Name="TabelasComboBox" Text="Selecionar tabela" ToolTip="Categorias" Style="{StaticResource ComboBoxSelectStyle}" Margin="5,0,0,0" SelectionChanged="TabelasComboBox_SelectionChanged"/>
                </Grid>

                <!-- Título da tabela atual -->
                <TextBlock Grid.Row="1" x:Name="Titulo" Text="Selecione uma tabela" FontSize="18" FontWeight="Bold" 
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Separator Grid.Row="1" Margin="15,25,15,10"/>

                <!-- Exibição de dados -->
                <Border Grid.Row="2" CornerRadius="15" Background="{StaticResource SecondaryBrush}" Padding="5" Margin="0,0,0,10">
                    <DataGrid x:Name="CadastroDataGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                              Style="{StaticResource CustomDataGridStyle}"
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </Border>

                <!-- Botões de ação -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                    <Button Content="Cadastrar" Width="150" Style="{StaticResource EmphasisButtonStyle}" Margin="0,0,0,0" Click="CadastrarButton_Click"/>
                    <Button Content="Editar" Width="150" Style="{StaticResource EmphasisButtonStyle}" Margin="15,0,0,0" Click="EditarButton_Click"/>
                    <Button Content="Deletar" Width="150" Style="{StaticResource CancelButtonStyle}" Margin="15,0,0,0" Click="DeletarButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filtros -->
        <!-- Produtos -->
        <Popup x:Name="ProdutosPopup" Placement="Bottom" StaysOpen="False" PlacementTarget="{Binding ElementName=FiltrarButton}">
            <Border Background="{StaticResource PanelBackgroundBrush}" Padding="15">
                <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15">
                    <StackPanel Background="Transparent" Margin="5">
                        <!-- Filtro por status de estoque -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,5,0,5">
                            <CheckBox x:Name="EmEstoqueCheckBox" Foreground="{StaticResource TextBrush}" 
                              VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Ver apenas itens em estoque" VerticalAlignment="Center" 
                               Foreground="{StaticResource TextBrush}" FontSize="16"/>
                        </StackPanel>

                        <!-- Filtro por Produto -->
                        <TextBlock Text="Filtrar por Produto" FontWeight="Bold" Margin="10,10,0,5" 
                           Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="ProdutoComboBox" HorizontalAlignment="Stretch" Margin="10,0" 
                          Style="{StaticResource ComboBoxSearchStyle}"
                          Background="{StaticResource PanelBackgroundBrush}"/>

                        <!-- Filtro por Tipo -->
                        <TextBlock Text="Filtrar por Tipo" FontWeight="Bold" Margin="10,10,0,5" 
                           Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="TipoComboBox" HorizontalAlignment="Stretch" Margin="10,0" 
                          Style="{StaticResource ComboBoxSelectStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"/>

                        <!-- Filtro por Marca -->
                        <TextBlock Text="Filtrar por Marca" FontWeight="Bold" Margin="10,10,0,5" 
                           Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="MarcaComboBox" HorizontalAlignment="Stretch" Margin="10,0" 
                          Style="{StaticResource ComboBoxSearchStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"/>

                        <!-- Filtro por Código -->
                        <TextBlock Text="Filtrar por Código" FontWeight="Bold" Margin="10,10,0,5" 
                           Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="CodigoComboBox" HorizontalAlignment="Stretch" Margin="10,0" 
                          Style="{StaticResource ComboBoxSearchStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"/>

                        <!-- Botões de Ação -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,5">
                            <Button Content="Aplicar Filtro" Click="AplicarFiltroButton_Click" 
                            Style="{StaticResource EmphasisButtonStyle}" 
                            Width="140" FontSize="14"/>

                            <Button Content="Limpar" Click="LimparFiltroButton_Click" 
                            Style="{StaticResource EmphasisButtonStyle}" 
                            Background="{StaticResource HoverBackgroundBrush}"
                            Width="100" FontSize="14"
                            Margin="15,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>

        <!-- Clientes -->
        <Popup x:Name="ClientesPopup" Placement="Bottom" StaysOpen="False" PlacementTarget="{Binding ElementName=FiltrarButton}">
            <Border Background="{StaticResource PanelBackgroundBrush}" Padding="15">
                <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15">
                    <StackPanel Background="Transparent" Margin="5">
                        <!-- Filtro por Cliente -->
                        <TextBlock Text="Filtrar por Cliente" FontWeight="Bold" Margin="10,10,0,5" 
                           Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="ClienteComboBox" HorizontalAlignment="Stretch" Margin="10,0" 
                          Style="{StaticResource ComboBoxSearchStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"/>

                        <!-- Filtro por Estado -->
                        <TextBlock Text="Filtrar por Estado" FontWeight="Bold" Margin="10,10,0,5" 
                           Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="EstadoComboBox" HorizontalAlignment="Stretch" Margin="10,0" 
                          Style="{StaticResource ComboBoxSearchStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"/>

                        <!-- Filtro por Venda (NF) -->
                        <TextBlock Text="Filtrar por Venda (NF)" FontWeight="Bold" Margin="10,10,0,5" 
                           Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="VendaComboBox" HorizontalAlignment="Stretch" Margin="10,0" 
                          Style="{StaticResource ComboBoxSearchStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"/>

                        <!-- Botões de Ação -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,5">
                            <Button Content="Aplicar Filtro" Click="AplicarFiltroButton_Click" 
                            Style="{StaticResource EmphasisButtonStyle}" 
                            Width="140" FontSize="14"/>

                            <Button Content="Limpar" Click="LimparFiltroButton_Click" 
                            Style="{StaticResource EmphasisButtonStyle}" 
                            Background="{StaticResource HoverBackgroundBrush}"
                            Width="100" FontSize="14"
                            Margin="15,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>

        <!-- Fornecedores -->
        <Popup x:Name="FornecedoresPopup" Placement="Bottom" StaysOpen="False" PlacementTarget="{Binding ElementName=FiltrarButton}">
            <Border Background="{StaticResource PanelBackgroundBrush}" Padding="15">
                <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15">
                    <StackPanel Background="Transparent" Margin="5">
                        <!-- Filtro por Fornecedor -->
                        <TextBlock Text="Filtrar por Fornecedor" FontWeight="Bold" Margin="10,10,0,5" 
                           Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="FornecedorComboBox" HorizontalAlignment="Stretch" Margin="10,0" 
                          Style="{StaticResource ComboBoxSearchStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"/>

                        <!-- Filtro por Estado -->
                        <TextBlock Text="Filtrar por Estado" FontWeight="Bold" Margin="10,10,0,5" 
                           Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="EstadoFornecedorComboBox" HorizontalAlignment="Stretch" Margin="10,0" 
                          Style="{StaticResource ComboBoxSearchStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"/>

                        <!-- Filtro por Compra (NF) -->
                        <TextBlock Text="Filtrar por Compra (NF)" FontWeight="Bold" Margin="10,10,0,5" 
                           Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="CompraComboBox" HorizontalAlignment="Stretch" Margin="10,0" 
                          Style="{StaticResource ComboBoxSearchStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"/>

                        <!-- Botões de Ação -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,5">
                            <Button Content="Aplicar Filtro" Click="AplicarFiltroButton_Click" 
                            Style="{StaticResource EmphasisButtonStyle}" 
                            Width="140" FontSize="14"/>

                            <Button Content="Limpar" Click="LimparFiltroButton_Click" 
                            Style="{StaticResource EmphasisButtonStyle}" 
                            Background="{StaticResource HoverBackgroundBrush}"
                            Width="100" FontSize="14"
                            Margin="15,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>

        <!-- Usuários -->
        <Popup x:Name="UsuariosPopup" Placement="Bottom" StaysOpen="False" PlacementTarget="{Binding ElementName=FiltrarButton}">
            <Border Background="{StaticResource PanelBackgroundBrush}" Padding="15">
                <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15">
                    <StackPanel Background="Transparent" Margin="5">
                        <!-- Filtro por Cargo -->
                        <TextBlock Text="Filtrar por Cargo" FontWeight="Bold" Margin="10,10,0,5" 
                           Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="CargoComboBox" HorizontalAlignment="Stretch" Margin="10,0" 
                          Style="{StaticResource ComboBoxSearchStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"/>

                        <!-- Botões de Ação -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,5">
                            <Button Content="Aplicar Filtro" Click="AplicarFiltroButton_Click" 
                            Style="{StaticResource EmphasisButtonStyle}" 
                            Width="140" FontSize="14"/>

                            <Button Content="Limpar" Click="LimparFiltroButton_Click" 
                            Style="{StaticResource EmphasisButtonStyle}" 
                            Background="{StaticResource HoverBackgroundBrush}"
                            Width="100" FontSize="14"
                            Margin="15,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
    </Grid>
</UserControl>