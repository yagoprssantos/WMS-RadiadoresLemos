<UserControl x:Class="WMS_RadiadoresLemos_WPF.src.Views.RegistroUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.src.Views"
             mc:Ignorable="d" 
             d:DesignHeight="630" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15, 15, 15, 0">
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="10" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,20" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="{StaticResource SecondaryBrush}" CornerRadius="18" Height="36" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                  Fill="{StaticResource TextBrush}" Width="23" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Fill" Margin="10,0,10,0"/>
                            <TextBox Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="5,0" Margin="0,0,10,0"/>
                        </Grid>
                    </Border>
                    <ComboBox Grid.Column="2" x:Name="FiltrosComboBox" ToolTip="Filtrar" Style="{StaticResource ComboBoxStyle}" SelectionChanged="FiltroComboBox_SelectionChanged">
                        <ComboBoxItem Content="Filtrar por" IsSelected="True"/>
                        <ComboBoxItem Content="Produto"/>
                        <ComboBoxItem Content="Data"/>
                        <ComboBoxItem Content="Usuário"/>
                        <ComboBoxItem Content="Preço"/>
                        <ComboBoxItem Content="Mais Recentes"/>
                        <ComboBoxItem Content="Mais Antigos"/>
                    </ComboBox>
                    <ComboBox Grid.Column="3" x:Name="CategoriasComboBox" ToolTip="Categorias" Style="{StaticResource ComboBoxStyle}" Margin="5,0,0,0" SelectionChanged="CategoriasComboBox_SelectionChanged">
                        <ComboBoxItem Content="Entrada/Saída"/>
                        <ComboBoxItem Content="Histórico"/>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- Seção de Entradas e Saídas (Movimentações) -->
                    <Grid x:Name="EntradasSaidasGrid" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Entradas -->
                        <Border Grid.Column="0" Grid.Row="1" CornerRadius="10" Background="{StaticResource SecondaryBrush}" Padding="5" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="ENTRADAS" FontSize="20" FontWeight="Bold" Margin="0,10,0,10" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                <Separator Grid.Row="1" Margin="20, 0, 20, 20"/>
                                <DataGrid Name="EntradaDataGrid" Style="{StaticResource CustomDataGridStyle}" Background="Transparent" Grid.Row="2" Margin="20, 0, 20, 20">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Produto" Binding="{Binding ProdutoId}" Width="Auto" />
                                        <DataGridTextColumn Header="Data" Binding="{Binding DataFormatada}" Width="Auto" />
                                        <DataGridTextColumn Header="Usuário" Binding="{Binding Usuario}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <!-- Saídas -->
                        <Border Grid.Column="1" Grid.Row="1" CornerRadius="10" Background="{StaticResource SecondaryBrush}" Padding="5" Margin="0,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="SAÍDAS" FontSize="20" FontWeight="Bold" Margin="0,10,0,10" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                <Separator Grid.Row="1" Margin="20, 0, 20, 20"/>
                                <DataGrid Name="SaidaDataGrid" Style="{StaticResource CustomDataGridStyle}" Background="Transparent" Grid.Row="2" Margin="20, 0, 20, 20">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Produto" Binding="{Binding ProdutoId}" Width="Auto" />
                                        <DataGridTextColumn Header="Data" Binding="{Binding DataFormatada}" Width="Auto" />
                                        <DataGridTextColumn Header="Usuário" Binding="{Binding Usuario}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Seção de Histórico -->
                    <Grid x:Name="HistoricoGrid" Visibility="Collapsed">
                        <Border Grid.Column="0" Grid.Row="1" CornerRadius="10" Background="{StaticResource SecondaryBrush}" Padding="5" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="HISTÓRICO" FontSize="20" FontWeight="Bold" Margin="0,10,0,10" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                <Separator Grid.Row="1" Margin="20, 0, 20, 20"/>
                                <DataGrid Name="HistoricoDataGrid" Style="{StaticResource CustomDataGridStyle}" Background="Transparent" Grid.Row="2" Margin="20, 0, 20, 20">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Data" Binding="{Binding DataFormatada}" Width="Auto" />
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="Auto" />
                                        <DataGridTextColumn Header="Nivel" Binding="{Binding Nivel}" Width="Auto" />
                                        <DataGridTemplateColumn Header="Detalhes" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Detalhes}" TextWrapping="Wrap" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
