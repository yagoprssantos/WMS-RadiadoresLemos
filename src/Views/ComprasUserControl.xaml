<UserControl x:Class="WMS_RadiadoresLemos_WPF.src.Views.ComprasUserControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.src.Views" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15,15,15,0">
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra de Pesquisa, Filtro e Ordenação -->
                <Grid Margin="0,0,0,20" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Barra de Pesquisa -->
                    <Border Grid.Column="1" Background="{StaticResource SecondaryBrush}" CornerRadius="15" Height="36" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                  Fill="{StaticResource TextBrush}" Width="23" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Fill" Margin="10,0,10,0"/>
                            <TextBox Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="5,0" Margin="0,0,10,0"/>
                        </Grid>
                    </Border>
                    <!-- Botão de Filtro -->
                    <Button Grid.Column="2" x:Name="FiltrarButton" Content="Filtrar por" ToolTip="Filtrar" Style="{StaticResource FilterButtonStyle}" Click="FiltrarButton_Click"/>
                    <!-- Botão de Ordenar -->
                    <Button Grid.Column="3" Content="Registrar Compra" Style="{StaticResource EmphasisButtonStyle}" Click="RegistrarCompraButton_Click"/>
                </Grid>

                <!-- Conteúdo Principal: Itens de Compra -->
                <Border Grid.Row="1" CornerRadius="15" Background="{StaticResource SecondaryBrush}" Padding="5" Margin="0,0,0,0">
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl x:Name="ComprasContainer" Margin="15">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="15" Padding="15" Margin="0" Width="230">
                                        <StackPanel>
                                            <TextBlock Text="{Binding NotaFiscal, StringFormat='NF: {0}', TargetNullValue='Compra'}" Style="{StaticResource VendasTitleTextBox}" FontSize="16" HorizontalAlignment="Center"/>

                                            <Separator Margin="10,5,10,10"/>
                                            
                                            <TextBlock Text="{Binding FornecedorNome, StringFormat='Fornecedor: {0}'}" Style="{StaticResource VendasTextBox}" FontSize="14" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding FornecedorId, StringFormat='ID Fornecedor: {0}'}" Style="{StaticResource VendasTextBox}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Id, StringFormat='ID Compra: {0}'}" Style="{StaticResource VendasTextBox}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DataCompra, StringFormat='Data: {0:dd/MM/yyyy}'}" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                                            <TextBlock Text="{Binding DataPagamento, StringFormat='Pagamento em: {0:dd/MM/yyyy}', TargetNullValue='Pagamento em: -'}" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                                            <TextBlock Text="{Binding TipoPagamento, StringFormat='Pagamento: {0}'}" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                                            <TextBlock Text="{Binding Parcelas, StringFormat='Parcelas: {0}'}" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                                            <TextBlock Text="{Binding Boletos.Count, StringFormat='Qtd. Boletos: {0}', TargetNullValue='Qtd. Boletos: 0'}" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                                            <TextBlock Text="{Binding ValorTotal, StringFormat='Total: R$ {0:N2}'}" Style="{StaticResource VendasTextBox}" FontSize="14" FontWeight="Bold" Margin="5,0,5,10"/>
                                            <TextBlock Text="{Binding DataCadastro, StringFormat='Cadastro: {0:dd/MM/yyyy HH:mm}'}" Style="{StaticResource VendasTextBox}" FontSize="12"/>
                                            <TextBlock Text="{Binding Detalhes, StringFormat='Detalhes: {0}', TargetNullValue='Detalhes: -'}" Style="{StaticResource VendasTextBox}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="Itens:" Style="{StaticResource VendasTextBox}" FontSize="13" FontWeight="Bold" Margin="0,5,0,0"/>
                                            <ItemsControl ItemsSource="{Binding Itens}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical" Margin="0,0,0,2">
                                                            <TextBlock Text="{Binding ProdutoNome, StringFormat='- {0}'}" FontSize="12"/>
                                                            <TextBlock Text="{Binding Quantidade, StringFormat='Qtd: {0}'}" FontSize="11" Margin="10,0,0,0"/>
                                                            <TextBlock Text="{Binding Preco, StringFormat='Preço: R$ {0:N2}'}" FontSize="11" Margin="10,0,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="Detalhes" Style="{StaticResource EmphasisButtonStyle}" FontSize="14" Width="120" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Popup de Filtro -->
        <Popup x:Name="FiltroPopup" Placement="Bottom" StaysOpen="False" PlacementTarget="{Binding ElementName=FiltrarButton}">
            <Border Background="{StaticResource PanelBackgroundBrush}" Padding="15">
                <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15">
                    <StackPanel Background="Transparent" Margin="0">
                        <Button x:Name="OrderButton" Content="Ordenar por" ToolTip="Ordenar" Style="{StaticResource OrderButtonStyle}" Click="OrdenarButton_Click" Margin="0,0,10,0"/>
                        <!-- Adicione aqui os controles de filtro específicos para compras -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="15, 10">
                            <Button Content="Aplicar Filtro" Click="AplicarFiltroButton_Click" Width="150" FontSize="14" Style="{StaticResource EmphasisButtonStyle}" Margin="0, 5, 0, 0"/>
                            <Button Content="Limpar" Click="LimparFiltroButton_Click" Width="Auto" FontSize="14" Style="{StaticResource EmphasisButtonStyle}" Background="{StaticResource HoverBackgroundBrush}" Margin="15, 5, 0, 0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
   
        <!-- Popup de Ordenar -->
        <Popup x:Name="OrdenarPopup" Placement="Bottom" StaysOpen="False" PlacementTarget="{Binding ElementName=OrderButton}">
            <Border Background="{StaticResource PanelBackgroundBrush}" Padding="15">
                <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15">
                    <StackPanel Background="Transparent" Margin="0">
                        <!-- Opções de Ordenação -->
                        <Button Content="Preço" Tag="preco" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                        <Button Content="Produto" Tag="produto" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                        <Button Content="Cliente" Tag="cliente" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                        <Button Content="Recente" Tag="recente" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                        <Button Content="Antigo" Tag="antigo" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
    </Grid>
</UserControl>