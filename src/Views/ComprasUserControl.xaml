<UserControl x:Class="WMS_RadiadoresLemos_WPF.src.Views.ComprasUserControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.src.Views" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15,15,15,0">
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra de Pesquisa, Filtro e Ordenação -->
                <Grid Margin="0,0,0,20" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Barra de Pesquisa -->
                    <Border Grid.Column="1" Background="{StaticResource SecondaryBrush}" CornerRadius="15" Height="36" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                  Fill="{StaticResource TextBrush}" Width="23" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Fill" Margin="10,0,10,0"/>
                            <TextBox Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="5,0" Margin="0,0,10,0"/>
                        </Grid>
                    </Border>
                    <!-- Botão de Filtro -->
                    <Button Grid.Column="2" x:Name="FiltrarButton" Content="Filtrar por" ToolTip="Filtrar" Style="{StaticResource FilterButtonStyle}" Click="FiltrarButton_Click"/>
                    <!-- Botão de Registrar Compra -->
                    <Button Grid.Column="3" Content="Registrar Compra" Style="{StaticResource EmphasisButtonStyle}" Click="RegistrarCompraButton_Click"/>
                </Grid>

                <!-- Conteúdo Principal: Layout com Compras e Calendário lado a lado -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Coluna para lista de compras -->
                        <ColumnDefinition Width="*" MinWidth="250"/>
                        <!-- Coluna para o GridSplitter -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Coluna para o calendário -->
                        <ColumnDefinition Width="380" MinWidth="320" MaxWidth="550"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lista de Compras (lado esquerdo) -->
                    <Border Grid.Column="0" CornerRadius="15" Background="{StaticResource SecondaryBrush}" Padding="5" Margin="0,0,5,0">
                        <ScrollViewer x:Name="CardViewContainer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <ItemsControl x:Name="ComprasContainer" Margin="0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="15" Padding="15" Margin="15" Width="250">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding NotaFiscal, StringFormat='NF: {0}', TargetNullValue='Compra'}" Style="{StaticResource VendasTitleTextBox}" FontSize="16" HorizontalAlignment="Center"/>
                                                    <Separator Margin="10,5,10,10"/>
                                                    <TextBlock Text="{Binding FornecedorNome, StringFormat='Fornecedor: {0}'}" Style="{StaticResource VendasTextBox}" FontSize="14" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding DataCompra, StringFormat='Data de Compra: {0:dd/MM/yyyy}'}" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                                                    <TextBlock Text="{Binding DataPagamento, StringFormat='Pagamento em: {0:dd/MM/yyyy}', TargetNullValue='Pagamento em: -'}" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                                                    <TextBlock Text="{Binding ValorTotal, StringFormat='Total: R$ {0:N2}'}" Style="{StaticResource VendasTextBox}" FontSize="14" FontWeight="Bold"/>
                                                    <Button Content="Detalhes" Style="{StaticResource EmphasisButtonStyle}" FontSize="14" Width="120" Margin="0,10,0,5" Click="DetalhesButton_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Mensagem de vazio -->
                                <TextBlock x:Name="MensagemVazia" Text="Nenhuma compra cadastrada."
                                           FontSize="18" Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- GridSplitter para permitir redimensionamento -->
                    <GridSplitter Grid.Column="1" 
                                  Width="8" 
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch" 
                                  Background="Transparent" 
                                  ShowsPreview="True" 
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Columns">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="{x:Type GridSplitter}">
                                <Border Background="Transparent" 
                                        BorderThickness="0" 
                                        Padding="2,0"
                                        Cursor="SizeWE">
                                    <Rectangle Width="4" 
                                             Fill="Transparent" 
                                             HorizontalAlignment="Center" 
                                             VerticalAlignment="Stretch"
                                             RadiusX="2" 
                                             RadiusY="2"/>
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- Calendário (lado direito) -->
                    <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="15" Padding="15" Margin="5,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Título -->
                                <RowDefinition Height="Auto"/>
                                <!-- Navegação do mês -->
                                <RowDefinition Height="Auto"/>
                                <!-- Calendário -->
                                <RowDefinition Height="Auto"/>
                                <!-- Legenda -->
                                <RowDefinition Height="*"/>
                                <!-- Detalhes do dia selecionado -->
                            </Grid.RowDefinitions>

                            <!-- Título -->
                            <TextBlock Grid.Row="0" Text="Calendário de Compras" Style="{StaticResource VendasTitleTextBox}" FontSize="20" 
                                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

                            <!-- Navegação do mês -->
                            <Grid Grid.Row="1" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" x:Name="PrevMonthButton" Style="{StaticResource NavigationButtonStyle}" Width="36" Height="36" Click="PrevMonthButton_Click">
                                    <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" 
                                          Fill="{StaticResource TextBrush}" Width="20" Height="20"/>
                                </Button>

                                <TextBlock Grid.Column="1" x:Name="CalendarMonthText" Text="Abril 2024" 
                                           FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>

                                <Button Grid.Column="2" x:Name="NextMonthButton" Style="{StaticResource NavigationButtonStyle}" Width="36" Height="36" Click="NextMonthButton_Click">
                                    <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" 
                                          Fill="{StaticResource TextBrush}" Width="20" Height="20"/>
                                </Button>
                            </Grid>

                            <!-- Calendário - Com células maiores e indicadores reposicionados -->
                            <Border Grid.Row="2" Background="{StaticResource SecondaryBrush}" CornerRadius="15" Padding="12,18">
                                <Viewbox Stretch="Uniform" Margin="0">
                                    <Grid Width="350" Height="330">
                                        <!-- Cabeçalho dos dias -->
                                        <UniformGrid Rows="1" Columns="7" Margin="0,0,0,15">
                                            <TextBlock Text="Dom" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="Seg" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="Ter" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="Qua" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="Qui" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="Sex" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="Sab" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14"/>
                                        </UniformGrid>

                                        <!-- Grid do calendário -->
                                        <ItemsControl x:Name="CalendarDaysControl" Margin="0,35,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="6" Columns="7"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="3" Click="CalendarDayButton_Click" Tag="{Binding Date}" 
                                                    Background="Transparent" BorderThickness="0" Height="42" Width="42">
                                                        <Grid>
                                                            <!-- Indicador de dia atual (círculo de fundo) -->
                                                            <Ellipse Width="32" Height="32" Fill="{StaticResource PanelBackgroundBrush}"
                                                                     Visibility="{Binding TodayIndicatorVisibility}"/>

                                                            <!-- Indicador de seleção (borda) -->
                                                            <Border Width="32" Height="32" CornerRadius="10" 
                                                                    BorderBrush="{StaticResource AccentBrush}" 
                                                                    BorderThickness="{Binding SelectedBorderThickness}"/>

                                                            <!-- Número do dia -->
                                                            <TextBlock Text="{Binding Day}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                       Foreground="{StaticResource TextBrush}" FontWeight="{Binding FontWeight}" FontSize="16"/>

                                                            <!-- Indicador de pagamento (ponto na parte inferior) -->
                                                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" 
                                                                     Visibility="{Binding PaymentVisibility}" 
                                                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Viewbox>
                            </Border>

                            <!-- Legenda - Atualizada com todas as indicações -->
                            <Grid Grid.Row="3" Margin="0,15,0,15" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Legenda para Dia Atual -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,15,0">
                                    <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="2"
                                            Width="16" Height="16" CornerRadius="8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Dia Atual" Margin="8,0,0,0" VerticalAlignment="Center" 
                                             Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                </StackPanel>

                                <!-- Legenda para Pagamentos -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,15,0">
                                    <Border Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="2"
                                            Width="16" Height="16" CornerRadius="8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Pagamentos" Margin="8,0,0,0" VerticalAlignment="Center" 
                                             Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                </StackPanel>
                            </Grid>

                            <!-- Detalhes do dia selecionado -->
                            <Border Grid.Row="4" Background="{StaticResource SecondaryBrush}" CornerRadius="15" 
                                   Margin="0,5,0,0" Padding="15,12" MinHeight="120" Visibility="{Binding ElementName=DiaDetalhesPanel, Path=Visibility}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="DiaDetalhesPanel" Visibility="Collapsed">
                                        <TextBlock x:Name="DataSelecionadaText" Text="12 de Abril de 2024" FontWeight="Bold" FontSize="16" 
                                                  Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                        <Separator Margin="0,0,0,12"/>

                                        <!-- Lista de compras do dia -->
                                        <ItemsControl x:Name="ComprasDoDiaList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource PanelBackgroundBrush}" 
                                                           CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding NotaFiscal, StringFormat='NF: {0}', TargetNullValue='Compra'}" 
                                                                          Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14"/>
                                                                <TextBlock Text="{Binding FornecedorNome}" 
                                                                          Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                                                <TextBlock Text="{Binding ValorTotal, StringFormat='R$ {0:N2}'}" 
                                                                          Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Detalhes" Click="DetalhesCompraCalendarioButton_Click" 
                                                                   Style="{StaticResource EmphasisButtonStyle}" 
                                                                   Width="80" Height="Auto" VerticalAlignment="Center" FontSize="13"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Mensagem quando não há compras no dia selecionado -->
                                        <TextBlock x:Name="SemComprasNoDiaText" Text="Não há compras ou pagamentos nesta data." 
                                                  Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" FontSize="14"
                                                  Visibility="Collapsed" TextWrapping="Wrap" Margin="0,15"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Popup de Filtro -->
        <Popup x:Name="FiltroPopup" Placement="Bottom" StaysOpen="False" PlacementTarget="{Binding ElementName=FiltrarButton}">
            <Border Background="{StaticResource PanelBackgroundBrush}" Padding="15">
                <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15">
                    <StackPanel Background="Transparent" Margin="0">
                        <Button x:Name="OrderButton" Content="Ordenar por" ToolTip="Ordenar" Style="{StaticResource OrderButtonStyle}" Click="OrdenarButton_Click" Margin="0,0,10,0"/>
                        <!-- Adicione aqui os controles de filtro específicos para compras -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="15, 10">
                            <Button Content="Aplicar Filtro" Click="AplicarFiltroButton_Click" Width="150" FontSize="14" Style="{StaticResource EmphasisButtonStyle}" Margin="0, 5, 0, 0"/>
                            <Button Content="Limpar" Click="LimparFiltroButton_Click" Width="Auto" FontSize="14" Style="{StaticResource EmphasisButtonStyle}" Background="{StaticResource HoverBackgroundBrush}" Margin="15, 5, 0, 0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>

        <!-- Popup de Ordenar -->
        <Popup x:Name="OrdenarPopup" Placement="Bottom" StaysOpen="False" PlacementTarget="{Binding ElementName=OrderButton}">
            <Border Background="{StaticResource PanelBackgroundBrush}" Padding="15">
                <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15">
                    <StackPanel Background="Transparent" Margin="0">
                        <!-- Opções de Ordenação -->
                        <Button Content="Preço" Tag="preco" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                        <Button Content="Produto" Tag="produto" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                        <Button Content="Cliente" Tag="cliente" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                        <Button Content="Recente" Tag="recente" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                        <Button Content="Antigo" Tag="antigo" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
    </Grid>
</UserControl>