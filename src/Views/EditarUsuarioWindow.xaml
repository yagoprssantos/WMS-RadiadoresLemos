<Window x:Class="WMS_RadiadoresLemos_WPF.EditarUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Usuário" Height="380" Width="400">

    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Nome:" Foreground="White" />
            <TextBox FontSize="16" Height="40" x:Name="NomeTextBox" />

            <TextBlock Text="Email:" Margin="0,10,0,0" Foreground="White" />
            <TextBox FontSize="16" Height="40" x:Name="EmailTextBox" />

            <TextBlock Text="Senha:" Margin="0,10,0,0" Foreground="White" />
            <PasswordBox FontSize="16" Height="40" x:Name="SenhaPasswordBox" />

            <TextBlock Text="Permissão:" Margin="0,10,0,0" Foreground="White" />
            <ComboBox FontSize="16" Height="40" x:Name="PermissaoComboBox">
                <ComboBoxItem Content="Admin" />
                <ComboBoxItem Content="Usuário" />
                <ComboBoxItem Content="Convidado" />
            </ComboBox>

            <Button Content="Registrar" Margin="0,20,0,0" Click="RegistrarUsuario_Click"/>
        </StackPanel>
    </Grid>
</Window>
