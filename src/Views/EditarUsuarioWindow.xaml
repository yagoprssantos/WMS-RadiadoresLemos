<Window x:Class="WMS_RadiadoresLemos_WPF.EditarUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF"
        mc:Ignorable="d"
        Title="Editar Usuário" Height="600" Width="600" FontSize="18"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PanelBackgroundBrush}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{StaticResource PanelBackgroundBrush}">
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
                <!-- Dados do Usuário -->
                <!-- Nome -->
                <TextBlock Text="Nome:" Margin="0,0,0,5"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBox FontSize="16" Height="35" x:Name="NomeTextBox" TextChanged="TextBox_TextChanged" PreviewTextInput="NomeTextBox_PreviewTextInput"
                         Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,15"/>

                <!-- Email -->
                <TextBlock Text="Email:" Margin="0,0,0,5"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBox FontSize="16" Height="35" x:Name="EmailTextBox" TextChanged="TextBox_TextChanged"
                         Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,15"/>

                <!-- Matrícula -->
                <TextBlock Text="Matrícula:" Margin="0,0,0,5"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBox FontSize="16" Height="35" x:Name="MatriculaTextBox" IsReadOnly="True"
                         Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,15"/>

                <!-- Senha -->
                <TextBlock Text="Senha:" Margin="0,0,0,5"
                           Foreground="{StaticResource TextBrush}"/>
                <PasswordBox FontSize="16" Height="35" x:Name="SenhaPasswordBox" PasswordChanged="SenhaPasswordBox_PasswordChanged"
                             Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,15"/>

                <!-- Cargo -->
                <TextBlock Text="Cargo:" Margin="0,0,0,5"
                           Foreground="{StaticResource TextBrush}"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox FontSize="16" Height="35" x:Name="PermissaoComboBox" Grid.Column="0" SelectionChanged="PermissaoComboBox_SelectionChanged"
                              Style="{StaticResource ComboBoxStyle}" Width="450">
                        <ComboBoxItem Content="Administrador" />
                        <ComboBoxItem Content="Gerente" />
                        <ComboBoxItem Content="Operador" />
                        <ComboBoxItem Content="Estagiário" />
                        <ComboBoxItem Content="Usuário" />
                    </ComboBox>
                    <Button Content="?" Width="30" Height="30" Margin="10,0,0,0" Foreground="{StaticResource TextBrush}" FontSize="16" Grid.Column="1" Click="MaisSobreCargo_Click"/>
                    <Popup x:Name="CargoPopup" Placement="Mouse" StaysOpen="False">
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Administrador - Acesso total ao sistema, ideal para desenvolvedores" TextWrapping="Wrap" Width="250" Foreground="{StaticResource TextBrush}" FontSize="16" Margin="0,5,0,5"/>
                                <TextBlock Text="Gerente - Acesso total ao sistema, para funções operacionais e administrativas" TextWrapping="Wrap" Width="250" Foreground="{StaticResource TextBrush}" FontSize="16" Margin="0,5,0,5"/>
                                <TextBlock Text="Operador - Acesso limitado, para funções operacionais básicas" TextWrapping="Wrap" Width="250" Foreground="{StaticResource TextBrush}" FontSize="16" Margin="0,5,0,5"/>
                                <TextBlock Text="Estagiário - Acesso restrito, voltado para aprendizado e treinamento" TextWrapping="Wrap" Width="250" Foreground="{StaticResource TextBrush}" FontSize="16" Margin="0,5,0,5"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Botões -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20,10,0,0">
                    <!-- Botão Salvar -->
                    <Button Content="Salvar" Width="250" Margin="10" Click="Salvar_Click" Style="{StaticResource EmphasisButtonStyle}"/>
                    <!-- Botão Cancelar -->
                    <Button Content="Cancelar" Width="150" Margin="10" Click="Cancelar_Click"
                            Style="{StaticResource CancelButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>