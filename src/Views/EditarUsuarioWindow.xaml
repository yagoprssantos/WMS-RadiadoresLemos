<Window x:Class="WMS_RadiadoresLemos_WPF.EditarUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Usuário" Height="460" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Nome:" Foreground="White" FontSize="16"/>
            <TextBox FontSize="16" Height="35" x:Name="NomeTextBox" TextChanged="TextBox_TextChanged" PreviewTextInput="NomeTextBox_PreviewTextInput" />

            <TextBlock Text="Email:" Margin="0,10,0,0" Foreground="White" FontSize="16"/>
            <TextBox FontSize="16" Height="35" x:Name="EmailTextBox" TextChanged="TextBox_TextChanged" />

            <TextBlock Text="Matrícula:" Margin="0,10,0,0" Foreground="White" FontSize="16"/>
            <TextBox FontSize="16" Height="35" x:Name="MatriculaTextBox" IsReadOnly="True" />

            <TextBlock Text="Senha:" Margin="0,10,0,0" Foreground="White" FontSize="16"/>
            <PasswordBox FontSize="16" Height="35" x:Name="SenhaPasswordBox" PasswordChanged="SenhaPasswordBox_PasswordChanged" />

            <TextBlock Text="Cargo:" Margin="0,10,0,0" Foreground="White" FontSize="16"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox FontSize="16" Height="35" x:Name="PermissaoComboBox" Grid.Column="0" SelectionChanged="PermissaoComboBox_SelectionChanged">
                    <ComboBoxItem Content="Administrador" />
                    <ComboBoxItem Content="Gerente" />
                    <ComboBoxItem Content="Operador" />
                    <ComboBoxItem Content="Estagiário" />
                    <ComboBoxItem Content="Usuário" />
                </ComboBox>
                <Button Content="?" Width="30" Height="30" Margin="10,0,0,0" FontSize="16" Grid.Column="1" Click="MaisSobreCargo_Click"/>
                <Popup x:Name="CargoPopup" Placement="Mouse" StaysOpen="False">
                    <Border Background="White" BorderBrush="Black" BorderThickness="1" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Administrador - Acesso total ao sistema, ideal para desenvolvedores" TextWrapping="Wrap" Width="200"/>
                            <TextBlock Text="Gerente - Acesso total ao sistema, para funções operacionais e administrativas" TextWrapping="Wrap" Width="200" Margin="0,5,0,0"/>
                            <TextBlock Text="Operador - Acesso limitado, para funções operacionais básicas" TextWrapping="Wrap" Width="200" Margin="0,5,0,0"/>
                            <TextBlock Text="Estagiário - Acesso restrito, voltado para aprendizado e treinamento" TextWrapping="Wrap" Width="200" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Salvar" Width="100" Margin="10,0" Click="Salvar_Click" FontSize="16"/>
                <Button Content="Cancelar" Width="100" Margin="10,0" Click="Cancelar_Click" FontSize="16"
                        Style="{StaticResource CancelButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
