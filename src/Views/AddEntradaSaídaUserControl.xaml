<UserControl x:Class="WMS_RadiadoresLemos_WPF.AddEntradaSaidaUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="15, 15, 15, 0">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="10" Padding="25,10" Margin="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{StaticResource PanelBackgroundBrush}">
                <Grid>
                    
                    <!-- Botão de Carrinho de Compras no canto inferior direito -->
                    <Button Style="{StaticResource HoverButtonStyle}"
                            FontSize="16" Width="50" Height="50" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" x:Name="CarrinhoDeComprasButton" Click="CarrinhoDeComprasButton_Click">
                    </Button>
                    
                    <!-- Popup de Carrinho de Compras -->
                    <Popup x:Name="CarrinhoDeComprasPopup" StaysOpen="False" Placement="Center" AllowsTransparency="True">
                        <Border Background="{StaticResource SecondaryBrush}" CornerRadius="15" Padding="10" BorderBrush="{StaticResource HoverBackgroundBrush}" BorderThickness="10">
                            <StackPanel>
                                <TextBlock Text="Carrinho de Compras" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                <!-- Conteúdo do carrinho de compras -->
                                <StackPanel>
                                    <!-- Item 1 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Produto: Radiador" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="Tipo: Entrada" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="Preço: R$ 150,00" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="Quantidade: 10" FontSize="14" Margin="0,0,10,0"/>
                                    </StackPanel>
                                    <!-- Item 2 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Produto: Bomba de Água" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="Tipo: Saída" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="Preço: R$ 75,00" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="Quantidade: 5" FontSize="14" Margin="0,0,10,0"/>
                                    </StackPanel>
                                    <!-- Item 3 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Produto: Termostato" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="Tipo: Entrada" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="Preço: R$ 30,00" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="Quantidade: 20" FontSize="14" Margin="0,0,10,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="Finalizar" Style="{StaticResource EmphasisButtonStyle}" FontSize="14" HorizontalAlignment="Right" Click="FecharCarrinhoDeCompras_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>




                    <StackPanel Width="Auto" VerticalAlignment="Top" Margin="0, 15, 0, 0">
                        <TextBlock Text="Produto:" Margin="0,0,0,5" FontSize="18" Foreground="{StaticResource TextBrush}"/>
                        <ComboBox Name="ProdutoComboBox" Margin="0,0,0,15" FontSize="16" Style="{StaticResource ComboBoxStyle}" HorizontalAlignment="Stretch" LostFocus="ProdutoComboBox_LostFocus"
                                      StaysOpenOnEdit="True" IsTextSearchEnabled="True" TextBoxBase.TextChanged="SearchTextBox_TextChanged" SelectionChanged="ProdutoComboBox_SelectionChanged"/>

                        <!-- Grid para Quantidade e Preço por unidade -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Quantidade:" Margin="0,0,0,5" FontSize="18" Foreground="{StaticResource TextBrush}"/>
                                <TextBox Name="QuantidadeTextBox" Margin="0,0,0,15" FontSize="18" Style="{StaticResource {x:Type TextBox}}"
                                             PreviewTextInput="QuantidadeTextBox_PreviewTextInput" DataObject.Pasting="QuantidadeTextBox_Pasting" LostFocus="QuantidadeTextBox_LostFocus"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Preço por unidade:" Margin="0,0,0,5" FontSize="18" Foreground="{StaticResource TextBrush}"/>
                                <TextBox Name="PrecoTextBox" Margin="0,0,0,15" FontSize="18" Style="{StaticResource {x:Type TextBox}}"
                                             PreviewTextInput="PrecoTextBox_PreviewTextInput" DataObject.Pasting="PrecoTextBox_Pasting" LostFocus="PrecoTextBox_LostFocus"/>
                            </StackPanel>
                        </Grid>

                        <!-- Detalhes do Produto -->
                        <StackPanel>
                            <Border CornerRadius="10" Background="{StaticResource PanelBackgroundBrush}" Padding="10">
                                <StackPanel>
                                    <!-- Detalhes do produto Selecionado -->
                                    <StackPanel x:Name="ProdutoSelecionado" Margin="0, 0, 0, 0" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="Transparent" Visibility="Visible">
                                        <Border CornerRadius="10" Background="{StaticResource PanelBackgroundBrush}">
                                            <Grid Width="Auto" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Produto Selecionado -->
                                                <StackPanel Grid.Column="0" Width="Auto" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                    <TextBlock Text="Produto Selecionado" FontWeight="Bold" Margin="5" HorizontalAlignment="Center" FontSize="16" Foreground="{StaticResource TextBrush}" x:Name="ProdutoSelecionadoTextBlock"/>
                                                    <Grid Margin="5" x:Name="ProdutoSelecionadoGrid">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*" MinWidth="200"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProdutoSelecionado.Nome}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="NomeSelecionadoDadoTextBlock"/>

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tipo:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProdutoSelecionado.Tipo}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="TipoSelecionadoDadoTextBlock"/>

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Marca:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProdutoSelecionado.Marca}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="MarcaSelecionadoDadoTextBlock"/>

                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Código:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProdutoSelecionado.Codigo}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="CodigoSelecionadoDadoTextBlock"/>

                                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Preço:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProdutoSelecionado.Preco, StringFormat={}{0:C}}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="PrecoSelecionadoDadoTextBlock"/>

                                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Quantidade:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProdutoSelecionado.Quantidade}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="QuantidadeSelecionadoDadoTextBlock"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Detalhes do produto Antes e Depois de adicionar entrada/saída -->
                                    <Grid x:Name="ProdutoAntesDepois" Width="Auto" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Antes -->
                                        <StackPanel Grid.Column="0" Width="Auto" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center">
                                            <TextBlock Text="Antes" FontWeight="Bold" Margin="5" HorizontalAlignment="Center" FontSize="16" Foreground="{StaticResource TextBrush}" x:Name="AntesTextBlock"/>
                                            <Grid Margin="5" x:Name="AntesGrid">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*" MinWidth="200"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tipo:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProdutoAntes.Tipo}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="TipoAntesDadoTextBlock"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Marca:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProdutoAntes.Marca}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="MarcaAntesDadoTextBlock"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Código:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProdutoAntes.Codigo}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="CodigoAntesDadoTextBlock"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Preço:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProdutoAntes.Preco, StringFormat={}{0:C}}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="PrecoAntesDadoTextBlock"/>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Quantidade:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProdutoAntes.Quantidade}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="QuantidadeAntesDadoTextBlock"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Depois -->
                                        <StackPanel Grid.Column="1" Width="Auto" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center">
                                            <TextBlock Text="Depois" FontWeight="Bold" Margin="5" HorizontalAlignment="Center" FontSize="16" Foreground="{StaticResource TextBrush}" x:Name="DepoisTextBlock"/>
                                            <Grid Margin="5" x:Name="DepoisGrid">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*" MinWidth="200"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tipo:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}" x:Name="TipoDepoisTextoTextBlock"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProdutoDepois.Tipo}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="TipoDepoisDadoTextBlock"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Marca:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}" x:Name="MarcaDepoisTextoTextBlock"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProdutoDepois.Marca}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="MarcaDepoisDadoTextBlock"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Código:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}" x:Name="CodigoDepoisTextoTextBlock"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProdutoDepois.Codigo}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="CodigoDepoisDadoTextBlock"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Preço:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}" x:Name="PrecoDepoisTextoTextBlock"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProdutoDepois.Preco, StringFormat={}{0:C}}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="PrecoDepoisDadoTextBlock"/>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Quantidade:" FontWeight="Bold" Margin="5" FontSize="16" Foreground="{StaticResource TextBrush}" x:Name="QuantidadeDepoisTextoTextBlock"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProdutoDepois.Quantidade}" Margin="5" Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource TextBrush}" Padding="2" FontSize="16" x:Name="QuantidadeDepoisDadoTextBlock"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Botões de Ação -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 0, 0, 10">
                            <!-- Antes de selecionar tipo de registro -->
                            <Button Content="Registrar Entrada" Click="RegistrarEntrada_Click" FontSize="16"
                                    Visibility="Visible" Width="200" Margin="10, 15, 10, 5" Style="{StaticResource EmphasisButtonStyle}" x:Name="RegistrarEntradaButton"/>
                            <Button Content="Registrar Saída" Click="RegistrarSaida_Click" FontSize="16"
                                    Visibility="Visible" Width="200" Margin="10, 15, 10, 5" Style="{StaticResource CancelButtonStyle}" x:Name="RegistrarSaidaButton"/>

                            <!-- Após selecionar tipo de registro -->
                            <Button Content="Confirmar registro" HorizontalContentAlignment="Center"
                                    FontSize="16" Width="200" Margin="10, 15, 10, 5" Style="{StaticResource EmphasisButtonStyle}"
                                    Visibility="Collapsed" Click="ConfirmarAcao_Click" x:Name="ConfirmarRegistroButton"/>
                            <Button Content="Cancelar registro" HorizontalContentAlignment="Center"
                                    FontSize="16" Width="200" Margin="10, 15, 10, 5" Style="{StaticResource CancelButtonStyle}"
                                    Visibility="Collapsed" Click="CancelarAcao_Click" x:Name="CancelarRegistroButton"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

