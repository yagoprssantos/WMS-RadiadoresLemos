<UserControl x:Class="WMS_RadiadoresLemos_WPF.AddEntradaSaídaUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15">
        <!-- Border Principal -->
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <!-- Layout Principal -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Primeira Border (Conteúdo Principal) -->
                <Border Grid.Column="0" CornerRadius="15" Padding="25" Margin="0,0,10,0" 
                        Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1">
                    <StackPanel>
                        <!-- Produto -->
                        <TextBlock Text="Produto:" Margin="0,0,0,5" FontSize="18" Foreground="{StaticResource TextBrush}" />
                        <ComboBox Name="ProdutoComboBox" Margin="0,0,0,15" FontSize="16" HorizontalAlignment="Stretch"
                                  Style="{StaticResource ComboBoxStyle}" Background="{StaticResource PanelBackgroundBrush}"/>

                        <!-- Quantidade e Preço -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Quantidade:" Margin="0,0,0,5" FontSize="18" Foreground="{StaticResource TextBrush}" />
                                <TextBox Name="QuantidadeTextBox" FontSize="16" Style="{StaticResource {x:Type TextBox}}" 
                                         Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Preço:" Margin="0,0,0,5" FontSize="18" Foreground="{StaticResource TextBrush}" />
                                <TextBox Name="PrecoTextBox" FontSize="16" Style="{StaticResource {x:Type TextBox}}" 
                                         Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Antes e Depois -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Antes -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Antes:" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tipo:" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                    <TextBlock x:Name="TipoAntesDadoTextBlock" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                    <TextBlock Text="Marca:" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                    <TextBlock x:Name="MarcaAntesDadoTextBlock" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                    <TextBlock Text="Código:" Grid.Row="2" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                    <TextBlock x:Name="CodigoAntesDadoTextBlock" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                    <TextBlock Text="Preço:" Grid.Row="3" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                    <TextBlock x:Name="PrecoAntesDadoTextBlock" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                    <TextBlock Text="Quantidade:" Grid.Row="4" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                    <TextBlock x:Name="QuantidadeAntesDadoTextBlock" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                </Grid>
                            </StackPanel>

                            <!-- Separador -->
                            <Border Grid.Column="1" Width="1" Background="{StaticResource HoverBackgroundBrush}" Margin="5,0" />

                            <!-- Depois -->
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="Depois:" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tipo:" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                    <TextBlock x:Name="TipoDepoisDadoTextBlock" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                    <TextBlock Text="Marca:" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                    <TextBlock x:Name="MarcaDepoisDadoTextBlock" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                    <TextBlock Text="Código:" Grid.Row="2" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                    <TextBlock x:Name="CodigoDepoisDadoTextBlock" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                    <TextBlock Text="Preço:" Grid.Row="3" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                    <TextBlock x:Name="PrecoDepoisDadoTextBlock" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                    <TextBlock Text="Quantidade:" Grid.Row="4" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                    <TextBlock x:Name="QuantidadeDepoisDadoTextBlock" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                </Grid>
                            </StackPanel>
                        </Grid>


                        <!-- Botão Adicionar -->
                        <Button Content="Adicionar na Lista" Style="{StaticResource EmphasisButtonStyle}" Width="200" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Segunda Border (Lista Retrátil) -->
                <Border Grid.Column="1" CornerRadius="15" Padding="15" Background="{StaticResource SecondaryBrush}" 
                        BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Lista" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                        <Separator Margin="0,10,0,10" />
                        <ItemsControl x:Name="ListaItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Nome}" Grid.Column="0" Foreground="{StaticResource TextBrush}" />
                                        <Button Content="✏" Grid.Column="1" Style="{StaticResource HoverButtonStyle}" Width="30" Height="30" />
                                        <Button Content="🗑" Grid.Column="2" Style="{StaticResource DeleteButtonStyle}" Width="30" Height="30" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Confirmar" Style="{StaticResource EmphasisButtonStyle}" Width="200" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

