<UserControl x:Class="WMS_RadiadoresLemos_WPF.AddEntradaSaídaUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.Resources>
            <Style TargetType="ColumnDefinition" x:Key="DynamicColumnStyle">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=ListaCompras, Path=Visibility}" Value="Collapsed">
                        <Setter Property="Width" Value="*" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ElementName=ListaCompras, Path=Visibility}" Value="Visible">
                        <Setter Property="Width" Value="3*" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ColumnDefinition" x:Key="ListaComprasColumnStyle">
                <Setter Property="Width" Value="2*" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=ListaCompras, Path=Visibility}" Value="Collapsed">
                        <Setter Property="Width" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <!-- Border Principal -->
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <!-- Layout Principal -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource DynamicColumnStyle}" />
                    <ColumnDefinition Style="{StaticResource ListaComprasColumnStyle}" />
                </Grid.ColumnDefinitions>

                <!-- Primeira Border (Conteúdo Principal) -->
                <Border x:Name="Principal" Grid.Column="0" CornerRadius="15" Padding="25" Margin="0"
                        Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1">
                    <Grid>
                        <!-- Principal -->
                        <StackPanel>
                            <!-- Tipo de Movimentação -->
                            <TextBlock Text="Tipo de Movimentação:" Margin="0,0,0,5" FontSize="16" Foreground="{StaticResource TextBrush}" />
                            <ComboBox Name="TipoMovimentacaoComboBox" Margin="0,0,0,15" FontSize="14" HorizontalAlignment="Stretch"
                                  Style="{StaticResource ComboBoxStyle}" Background="{StaticResource PanelBackgroundBrush}"
                                  SelectionChanged="TipoMovimentacaoComboBox_SelectionChanged">
                                <ComboBoxItem Content="Entrada" />
                                <ComboBoxItem Content="Saída" />
                            </ComboBox>

                            <!-- Produto -->
                            <TextBlock Text="Produto:" Margin="0,0,0,5" FontSize="16" Foreground="{StaticResource TextBrush}" />
                            <ComboBox Name="ProdutoComboBox" Margin="0,0,0,15" FontSize="14" HorizontalAlignment="Stretch"
                                      Style="{StaticResource ComboBoxStyle}" Background="{StaticResource PanelBackgroundBrush}"
                                      LostFocus="ProdutoComboBox_LostFocus" StaysOpenOnEdit="True" IsTextSearchEnabled="True"
                                      TextBoxBase.TextChanged="ProdutoComboBox_TextChanged"
                                      SelectionChanged="ProdutoComboBox_SelectionChanged"/>
                            
                            <!-- Quantidade e Preço -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Quantidade:" Margin="0,0,0,5" FontSize="16" Foreground="{StaticResource TextBrush}" />
                                    <TextBox Name="QuantidadeTextBox" FontSize="14" Style="{StaticResource {x:Type TextBox}}" 
                                             Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource TextBrush}" 
                                             LostFocus="QuantidadeTextBox_LostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Preço:" Margin="0,0,0,5" FontSize="16" Foreground="{StaticResource TextBrush}" />
                                    <TextBox Name="PrecoTextBox" FontSize="14" Style="{StaticResource {x:Type TextBox}}" 
                                             Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource TextBrush}" 
                                             LostFocus="PrecoTextBox_LostFocus" />
                                </StackPanel>
                            </Grid>

                            <!-- Antes e Depois -->
                            <Grid x:Name="ProdutoAntesDepois" Margin="0,0,0,15" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Antes -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Antes:" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tipo:" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                        <TextBlock x:Name="TipoAntesDadoTextBlock" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                        <TextBlock Text="Marca:" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                        <TextBlock x:Name="MarcaAntesDadoTextBlock" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                        <TextBlock Text="Código:" Grid.Row="2" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                        <TextBlock x:Name="CodigoAntesDadoTextBlock" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                        <TextBlock Text="Preço:" Grid.Row="3" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                        <TextBlock x:Name="PrecoAntesDadoTextBlock" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                        <TextBlock Text="Quantidade:" Grid.Row="4" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,5" />
                                        <TextBlock x:Name="QuantidadeAntesDadoTextBlock" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,5" />
                                    </Grid>
                                </StackPanel>

                                <!-- Separador -->
                                <Border Grid.Column="1" Width="1" Background="{StaticResource HoverBackgroundBrush}" Margin="5,0" />

                                <!-- Depois -->
                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="Depois:" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tipo:" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                        <TextBlock x:Name="TipoDepoisDadoTextBlock" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                        <TextBlock Text="Marca:" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                        <TextBlock x:Name="MarcaDepoisDadoTextBlock" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                        <TextBlock Text="Código:" Grid.Row="2" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                        <TextBlock x:Name="CodigoDepoisDadoTextBlock" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                        <TextBlock Text="Preço:" Grid.Row="3" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,0" />
                                        <TextBlock x:Name="PrecoDepoisDadoTextBlock" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,0" />
                                        <TextBlock Text="Quantidade:" Grid.Row="4" Grid.Column="0" Foreground="{StaticResource TextBrush}" Margin="0,5,10,5" />
                                        <TextBlock x:Name="QuantidadeDepoisDadoTextBlock" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource TextBrush}" Background="{StaticResource PanelBackgroundBrush}" TextAlignment="Left" Margin="0,5,0,5" />
                                    </Grid>
                                </StackPanel>
                            </Grid>


                            <!-- Botão Adicionar -->
                            <Button Content="Adicionar na Lista" Style="{StaticResource EmphasisButtonStyle}" Width="200" HorizontalAlignment="Center" Click="AdicionarNaLista_Click" />
                        </StackPanel>

                        <!-- Botão para alternar a visibilidade da ListaCompras -->
                        <Button Content="🛒" Style="{StaticResource EmphasisButtonStyle}" Width="40" Height="40"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0"
                                Click="ToggleListaCompras_Click" />
                    </Grid>                        
                </Border>

                <!-- Segunda Border (Lista Retrátil) -->
                <Border x:Name="ListaCompras" Grid.Column="1" CornerRadius="15" Padding="15" Margin="20,0,0,0" Visibility="Visible"
                        Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1">
                    <Grid>
                        <!-- Definição das linhas da Grid -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Título e botão fechar -->
                            <RowDefinition Height="*" />   <!-- ScrollViewer -->
                            <RowDefinition Height="Auto" /> <!-- Botão Confirmar -->
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho: Título e botão fechar -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Text="Lista" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" />

                            <Button Grid.Row="0" Content="✖" Style="{StaticResource DeleteButtonStyle}" Width="20" Height="20"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Column="1" 
                                    Click="FecharListaCompras_Click" />
                            
                            <Separator Grid.Row="1" Margin="5, 15" />
                        </Grid>

                        <!-- ScrollViewer para a lista -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ListaItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2,0,2" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="8" Padding="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Tipo de Movimentação -->
                                                <TextBlock Text="{Binding Tipo}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontSize="13"
                                                           FontWeight="Bold" Foreground="{StaticResource AccentBrush}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                <!-- StackPanel para os outros elementos -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                    <!-- Produto -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Produto:" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Text="{Binding ProdutoId}" Foreground="{StaticResource TextBrush}" />
                                                    </StackPanel>
                                                    
                                                    <!-- Quantidade -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Quantidade:" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Text="{Binding Quantidade}" Foreground="{StaticResource TextBrush}" />
                                                    </StackPanel>

                                                    <!-- Preço -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Preço:" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Text="{Binding Preco, StringFormat=C}" Foreground="{StaticResource TextBrush}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Botão de Excluir -->
                                                <Button Content="X" Grid.Row="1" Grid.Column="1" Style="{StaticResource DeleteButtonStyle}" 
                                                        Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                        Click="ExcluirItem_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Botão Confirmar -->
                        <Button Grid.Row="2" Content="Confirmar" Style="{StaticResource EmphasisButtonStyle}" Width="200" 
                                HorizontalAlignment="Center" Margin="0,10,0,0" Click="ConfimarPedido_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

