<Window x:Class="WMS_RadiadoresLemos_WPF.src.Views.CadastroVendasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Vendas" 
        Height="480" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Border Background="{StaticResource PanelBackgroundBrush}" 
            CornerRadius="15" 
            Margin="20" 
            Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Botão de fechar no canto superior direito -->
            <Button x:Name="btnFechar" 
                    Grid.Row="0" Grid.Column="1"
                    Content="✕" 
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="30" Height="30"
                    Margin="0,-15,-15,0"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="18"
                    Foreground="{StaticResource TextBrush}"
                    Click="BtnFechar_Click"/>

            <!-- Campos do formulário -->
            <TextBlock Grid.Row="0" Grid.Column="0" 
                       Text="Produto:" 
                       FontSize="18" 
                       Foreground="{StaticResource TextBrush}" 
                       Margin="0,0,15,15" 
                       VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" 
                     x:Name="txtProduto" 
                     Margin="0,0,0,15" 
                     Height="40"/>

            <TextBlock Grid.Row="1" Grid.Column="0" 
                       Text="Cliente:" 
                       FontSize="18" 
                       Foreground="{StaticResource TextBrush}" 
                       Margin="0,0,15,15" 
                       VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" 
                     x:Name="txtCliente" 
                     Margin="0,0,0,15" 
                     Height="40"/>

            <TextBlock Grid.Row="2" Grid.Column="0" 
                       Text="Preço:" 
                       FontSize="18" 
                       Foreground="{StaticResource TextBrush}" 
                       Margin="0,0,15,15" 
                       VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" 
                     x:Name="txtPreco" 
                     Margin="0,0,0,15" 
                     Height="40"/>

            <TextBlock Grid.Row="3" Grid.Column="0" 
                       Text="Data do pagamento:" 
                       FontSize="18" 
                       Foreground="{StaticResource TextBrush}" 
                       Margin="0,0,15,15" 
                       VerticalAlignment="Center"/>
            <DatePicker Grid.Row="3" Grid.Column="1" 
                      x:Name="datePagamento" 
                      Margin="0,0,0,15" 
                      Height="40"
                      Style="{StaticResource DatePickerStyle}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" 
                       Text="Data da compra:" 
                       FontSize="18" 
                       Foreground="{StaticResource TextBrush}" 
                       Margin="0,0,15,15" 
                       VerticalAlignment="Center"/>
            <DatePicker Grid.Row="4" Grid.Column="1" 
                      x:Name="dateCompra"
                      Margin="0,0,0,15"
                      Height="40"
                      Style="{StaticResource DatePickerStyle}"/>

            <!-- Botão Cadastrar -->
            <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="Cadastrar"
                  x:Name="btnCadastrar"
                  Style="{StaticResource EmphasisButtonStyle}"
                  Margin="0,20,0,0"
                  Height="55"
                  FontSize="22"
                  Click="BtnCadastrar_Click"/>
        </Grid>
    </Border>
</Window>