<Window x:Class="WMS_RadiadoresLemos_WPF.src.Views.EditarItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2005"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Editar Item" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="Editar Item" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Campos de Edição -->
        <StackPanel Grid.Row="1" Margin="0,10">
            <!-- Nome do Produto (somente leitura) -->
            <TextBlock Text="Produto:" 
                       FontSize="14" 
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,5"/>
            <TextBox Text="{Binding ProdutoNome, Mode=OneWay}"
                     IsReadOnly="True"
                     Style="{StaticResource {x:Type TextBox}}"
                     Background="{StaticResource PanelBackgroundBrush}"
                     Foreground="{StaticResource TextBrush}"
                     Margin="0,0,0,15"/>

            <!-- Quantidade -->
            <TextBlock Text="Quantidade:" 
                       FontSize="14" 
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,5"/>
            <TextBox Text="{Binding Quantidade}"
                     Style="{StaticResource {x:Type TextBox}}"
                     Background="{StaticResource PanelBackgroundBrush}"
                     Foreground="{StaticResource TextBrush}"
                     PreviewTextInput="QuantidadeTextBox_PreviewTextInput"
                     Margin="0,0,0,15"/>

            <!-- Preço -->
            <TextBlock Text="Preço:" 
                       FontSize="14" 
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,5"/>
            <TextBox Text="{Binding Preco, StringFormat=C2}"
                     Style="{StaticResource {x:Type TextBox}}"
                     Background="{StaticResource PanelBackgroundBrush}"
                     Foreground="{StaticResource TextBrush}"
                     PreviewTextInput="PrecoTextBox_PreviewTextInput"
                     Margin="0,0,0,15"/>

            <!-- Subtotal (somente leitura) -->
            <TextBlock Text="Subtotal:" 
                       FontSize="14" 
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,5"/>
            <TextBox Text="{Binding Subtotal, StringFormat=C2, Mode=OneWay}"
                     IsReadOnly="True"
                     Style="{StaticResource {x:Type TextBox}}"
                     Background="{StaticResource PanelBackgroundBrush}"
                     Foreground="{StaticResource TextBrush}"/>
        </StackPanel>

        <!-- Botões -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Content="Cancelar" 
                    Style="{StaticResource CancelButtonStyle}"
                    Width="100" 
                    Height="35" 
                    Margin="0,0,10,0"
                    Click="Cancelar_Click"/>
            <Button Content="Salvar" 
                    Style="{StaticResource EmphasisButtonStyle}"
                    Width="100" 
                    
                    Click="Salvar_Click"/>
        </StackPanel>
    </Grid>
</Window> 