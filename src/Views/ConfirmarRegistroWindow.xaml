<Window x:Class="WMS_RadiadoresLemos_WPF.src.Views.ConfirmarRegistroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.src.Views"
        mc:Ignorable="d"
        Title="Confirmar Registro" Height="350" Width="500" 
        MinWidth="500" MaxWidth="1000"
        MinHeight="350" MaxHeight="350"
        WindowStartupLocation="CenterScreen"
        TextBlock.Foreground="White" FontSize="16"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="10" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Títulos ANTES e DEPOIS -->
        <TextBlock Text="Antes" Grid.Row="0" Grid.Column="1" FontWeight="Bold" Margin="5" HorizontalAlignment="Center"/>
        <TextBlock Text="Depois" Grid.Row="0" Grid.Column="4" FontWeight="Bold" Margin="5" HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Nome:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProdutoAntes.Nome}" Margin="5" Background="White" Padding="2"/>
        <TextBlock Grid.Row="1" Grid.Column="3" Text="Nome:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding ProdutoDepois.Nome}" Margin="5" Background="White" Padding="2"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tipo:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProdutoAntes.Tipo}" Margin="5" Background="White" Padding="2"/>
        <TextBlock Grid.Row="2" Grid.Column="3" Text="Tipo:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding ProdutoDepois.Tipo}" Margin="5" Background="White" Padding="2"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Marca:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProdutoAntes.Marca}" Margin="5" Background="White" Padding="2"/>
        <TextBlock Grid.Row="3" Grid.Column="3" Text="Marca:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding ProdutoDepois.Marca}" Margin="5" Background="White" Padding="2"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Código:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProdutoAntes.Codigo}" Margin="5" Background="White" Padding="2"/>
        <TextBlock Grid.Row="4" Grid.Column="3" Text="Código:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding ProdutoDepois.Codigo}" Margin="5" Background="White" Padding="2"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Preço:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProdutoAntes.Preco, StringFormat={}{0:C}}" Margin="5" Background="White" Padding="2"/>
        <TextBlock Grid.Row="5" Grid.Column="3" Text="Preço:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="5" Grid.Column="4" Text="{Binding ProdutoDepois.Preco, StringFormat={}{0:C}}" Margin="5" Background="White" Padding="2"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Quantidade:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ProdutoAntes.Quantidade}" Margin="5" Background="White" Padding="2"/>
        <TextBlock Grid.Row="6" Grid.Column="3" Text="Quantidade:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="6" Grid.Column="4" Text="{Binding ProdutoDepois.Quantidade}" Margin="5" Background="White" Padding="2"/>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="15">
            <Button Content="Confirmar" Width="100" Margin="5, 5, 15, 5" Click="ConfirmarButton_Click"/>
            <Button Content="Cancelar" Width="100" Margin="5" Click="CancelarButton_Click"
                    Style="{StaticResource CancelButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
