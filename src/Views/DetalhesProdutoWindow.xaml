<Window x:Class="WMS_RadiadoresLemos_WPF.src.Views.DetalhesProdutoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.src.Views"
        mc:Ignorable="d"
        Title="Detalhes do Produto" Height="265" Width="225"
        TextBlock.Foreground="White" FontSize="16"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Nome}" Margin="5" Background="White" Padding="2"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tipo:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tipo}" Margin="5" Background="White" Padding="2"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Marca:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Marca}" Margin="5" Background="White" Padding="2"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Código:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Codigo}" Margin="5" Background="White" Padding="2"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Preço:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Preco, StringFormat={}{0:C}}" Margin="5" Background="White" Padding="2"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Quantidade:" FontWeight="Bold" Margin="5"/>
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Quantidade}" Margin="5" Background="White" Padding="2"/>

        <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Content="OK" HorizontalAlignment="Center" Width="50" Margin="15" Click="OkButton_Click"/>
    </Grid>

</Window>
