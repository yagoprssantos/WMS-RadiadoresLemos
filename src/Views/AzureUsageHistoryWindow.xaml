<Window x:Class="WMS_RadiadoresLemos_WPF.Views.AzureUsageHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.Views"
        mc:Ignorable="d"
        Title="Histórico de Uso do Azure" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Histórico de Uso do Azure Storage" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <DataGrid Grid.Row="1" 
                  x:Name="UsageHistoryGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" 
                                  Binding="{Binding Data, StringFormat=dd/MM/yyyy HH:mm:ss}"
                                  Width="150"/>
                <DataGridTextColumn Header="Uploads" 
                                  Binding="{Binding Uploads}"
                                  Width="100"/>
                <DataGridTextColumn Header="Downloads" 
                                  Binding="{Binding Downloads}"
                                  Width="100"/>
                <DataGridTextColumn Header="Exclusões" 
                                  Binding="{Binding Deletes}"
                                  Width="100"/>
                <DataGridTextColumn Header="Tamanho Total" 
                                  Binding="{Binding FormattedSize}"
                                  Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Atualizar" 
                    Click="RefreshButton_Click"
                    Width="100" 
                    Height="30" 
                    Margin="0,0,10,0"/>
            <Button Content="Fechar" 
                    Click="CloseButton_Click"
                    Width="100" 
                    Height="30"/>
        </StackPanel>
    </Grid>
</Window> 