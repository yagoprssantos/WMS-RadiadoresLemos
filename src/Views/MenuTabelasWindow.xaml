<Window x:Class="WMS_RadiadoresLemos_WPF.MenuTabelasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" 
        Title="Menu de Tabelas" Height="630" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15">
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra de Pesquisa, Filtro e Seleção de Tabela -->
                <Grid Margin="0,0,0,20" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="{StaticResource SecondaryBrush}" CornerRadius="15" Height="36" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                  Fill="{StaticResource TextBrush}" Width="23" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Fill" Margin="10,0,10,0"/>
                            <TextBox Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="5,0" Margin="0,0,10,0" TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="2" x:Name="FiltrarButton"  Content="Filtrar por" ToolTip="Filtrar" Style="{StaticResource FilterButtonStyle}" Click="FiltrarButton_Click"/>
                    <ComboBox Grid.Column="3" x:Name="TabelasComboBox" Text="Selecionar tabela" ToolTip="Selecionar Tabela" Style="{StaticResource ComboBoxSelectStyle}" Margin="5,0,0,0" SelectionChanged="TabelasComboBox_SelectionChanged">
                    </ComboBox>
                </Grid>

                <!-- DataGrid para exibir os dados -->
                <Border Grid.Row="1" CornerRadius="15" Background="{StaticResource SecondaryBrush}" Padding="5" Margin="0">
                    <StackPanel>
                        <DataGrid x:Name="TabelaDataGrid" Grid.Row="1" AutoGenerateColumns="False" Margin="0,0,0,15"
                                  Style="{StaticResource CustomDataGridStyle}" IsReadOnly="False"/>
                    </StackPanel>
                </Border>

                <!-- Botões de ação -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 10, 0, 0">
                    <Button Content="Adicionar" Click="AdicionarButton_Click" Width="120" Height="40" Margin="10" Style="{StaticResource EmphasisButtonStyle}"/>
                    <Button Content="Editar" Click="EditarButton_Click" Width="120" Height="40" Margin="10" Style="{StaticResource EmphasisButtonStyle}"/>
                    <Button Content="Deletar" Click="DeletarButton_Click" Width="120" Height="40" Margin="10" Style="{StaticResource CancelButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filtro Genérico -->
        <Popup x:Name="FiltroPopup" Placement="Bottom" StaysOpen="False" PlacementTarget="{Binding ElementName=FiltrarButton}">
            <Border Background="{StaticResource PanelBackgroundBrush}" Padding="15">
                <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15">
                    <StackPanel Background="Transparent" Margin="5">
                        <StackPanel x:Name="FiltroContainer" Orientation="Vertical" Margin="0, 10">
                            <!-- Os filtros serão adicionados dinamicamente aqui -->
                        </StackPanel>

                        <!-- Botões de Ação -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                            <Button Content="Aplicar Filtro" Click="AplicarFiltroButton_Click" 
                            Style="{StaticResource EmphasisButtonStyle}" 
                            Width="140" FontSize="14" />

                            <Button Content="Limpar" Click="LimparFiltroButton_Click" 
                            Style="{StaticResource EmphasisButtonStyle}" 
                            Background="{StaticResource HoverBackgroundBrush}"
                            Width="100" FontSize="14"
                            Margin="15, 0, 0, 0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
    </Grid>
</Window>
