<UserControl x:Class="WMS_RadiadoresLemos_WPF.src.Views.DetalhesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2005"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="Auto" Width="Auto"
             MinHeight="550" MinWidth="700"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" 
                    CornerRadius="15" Padding="20" Background="{StaticResource PanelBackgroundBrush}">

                <!-- Layout Principal -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Cabeçalho -->
                        <RowDefinition Height="Auto"/>
                        <!-- Separador -->
                        <RowDefinition Height="Auto"/>
                        <!-- Info Gerais + Pagamento -->
                        <RowDefinition Height="Auto"/>
                        <!-- Espaçador -->
                        <RowDefinition Height="Auto"/>
                        <!-- Boletos + Itens -->
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho com NF e Data -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding NotaFiscal, StringFormat='Nota Fiscal: {0}', TargetNullValue='Sem Nota Fiscal'}"
                                   FontSize="20" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Left" 
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="Editar" FontSize="14" Height="Auto" Width="100" Margin="0"
                                ToolTip="Editar informações" Style="{StaticResource EmphasisButtonStyle}" 
                                Click="Editar_Click"/>
                    </Grid>

                    <!-- Separador -->
                    <Separator Grid.Row="1" 
                               Background="{StaticResource HoverBackgroundBrush}" 
                               Height="1" 
                               Margin="0,5,0,15"/>

                    <!-- Info Gerais + Pagamento -->
                    <Grid Grid.Row="2">
                        <Border CornerRadius="15" 
                                Padding="15"
                                Margin="0" 
                                Background="{StaticResource BackgroundBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Cabeçalho e valor total -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Informações principais -->
                                    <RowDefinition Height="*"/>
                                    <!-- Detalhes adicionais -->
                                </Grid.RowDefinitions>

                                <!-- Cabeçalho e valor total -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="Informações" 
                                               FontSize="16" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextBrush}" 
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" 
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="Total:" 
                                                   Foreground="{StaticResource TextBrush}" 
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding ValorTotal, StringFormat='R$ {0:N2}'}" 
                                                   Foreground="{StaticResource AccentBrush}" 
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Informações principais -->
                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Coluna da esquerda - Informações principais -->
                                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Fornecedor/Cliente -->
                                        <TextBlock x:Name="FCLabel" 
                                                   Grid.Row="0" Grid.Column="0"
                                                   Text="Fornecedor:" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextBrush}" 
                                                   Margin="0,0,10,5"/>
                                        <TextBox x:Name="FCTextBox" 
                                                 Grid.Row="0" Grid.Column="1"
                                                 IsReadOnly="True" 
                                                 FontSize="14"
                                                 Foreground="{StaticResource TextBrush}"
                                                 Background="{StaticResource PanelBackgroundBrush}"
                                                 Margin="0,0,0,10"/>

                                        <!-- Tipo de Pagamento -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                                   Text="Tipo de Pagamento:" 
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" 
                                                   Margin="0,0,10,5"/>
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding TipoPagamento, TargetNullValue='Não informado'}"
                                                 IsReadOnly="True" 
                                                 FontSize="14"
                                                 Foreground="{StaticResource TextBrush}"
                                                 Background="{StaticResource PanelBackgroundBrush}"
                                                 Margin="0,0,0,00"/>



                                    </Grid>

                                    <!-- Coluna da direita - Informações principais -->
                                    <Grid Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Data -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                                   Text="Data:" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextBrush}" 
                                                   Margin="0,0,10,5"/>
                                        <TextBox x:Name="DataCompraTextBox" 
                                                 Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding DataCompra, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                 IsReadOnly="True"
                                                 FontSize="14"
                                                 Foreground="{StaticResource TextBrush}"
                                                 Background="{StaticResource PanelBackgroundBrush}"
                                                 Margin="0,0,0,10"/>
                                        
                                        <!-- Parcelas -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                                   Text="Parcelas:" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextBrush}" 
                                                   Margin="0,0,10,5"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" 
                                                 x:Name="ParcelasTextBox"
                                                 Text="{Binding Parcelas, TargetNullValue='0'}"
                                                 IsReadOnly="True" 
                                                 FontSize="14"
                                                 Foreground="{StaticResource TextBrush}"
                                                 Background="{StaticResource PanelBackgroundBrush}"
                                                 Margin="0,0,0,0"/>
                                    </Grid>
                                    
                                    <!-- Lista de produtos da compra/venda -->
                                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   x:Name="ProdutosLabel"
                                                   Text="Produtos da Compra:" 
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextBrush}" 
                                                   Margin="0,0,0,5"/>
                                        <!-- DataGrid de produtos -->
                                        <DataGrid Grid.Row="1"
                                                  x:Name="ProdutosDataGrid"
                                                  FontSize="14"
                                                  Style="{StaticResource CustomDataGridStyle}"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  EnableRowVirtualization="True"
                                                  Margin="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*" FontSize="14"/>
                                                <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" Width="Auto" FontSize="14"/>
                                                <DataGridTextColumn Header="Preço Unitário" Binding="{Binding PrecoUnitario, StringFormat={}{0:C2}}" Width="Auto" FontSize="14"/>
                                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:C2}}" Width="Auto" FontSize="14"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>

                                    <!-- Detalhes/Observações -->
                                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="278*"/>
                                            <ColumnDefinition Width="57*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" 
                                                   Text="Detalhes:" 
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextBrush}" 
                                                   Margin="0,0,0,5" Grid.ColumnSpan="2"/>
                                        <TextBox Grid.Row="1" 
                                                 x:Name="DetalhesTextBox"
                                                 Text="{Binding Detalhes, TargetNullValue='Sem detalhes adicionais'}"
                                                 IsReadOnly="True" 
                                                 FontSize="14" 
                                                 MinHeight="30"
                                                 Foreground="{StaticResource TextBrush}"
                                                 Background="{StaticResource PanelBackgroundBrush}"
                                                 Height="Auto"
                                                 TextWrapping="Wrap" 
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Espaçador -->
                    <Rectangle Grid.Row="3" Height="15" Fill="Transparent"/>

                    <!-- Boletos + Itens -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Boletos -->
                        <Border x:Name="CampoBoletos"
                                Grid.Column="0"
                                CornerRadius="15" 
                                Padding="15"
                                Margin="0,0,5,0" 
                                Background="{StaticResource BackgroundBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Cabeçalho -->
                                    <RowDefinition Height="*"/>
                                    <!-- Lista -->
                                </Grid.RowDefinitions>

                                <!-- Cabeçalho -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="Boletos e Parcelas" 
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               FontSize="16" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextBrush}"/>

                                    <Button Grid.Column="2" Content="Visualizar Boletos" Margin="0" FontSize="14" Height="Auto" Width="150"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            ToolTip="Visualizar ou gerenciar boletos"
                                            Style="{StaticResource EmphasisButtonStyle}" 
                                            Click="VisualizarBoletos_Click"/>
                                </Grid>

                                <!-- DataGrid de Boletos -->
                                <Border Grid.Row="1" 
                                        Background="{StaticResource PanelBackgroundBrush}" 
                                        CornerRadius="15">
                                    <Grid>
                                        <TextBlock x:Name="SemBoletosMessage" 
                                                   Text="Nenhum boleto registrado para esta compra." 
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Padding="20,10"
                                                   Margin="10"
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Visibility="Collapsed"/>

                                        <DataGrid x:Name="BoletosDataGrid"
                                                  Style="{StaticResource CustomDataGridStyle}"
                                                  Margin="5"
                                                  Height="Auto"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  AutoGenerateColumns="False"
                                                  Visibility="Visible"
                                                  IsReadOnly="True"
                                                  EnableRowVirtualization="True">
                                            <DataGrid.Columns>
                                                <!-- Parcela -->
                                                <DataGridTextColumn Header="Parcela" 
                                                                    Binding="{Binding Parcela}" 
                                                                    Width="Auto"/>

                                                <!-- Situação de vencimento -->
                                                <DataGridTextColumn Header="Situação" 
                                                                    Binding="{Binding SituacaoVencimento}" 
                                                                    Width="*"/>

                                                <!-- Nome do arquivo (extraído do caminho) -->
                                                <DataGridTextColumn Header="Arquivo"
                                                                    Binding="{Binding NomeArquivo}" 
                                                                    Width="*"/>

                                                <!-- Data de vencimento -->
                                                <DataGridTextColumn Header="Vencimento" 
                                                                    Binding="{Binding VencimentoFormatado}" 
                                                                    Width="Auto"/>

                                                <!-- Data de pagamento (se existir) -->
                                                <DataGridTextColumn Header="Pagamento" 
                                                                    Binding="{Binding PagamentoFormatado}" 
                                                                    Width="Auto"/>

                                                <!-- Botão para abrir o PDF -->
                                                <DataGridTemplateColumn Header="Ações" Width="Auto">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Abrir PDF" 
                                                                    Click="AbrirPDF_Click"
                                                                    CommandParameter="{Binding CaminhoArquivo}"
                                                                    Padding="5,2"
                                                                    Margin="2"
                                                                    Style="{StaticResource EmphasisButtonStyle}"
                                                                    FontSize="13"
                                                                    IsEnabled="{Binding ArquivoExiste}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>