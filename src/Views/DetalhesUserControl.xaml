<UserControl x:Class="WMS_RadiadoresLemos_WPF.src.Views.DetalhesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2005"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" 
                    CornerRadius="15" Padding="20" Background="{StaticResource PanelBackgroundBrush}">

                <!-- Layout Principal -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Cabeçalho -->
                        <RowDefinition Height="Auto"/>
                        <!-- Separador -->
                        <RowDefinition Height="Auto"/>
                        <!-- Info Gerais + Pagamento -->
                        <RowDefinition Height="Auto"/>
                        <!-- Espaçador -->
                        <RowDefinition Height="Auto"/>
                        <!-- Boletos + Itens -->
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho com NF e Data -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding NotaFiscal, StringFormat='Nota Fiscal: {0}', TargetNullValue='Sem Nota Fiscal'}"
                                   FontSize="15" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Left" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding DataCompra, StringFormat='Data: {0:dd/MM/yyyy HH:mm}'}"
                                   FontSize="16" 
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" 
                                   Margin="0,0,5,0"/>
                    </Grid>

                    <!-- Separador -->
                    <Separator Grid.Row="1" 
                               Background="{StaticResource HoverBackgroundBrush}" 
                               Height="1" 
                               Margin="0,5,0,15"/>

                    <!-- Info Gerais + Pagamento -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Informações Gerais -->
                        <Border Grid.Column="0"
                                CornerRadius="15" 
                                Padding="15"
                                Margin="0,0,5,0" 
                                Background="{StaticResource BackgroundBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Título -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Dados -->
                                    <RowDefinition Height="*"/>
                                    <!-- Descrição -->
                                </Grid.RowDefinitions>

                                <!-- Título -->
                                <TextBlock Grid.Row="0" 
                                           Text="Informações Gerais" 
                                           FontSize="16" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextBrush}" 
                                           Margin="0,0,0,12"/>

                                <!-- Dados -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Fornecedor/Cliente -->
                                    <TextBlock x:Name="FornecedorLabel" 
                                               Grid.Row="0" Grid.Column="0"
                                               Text="Fornecedor:" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{StaticResource TextBrush}" 
                                               Margin="0,0,10,5"/>
                                    <TextBox x:Name="FornecedorTextBox" 
                                             Grid.Row="0" Grid.Column="1"
                                             IsReadOnly="True" 
                                             FontSize="14"
                                             Foreground="{StaticResource TextBrush}"
                                             Background="{StaticResource PanelBackgroundBrush}"
                                             Margin="0,0,0,5"/>
                                    <!-- Data -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" 
                                               Text="Data:" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{StaticResource TextBrush}" 
                                               Margin="0,0,10,5"/>
                                    <TextBox x:Name="DataCompraTextBox" 
                                             Grid.Row="2" Grid.Column="1"
                                             Text="{Binding DataCompra, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                             IsReadOnly="True"
                                             FontSize="14"
                                             Foreground="{StaticResource TextBrush}"
                                             Background="{StaticResource PanelBackgroundBrush}"
                                             Margin="0,5,0,0"/>
                                </Grid>

                                <!-- Descrição -->
                                <Grid Grid.Row="2" Margin="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" 
                                               Text="Detalhes:" 
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{StaticResource TextBrush}" 
                                               Margin="0,0,0,5"/>
                                    <TextBox Grid.Row="1" 
                                             x:Name="DetalhesTextBox"
                                             Text="{Binding Detalhes, TargetNullValue='Sem detalhes adicionais'}"
                                             IsReadOnly="True" 
                                             FontSize="14"
                                             Foreground="{StaticResource TextBrush}"
                                             Background="{StaticResource PanelBackgroundBrush}"
                                             Height="Auto"
                                             TextWrapping="Wrap" 
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Informações de Pagamento -->
                        <Border Grid.Column="1"
                                CornerRadius="15" 
                                Padding="15"
                                Margin="5,0,0,0" 
                                Background="{StaticResource BackgroundBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Título + Valor -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Tipo + Parcelas -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Próx. vencimento -->
                                    <RowDefinition Height="*"/>
                                    <!-- Espaço flexível -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Botões -->
                                </Grid.RowDefinitions>

                                <!-- Título + Valor -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Informações Pagamento" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextBrush}" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <StackPanel Grid.Column="1" 
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Margin="0">
                            <TextBlock Text="Total:" 
                                       Foreground="{StaticResource TextBrush}" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ValorTotal, StringFormat='R$ {0:N2}'}" 
                                       Foreground="{StaticResource AccentBrush}" 
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                                <!-- Tipo + Parcelas -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Tipo de Pagamento -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" 
                                               Text="Tipo de Pagamento:" 
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" 
                                               Margin="0,0,10,5"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding TipoPagamento, TargetNullValue='Não informado'}"
                                             IsReadOnly="True" 
                                             FontSize="14"
                                             Foreground="{StaticResource TextBrush}"
                                             Background="{StaticResource PanelBackgroundBrush}"
                                             Margin="0,0,0,5"/>
                                    <!-- Parcelas -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                               Text="Parcelas:" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{StaticResource TextBrush}" 
                                               Margin="0,0,10,5"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" 
                                             x:Name="ParcelasTextBox"
                                             Text="{Binding Parcelas, TargetNullValue='0'}"
                                             IsReadOnly="True" 
                                             FontSize="14"
                                             Foreground="{StaticResource TextBrush}"
                                             Background="{StaticResource PanelBackgroundBrush}"
                                             Margin="0,5,0,5"/>
                                    <!-- Próximo Vencimento -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" 
                                               Text="Próximo Vencimento:" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{StaticResource TextBrush}" 
                                               Margin="0,0,10,5"/>
                                    <TextBox Grid.Row="3" Grid.Column="1"
                                             Text="{Binding ProximoVencimento, StringFormat={}{0:dd/MM/yyyy}}"
                                             IsReadOnly="True" 
                                             FontSize="14"
                                             Foreground="{StaticResource TextBrush}"
                                             Background="{StaticResource PanelBackgroundBrush}"
                                             Margin="0,5,0,0"/>
                                </Grid>

                                <!-- Botões -->
                                <StackPanel Grid.Row="4" 
                                            Orientation="Horizontal" 
                                            HorizontalAlignment="Center"
                                            Margin="0,10,0,0">
                                    <Button Content="Visualizar Boletos" FontSize="14" Height="Auto" Width="180"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            ToolTip="Visualizar ou gerenciar boletos"
                                            Style="{StaticResource EmphasisButtonStyle}" 
                                            Click="VisualizarBoletos_Click"
                                            Margin="0,0,10,0"/>
                                    <Button Content="Editar" FontSize="14" Height="Auto" Width="100"
                                            ToolTip="Editar informações"
                                            Style="{StaticResource EmphasisButtonStyle}" 
                                            Click="Editar_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Espaçador -->
                    <Rectangle Grid.Row="3" Height="15" Fill="Transparent"/>

                    <!-- Boletos + Itens -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Boletos -->
                        <Border Grid.Column="0"
                                CornerRadius="15" 
                                Padding="15"
                                Margin="0,0,5,0" 
                                Background="{StaticResource BackgroundBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Cabeçalho -->
                                    <RowDefinition Height="*"/>
                                    <!-- Lista -->
                                </Grid.RowDefinitions>

                                <!-- Cabeçalho -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="Boletos e Parcelas" 
                                               FontSize="15" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextBrush}" 
                                               Margin="0,0,0,10"/>
                                    <Button Grid.Column="1" 
                                            Content="+" 
                                            Width="24" 
                                            Height="24"
                                            ToolTip="Adicionar boleto"
                                            Click="AdicionarBoleto_Click"/>
                                </Grid>

                                <!-- Lista de Boletos -->
                                <Border Grid.Row="1" 
                                        Background="{StaticResource PanelBackgroundBrush}" 
                                        CornerRadius="15" 
                                        MinHeight="200">
                                    <Grid>
                                        <TextBlock Text="Nenhum boleto registrado para esta compra." 
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                        <ListView x:Name="BoletosListView"
                                                  ItemsSource="{Binding Boletos}" 
                                                  Style="{StaticResource CustomListViewStyle}"
                                                  ItemContainerStyle="{StaticResource CustomListViewItemStyle}"
                                                  BorderThickness="0"
                                                  Background="Transparent">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,2"
                                                                Padding="8,6"
                                                                CornerRadius="10"
                                                                Background="{StaticResource SecondaryBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Parcela -->
                                                            <TextBlock Grid.Column="0"
                                                                           Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Path=(ItemsControl.AlternationIndex), StringFormat='Parcela {0}'}"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,10,0"/>
                                                            <!-- ID/Referência -->
                                                            <TextBlock Grid.Column="1"
                                                                           Text="{Binding}"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>
                                                            <!-- Status -->
                                                            <TextBlock Grid.Column="2"
                                                                           Text="Pendente"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Margin="10,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Itens da Compra -->
                        <Border Grid.Column="1"
                                CornerRadius="15" 
                                Padding="15"
                                Margin="5,0,0,0" 
                                Background="{StaticResource BackgroundBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Cabeçalho -->
                                    <RowDefinition Height="*"/>
                                    <!-- Lista -->
                                </Grid.RowDefinitions>

                                <!-- Cabeçalho -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="Itens da Compra" 
                                               FontSize="15" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextBrush}" 
                                               Margin="0,0,0,10"/>
                                    <TextBlock Grid.Column="1" 
                                               FontSize="16"
                                               Foreground="{StaticResource TextBrush}" 
                                               FontWeight="SemiBold">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} item(ns)">
                                                <Binding Path="Itens.Count"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <!-- Lista de Itens -->
                                <Border Grid.Row="1" 
                                        Background="{StaticResource PanelBackgroundBrush}" 
                                        CornerRadius="15" 
                                        MinHeight="200">
                                    <Grid>
                                        <TextBlock Text="Nenhum item registrado para esta compra." 
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextBrush}"
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                        <ListView ItemsSource="{Binding Itens}" 
                                                  Style="{StaticResource CustomListViewStyle}"
                                                  ItemContainerStyle="{StaticResource CustomListViewItemStyle}"
                                                  BorderThickness="0"
                                                  Background="Transparent">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,2"
                                                            Padding="8,6"
                                                            CornerRadius="10"
                                                            Background="{StaticResource SecondaryBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Nome do Produto -->
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding ProdutoNome}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                            <!-- Quantidade -->
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Quantidade, StringFormat='Quantidade: {0}'}"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0,0,0"/>
                                                            <!-- Preço Unitário -->
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Preco, StringFormat='R$ {0:N2}'}"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0,0,0"/>
                                                            <!-- Total do Item -->
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding Preco, StringFormat='Total: R$ {0:N2}'}"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>

                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>