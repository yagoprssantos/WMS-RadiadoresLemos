<UserControl x:Class="WMS_RadiadoresLemos_WPF.BancoDadosUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TabControl>
            <!-- Primeira Aba: Ferramentas de Banco de Dados -->
            <TabItem Header="Ferramentas" FontSize="18">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <GroupBox Header="Informações de Conexão" Grid.Row="0" Margin="10"
                              Foreground="White">
                        <StackPanel Margin="10">
                            <TextBlock Text="Servidor: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding ServerInfo}"/>
                            <TextBlock Text="Banco de Dados: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding DatabaseInfo}"/>
                            <TextBlock Text="Status da Conexão: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding ConnectionStatus}"/>
                        </StackPanel>
                    </GroupBox>
                    <UniformGrid Rows="1" Columns="3" Margin="0,5,0,10" Grid.Row="1">
                        <Button Content="Exportar Dados" Margin="5" 
                                Click="ExportarDados_Click"/>
                        <Button Content="Importar Dados" Margin="5"
                                Click="ImportarDados_Click"/>
                        <Button Content="Fazer reconexão" Margin="5"/>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <!-- Segunda Aba: Visualização de Dados -->
            <TabItem Header="Visualizar Dados" FontSize="18">
                <DockPanel Margin="10">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Selecione a Tabela:" FontWeight="Bold" Margin="5" VerticalAlignment="Center" Grid.Column="0"
                                   Foreground="White"/>
                        <ComboBox x:Name="TabelaComboBox" Width="Auto" Margin="5" Grid.Column="1" SelectionChanged="TabelaComboBox_SelectionChanged">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    <Setter Property="VerticalContentAlignment" Value="{Binding Path=VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pesquisar:" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="White"/>
                        <TextBox Name="SearchBox" Grid.Column="1" 
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                        <Button Content="↺" ToolTip="Atualizar" Click="AtualizarDataGrid_Click" 
                                HorizontalAlignment="Center" VerticalAlignment="Top" 
                                Background="Transparent" Foreground="White" 
                                Padding="0" Margin="7, 0, 0, 0"
                                FontSize="33" Grid.Column="2"/>
                    </Grid>
                    <DataGrid x:Name="DadosDataGrid"
                              AutoGenerateColumns="True" IsReadOnly="True" 
                              SelectionMode="Single" SelectionUnit="FullRow"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="Auto"
                              AlternatingRowBackground="Gainsboro" AlternationCount="2"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" 
                              ColumnWidth="Auto">
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        <!-- Barra de Progresso -->
        <Grid Name="ShowProgressBar" Background="#80000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" Height="Auto" Width="600">
                <TextBlock Text="Processando..." FontWeight="Bold" FontSize="20" Margin="0, 20, 0, 20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ProgressBar" Height="20" Width="500" Margin="0, 0, 0, 30"
                     VerticalAlignment="Center" HorizontalAlignment="Center" 
                     Minimum="0" Maximum="100" Value="{Binding ProgressValue}"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
