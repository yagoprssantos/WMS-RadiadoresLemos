<UserControl x:Class="WMS_RadiadoresLemos_WPF.Views.BancoDadosUserControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.Views"
            mc:Ignorable="d"
            d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="15">
        <Border BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="1" CornerRadius="15" Padding="25" Background="{StaticResource SecondaryBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="18" Padding="10" Margin="5,0,5,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Banco de Dados" Foreground="{StaticResource TextBrush}" FontSize="18" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Área principal -->
                <StackPanel Grid.Row="1">
                    <!-- Acessar arquivos -->
                    <TextBlock Text="Acessar arquivos do banco de dados:" Style="{StaticResource TextBoxCustom2ButtonStyle}" HorizontalAlignment="Left" FontSize="14"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="AbrirArquivosLocaisButton" Content="ABRIR ARQUIVOS LOCAIS" Margin="5,0,15,0" Style="{StaticResource EmphasisButtonStyle}" FontSize="12"/>
                    </Grid>

                    <!-- Backup -->
                    <TextBlock Text="Realizar backup:" Style="{StaticResource TextBoxCustom2ButtonStyle}" HorizontalAlignment="Left" FontSize="14"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="ImportarBackupButton" Content="IMPORTAR ARQUIVO" Margin="15,0,15,0" Style="{StaticResource EmphasisButtonStyle}" FontSize="12" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1" x:Name="ExportarLocalButton" Content="EXPORTAR LOCAL" Margin="15,0,15,0" Style="{StaticResource EmphasisButtonStyle}" FontSize="12" HorizontalAlignment="Stretch" Click="ExportarLocalButton_Click"/>
                    </Grid>

                    <!-- Tabelas Excel -->
                    <TextBlock Text="Tabelas do Excel:" Style="{StaticResource TextBoxCustom2ButtonStyle}" HorizontalAlignment="Left" FontSize="14"/>
                    <Button x:Name="VisualizarExcelButton" Content="VISUALIZAR EM EXCEL" Margin="5" Style="{StaticResource EmphasisButtonStyle}" FontSize="12" HorizontalAlignment="Stretch" Click="VisualizarExcelButton_Click"/>


                    <!-- Menu de Tabelas -->
                    <TextBlock Text="Visualizar Menu de Tabelas:" Style="{StaticResource TextBoxCustom2ButtonStyle}" HorizontalAlignment="Left" FontSize="14" />
                    <Button x:Name="AbrirMenuTabelasButton" Content="ABRIR MENU DE TABELAS" Style="{StaticResource EmphasisButtonStyle}" FontSize="12" Click="AbrirMenuTabelasButton_Click"/>
                </StackPanel>

                
                


                <!-- Mais Informações -->
                <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="15" Padding="15" Margin="0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Título -->
                        <TextBlock Grid.Row="0" 
                                 Text="Mais Informações" 
                                 Foreground="{StaticResource TextBrush}"
                                 FontSize="16" 
                                 FontWeight="Bold"
                                 Margin="0,0,0,10"/>

                        <!-- Banco de Dados -->
                        <TextBlock x:Name="BancoDadosText" 
                                 Grid.Row="1"
                                 Text="Banco de Dados: Local" 
                                 Foreground="{StaticResource TextBrush}"
                                 FontSize="14"
                                 Margin="0,0,0,5"/>

                        <!-- Último Backup Importado -->
                        <TextBlock x:Name="UltimoBackupImportadoText" 
                                 Grid.Row="3"
                                 Text="Último backup importado: Nenhum" 
                                 Foreground="{StaticResource TextBrush}"
                                 FontSize="14"
                                 Margin="0,0,0,5"/>

                        <!-- Último Backup Exportado -->
                        <TextBlock x:Name="UltimoBackupExportadoText" 
                                 Grid.Row="4"
                                 Text="Último backup exportado: Nenhum" 
                                 Foreground="{StaticResource TextBrush}"
                                 FontSize="14"
                                 Margin="0,0,0,5"/>

                        <!-- Backup Atual -->
                        <TextBlock x:Name="BackupAtualText" 
                                 Grid.Row="5"
                                 Text="Backup Atual: Não salvo" 
                                 Foreground="{StaticResource TextBrush}"
                                 FontSize="14"
                                 Margin="0,0,0,5"/>

                        <!-- Status Azure -->
                        <TextBlock x:Name="AzureStatusText" 
                                 Grid.Row="6"
                                 Text="Status Azure: Não testado" 
                                 Foreground="{StaticResource TextBrush}"
                                 FontSize="14"
                                 Margin="0,0,0,5"/>

                        <!-- Botões -->
                        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
                            <Button x:Name="ListarAzureButton" Content="LISTAR ARQUIVOS" Click="ListarAzure_Click" Margin="0,0,10,0"/>
                            <Button x:Name="ImportarBackupAzureButton" Content="IMPORTAR BACKUP" Click="ImportarBackupAzureButton_Click" Margin="0,0,10,0"/>
                            <Button x:Name="AbrirAzureButton" Content="ABRIR AZURE" Click="AbrirAzureNoNavegador_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Barra de Progresso -->
        <Grid Name="ShowProgressBar" Background="#80000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource BackgroundBrush}" Height="Auto" Width="600">
                <TextBlock Text="Processando Informações. Por favor, Aguarde" Style="{StaticResource TextBoxCustom2ButtonStyle}" FontSize="20" Margin="0, 20, 0, 20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Name="ProgressBarMessage" Text="Aguardando próxima ação..." Style="{StaticResource TextBoxCustom2ButtonStyle}" FontSize="16" Margin="0, 0, 0, 20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ProgressBar Name="ProgressBar" Height="20" Width="500" Margin="0, 0, 0, 30"
                             VerticalAlignment="Center" HorizontalAlignment="Center" 
                             Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
