<UserControl x:Class="WMS_RadiadoresLemos_WPF.BancoDadosUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">

    <Grid Margin="10">
        <TabControl>
            <!-- Primeira Aba: Ferramentas de Banco de Dados -->
            <TabItem Header="Ferramentas" FontSize="18">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <GroupBox Header="Informações de Conexão" Grid.Row="0" Margin="10"
                  Foreground="White">
                        <StackPanel Margin="10">
                            <TextBlock>
                                <Run Text="Servidor: " FontWeight="Bold"/>
                                <Run Text="FireBase - FirestoreDatabase"/>
                            </TextBlock>
                            <TextBlock Text=""/>
                            <TextBlock>
                                <Run Text="Banco de Dados: " FontWeight="Bold"/>
                                <Run Text="RadiadoresLemos"/>
                            </TextBlock>
                            <TextBlock Text=""/>
                            <TextBlock>
                                <Run Text="Status da Conexão: " FontWeight="Bold"/>
                                <Run Text="{Binding ConnectionStatus}"/>
                            </TextBlock>
                            <TextBlock Text=""/>
                        </StackPanel>
                    </GroupBox>
                    <UniformGrid Rows="1" Columns="4" Margin="0,5,0,10" Grid.Row="1">
                        <Button Content="Exportar" Margin="5" Click="ExportarDados_Click"/>
                        <Button Content="Importar" Margin="5" Click="ImportarDados_Click"/>
                        <Button Content="Reconectar" Margin="5" Click="Reconectar_Click"/>
                        <Button Content="Gerar Tabela" Margin="5" Click="GerarTabela_Click"/>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <!-- Segunda Aba: Visualização de Dados -->
            <TabItem Header="Visualizar Dados" FontSize="18">
                <DockPanel Margin="10">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Selecione a Tabela:" FontWeight="Bold" Margin="5" VerticalAlignment="Center" Grid.Column="0"
                                   Foreground="White"/>
                        <ComboBox x:Name="TabelaComboBox" Width="Auto" Margin="5" Grid.Column="1" SelectionChanged="TabelaComboBox_SelectionChanged">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    <Setter Property="VerticalContentAlignment" Value="{Binding Path=VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pesquisar:" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="White"/>
                        <TextBox Name="SearchBox" Grid.Column="1" 
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                        <Button Content="↺" ToolTip="Atualizar" Click="AtualizarDataGrid_Click" 
                                HorizontalAlignment="Center" VerticalAlignment="Top" 
                                Background="Transparent" Foreground="White" 
                                Padding="0" Margin="7, 0, 0, 0"
                                FontSize="33" Grid.Column="2"/>
                    </Grid>
                    <DataGrid x:Name="DadosDataGrid"
                              AutoGenerateColumns="True" IsReadOnly="True" 
                              SelectionMode="Single" SelectionUnit="FullRow"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="Auto"
                              AlternatingRowBackground="Gainsboro" AlternationCount="2"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" 
                              ColumnWidth="Auto">
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        
        <!-- Barra de Progresso -->
        <Grid Name="ShowProgressBar" Background="#80000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" Height="Auto" Width="600">
                <TextBlock Text="Processando Informações. Por favor, Aguarde" FontWeight="Bold" FontSize="20" Margin="0, 20, 0, 20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Name="ProgressBarMessage" Text="Aguardando próxima ação..." FontWeight="Bold" FontSize="16" Margin="0, 0, 0, 20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ProgressBar Name="ProgressBar" Height="20" Width="500" Margin="0, 0, 0, 30"
                     VerticalAlignment="Center" HorizontalAlignment="Center" 
                     Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
        </Grid>

        <!-- Popup para Configurações de Exportação -->
        <Popup Name="ExportConfigPopup" Placement="Center" StaysOpen="True">
            <Border Background="White" BorderBrush="Black" BorderThickness="1" Padding="15">
                <StackPanel>
                    <!-- Textos ajustáveis de acordo com função -->
                    <TextBlock Text="Configurações para Exportar" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>

                    <!-- Tabelas adicionadas de acordo com arquivo/função -->
                    <TextBlock Text="Selecione as Tabelas que deseja exportar:" FontWeight="Bold" FontSize="16"/>
                    <ListBox x:Name="ExportTabelasListBox" SelectionMode="Multiple" Height="100"/>

                    <Button Content="Confirmar exportação" Margin="5" Click="ConfirmarExportacao_Click"/>
                    <Button Content="Cancelar" Margin="5" Click="FecharExportPopup_Click" Style="{StaticResource CancelButtonStyle}"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Popup para Configurações de Importação -->
        <Popup Name="ImportConfigPopup" Placement="Center" StaysOpen="True">
            <Border Background="White" BorderBrush="Black" BorderThickness="1" Padding="15">
                <StackPanel>
                    <!-- Textos ajustáveis de acordo com função -->
                    <TextBlock Text="Configurações para Importar" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>

                    <!-- Tabelas adicionadas de acordo com arquivo/função -->
                    <TextBlock Text="Selecione as Tabelas que deseja importar:" FontWeight="Bold" FontSize="16"/>
                    <ListBox x:Name="ImportTabelasListBox" SelectionMode="Multiple" Height="100"/>

                    <!-- ComboBox com opções para importação-->
                    <TextBlock Text="Escolha um método de importação:" FontWeight="Bold" FontSize="16" Margin="0,10,0,0"/>
                    <ComboBox x:Name="ImportComboBox" Margin="0,0,0,10">
                        <ComboBoxItem Content="Substituir Dados"/>
                        <ComboBoxItem Content="Adicionar Dados"/>
                    </ComboBox>

                    <TextBlock Text="AVISO - as tabelas selecionadas serão substituídas se e somente se o nome da tabela for igual ao nome da tabela no arquivo de importação" FontWeight="Bold" FontSize="12" Foreground="Red" Margin="0,0,0,10"/>
                    <TextBlock Text="Esta ação é irreversível e pode causar perda de dados e não funcionamento do sistema. Tem certeza que deseja confirmar?" FontWeight="Bold" FontSize="16" Foreground="Red" Margin="0,0,0,10"/>
                    <Button Content="Confirmar importação" Margin="5" Click="ConfirmarImportacao_Click"/>
                    <Button Content="Cancelar" Margin="5" Click="FecharImportPopup_Click" Style="{StaticResource CancelButtonStyle}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
