<UserControl x:Class="WMS_RadiadoresLemos_WPF.BancoDadosUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TabControl>
            <!-- Primeira Aba: Ferramentas de Banco de Dados -->
            <TabItem Header="Ferramentas">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <GroupBox Header="Informações de Conexão" Grid.Row="0" Margin="10"
                              Foreground="White">
                        <StackPanel Margin="10">
                            <TextBlock Text="Servidor: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding ServerInfo}"/>
                            <TextBlock Text="Banco de Dados: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding DatabaseInfo}"/>
                            <TextBlock Text="Status da Conexão: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding ConnectionStatus}"/>
                        </StackPanel>
                    </GroupBox>
                    <UniformGrid Rows="1" Columns="4" Margin="0,5,0,10" Grid.Row="1">
                        <Button Content="Exportar Dados" Margin="5"/>
                        <Button Content="Importar Dados" Margin="5"/>
                        <Button Content="Backup dos Dados" Margin="5"/>
                        <Button Content="Fazer reconexão" Margin="5"/>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <!-- Segunda Aba: Visualização de Dados -->
            <TabItem Header="Visualizar Dados">
                <DockPanel Margin="10">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Selecione a Tabela:" FontWeight="Bold" Margin="5" VerticalAlignment="Center" Grid.Column="0"
                                   Foreground="White"/>
                        <ComboBox x:Name="TabelaComboBox" Width="Auto" Margin="5" Grid.Column="1" SelectionChanged="TabelaComboBox_SelectionChanged">
                            <ComboBoxItem Content="Produtos"/>
                            <ComboBoxItem Content="Usuários"/>
                        </ComboBox>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pesquisar:" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="White"/>
                        <TextBox Name="SearchBox" Grid.Column="1" 
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                        <Button Content="↺" ToolTip="Atualizar" Click="AtualizarDataGrid_Click" 
                                HorizontalAlignment="Center" VerticalAlignment="Top" 
                                Background="Transparent" Foreground="White" 
                                Padding="0" Margin="7, 0, 0, 0"
                                FontSize="33" Grid.Column="2"/>
                    </Grid>
                    <DataGrid x:Name="DadosDataGrid" AutoGenerateColumns="True" Margin="5" DockPanel.Dock="Bottom"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
