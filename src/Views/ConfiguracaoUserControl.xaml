<UserControl x:Class="WMS_RadiadoresLemos_WPF.src.Views.ConfiguracaoUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.src.Views"
             mc:Ignorable="d" 
             d:DesignHeight="630" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15, 15, 15, 0">
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Border Grid.Column="0" Grid.Row="1" CornerRadius="15" Background="{StaticResource SecondaryBrush}" Padding="5" Margin="0,0,0,0">
                <StackPanel Margin="20" MaxWidth="700">
                    
                    <!-- Opções sem outra tela -->
                    <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="15" Padding="15" Margin="5" Height="Auto">
                        <DockPanel LastChildFill="False" Background="{StaticResource PanelBackgroundBrush}">
                            <!-- Ícone de Sol -->
                            <Image x:Name="IconAlterarTema"  Source="/assets/Icons/Genericos/Sol Config.png" Stretch="Uniform" Height="30" Width="25" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Alterar Tema" Style="{StaticResource TextBoxCustom2ButtonStyle}" />
                            <ComboBox x:Name="ThemeSelector" Style="{StaticResource ComboBoxSelectStyle}" DockPanel.Dock="Right" Width="225">
                                <!-- Cabeçalho para Temas Claros -->
                                <ComboBoxItem IsEnabled="False">
                                    <TextBlock Text="--- TEMAS CLAROS ---" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </ComboBoxItem>
                                <ComboBoxItem x:Name="LightTheme" Content="Claro Padrão"/>
                                <ComboBoxItem x:Name="EmeraldTheme" Content="Verde Esmeralda"/>
                                <ComboBoxItem x:Name="SunsetTheme" Content="Pôr do Sol"/>
                                <ComboBoxItem x:Name="LavenderTheme" Content="Lavanda"/>
                                <ComboBoxItem x:Name="OceanTheme" Content="Oceano"/>
                                <ComboBoxItem x:Name="CottonCandyTheme" Content="Algodão Doce"/>
                                <ComboBoxItem x:Name="CoffeeTheme" Content="Café"/>
                                
                                <!-- Cabeçalho para Temas Escuros -->
                                <ComboBoxItem IsEnabled="False">
                                    <TextBlock Text="--- TEMAS ESCUROS ---" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </ComboBoxItem>
                                <ComboBoxItem x:Name="DarkTheme" Content="Escuro Padrão"/>
                                <ComboBoxItem x:Name="MidnightTheme" Content="Azul Noturno"/>
                                <ComboBoxItem x:Name="NightPurpleTheme" Content="Roxo Noturno"/>
                                <ComboBoxItem x:Name="DarkTealTheme" Content="Azul Petróleo"/>
                                <ComboBoxItem x:Name="CarbonTheme" Content="Carbono"/>
                                <ComboBoxItem x:Name="ForestTheme" Content="Floresta"/>
                                <ComboBoxItem x:Name="WineTheme" Content="Vinho"/>
                                <ComboBoxItem x:Name="NavyTheme" Content="Marinha"/>
                            </ComboBox>
                        </DockPanel>
                    </Border>
                    
                    <!-- Opções com outra tela -->
                    <Button x:Name="BtnUsuarios" Style="{StaticResource CustomButtonStyle}" Click="BtnUsuarios_Click" Height="65" MouseEnter="BtnUsuarios_MouseEnter" MouseLeave="BtnUsuarios_MouseLeave">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconUsuarios" Source="/assets/Icons/NotSelected/UsuárioNS.png" Stretch="Uniform" Height="30" Width="25" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TextUsuarios" Text="Gerenciar Usuários" Style="{StaticResource TextBoxCustomButtonStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnBancoDados" Style="{StaticResource CustomButtonStyle}" Click="BtnBancoDados_Click" Height="65" MouseEnter="BtnBancoDados_MouseEnter" MouseLeave="BtnBancoDados_MouseLeave">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconBancoDados" Source="/assets/Icons/NotSelected/DataCenterNS.png" Stretch="Uniform" Height="30" Width="25" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TextBancoDados" Text="Banco de Dados" Style="{StaticResource TextBoxCustomButtonStyle}"/>
                        </StackPanel>
                    </Button>

                    <!-- Botão Salvar e Aplicar -->
                    <Button x:Name="BtnSalvarAplicar" Style="{StaticResource EmphasisButtonStyle}" Width="250" Click="BtnSalvarAplicar_Click" Height="45" Margin="0,20,0,0">
                        <TextBlock Text="Salvar e Aplicar"/>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
        <ContentControl x:Name="ContentArea" Grid.Row="1" Grid.Column="1" Margin="10" Background="{StaticResource PanelBackgroundBrush}"/>
    </Grid>
</UserControl>
