<UserControl x:Class="WMS_RadiadoresLemos_WPF.src.Views.ConfiguracaoUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.src.Views"
             mc:Ignorable="d" 
             d:DesignHeight="630" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15, 15, 15, 0">
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="10" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Border Grid.Column="0" Grid.Row="1" CornerRadius="10" Background="{StaticResource SecondaryBrush}" Padding="5" Margin="0,0,0,0">
                <StackPanel Margin="20" MaxWidth="700">
                    
                    <!-- Opções sem outra tela -->
                    <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="15" Padding="15" Margin="5" Height="Auto">
                        <DockPanel LastChildFill="False" Background="{StaticResource PanelBackgroundBrush}">
                            <!-- Ícone de Sol -->
                            <TextBlock Text="Alterar Tema" Style="{StaticResource TextBoxCustom2ButtonStyle}" />
                            <ComboBox x:Name="ThemeSelector" Style="{StaticResource ComboBoxStyle}" DockPanel.Dock="Right" Width="225" SelectionChanged="ThemeSelector_SelectionChanged">
                                <ComboBoxItem x:Name="LightTheme" Content="Tema Claro"/>
                                <ComboBoxItem x:Name="DarkTheme" Content="Tema Escuro"/>
                                <ComboBoxItem x:Name="MidnightTheme" Content="Tema Azul"/>
                            </ComboBox>
                        </DockPanel>
                    </Border>
                    
                    <!-- Opções com outra tela -->
                    <Button x:Name="BtnUsuarios" Style="{StaticResource CustomButtonStyle}" Click="BtnUsuarios_Click"  Height="65">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="IconUsuarios" Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M12,3C12.55,3 13,3.45 13,4C13,4.55 12.55,5 12,5C11.45,5 11,4.55 11,4C11,3.45 11.45,3 12,3M7,7H17V5H19V19H5V5H7V7Z" Style="{StaticResource IconCustomButtonStyle}"/>
                            <TextBlock x:Name="TextUsuarios" Text="Gerenciar Usuários" Style="{StaticResource TextBoxCustomButtonStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnBancoDados" Style="{StaticResource CustomButtonStyle}" Click="BtnBancoDados_Click" Height="65">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="IconBancoDados" Data="M20,12H4V10H20V12M20,18H4V16H20V18M20,6H4V4H20V6Z" Style="{StaticResource IconCustomButtonStyle}" StrokeThickness="3"/>
                            <TextBlock x:Name="TextBancoDados" Text="Banco de Dados" Style="{StaticResource TextBoxCustomButtonStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
        <ContentControl x:Name="ContentArea" Grid.Row="1" Grid.Column="1" Margin="10" Background="{StaticResource PanelBackgroundBrush}"/>
    </Grid>
</UserControl>
