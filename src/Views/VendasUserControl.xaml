<UserControl x:Class="WMS_RadiadoresLemos_WPF.src.Views.VendasUserControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.src.Views" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">



    <Grid Margin="15,15,15,0">
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra de Pesquisa, Filtro e Ordenação -->
                <Grid Margin="0,0,0,20" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Barra de Pesquisa -->
                    <Border Grid.Column="1" Background="{StaticResource SecondaryBrush}" CornerRadius="15" Height="36" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                  Fill="{StaticResource TextBrush}" Width="23" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Fill" Margin="10,0,10,0"/>
                            <TextBox Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="5,0" Margin="0,0,10,0"/>
                        </Grid>
                    </Border>
                    <!-- Botão de Filtro -->
                    <Button Grid.Column="2" x:Name="FiltrarButton" Content="Filtrar por" ToolTip="Filtrar" Style="{StaticResource FilterButtonStyle}" Click="FiltrarButton_Click"/>
                    <!-- Botão de Registrar Venda -->
                    <Button Grid.Column="3" Content="Registrar Venda" FontSize="14" Style="{StaticResource EmphasisButtonStyle}" Click="RegistrarVendaButton_Click"/>
                </Grid>

                <!-- Conteúdo Principal: Itens de Venda -->
                <Border Grid.Row="1" CornerRadius="15" Background="{StaticResource SecondaryBrush}" Padding="5" Margin="0,0,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl x:Name="VendasContainer" Margin="0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="15" Padding="15" Margin="15" Width="250">
                                            <StackPanel>
                                                <TextBlock Text="{Binding NotaFiscal, StringFormat='NF: {0}', TargetNullValue='Venda'}" Style="{StaticResource VendasTitleTextBox}" FontSize="16" HorizontalAlignment="Center"/>
                                                <Separator Margin="10,5,10,10"/>
                                                <TextBlock Text="{Binding ClienteCNPJ, StringFormat='Cliente: {0}'}" Style="{StaticResource VendasTextBox}" FontSize="14" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Pedido, StringFormat='Pedido: {0}'}" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                                                <TextBlock Text="{Binding DataCompra, StringFormat='Data de Compra: {0:dd/MM/yyyy}'}" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                                                <TextBlock Text="{Binding ValorTotal, StringFormat={}{0:C2}, ConverterCulture='pt-BR'}" Style="{StaticResource VendasTextBox}" FontSize="14" FontWeight="Bold"/>
                                                <Button Content="Detalhes" Style="{StaticResource EmphasisButtonStyle}" FontSize="14" Width="120" Margin="0,10,0,5" Click="DetalhesButton_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Mensagem de vazio -->
                            <TextBlock x:Name="MensagemVazia" Text="Nenhuma venda cadastrada."
                                     FontSize="18" Foreground="{StaticResource TextBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Popup de Filtro -->
        <Popup x:Name="FiltroPopup" Placement="Bottom" StaysOpen="False" PlacementTarget="{Binding ElementName=FiltrarButton}">
            <Border Background="{StaticResource PanelBackgroundBrush}" Padding="15">
                <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15">
                    <StackPanel Background="Transparent" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Botão de Ordenar -->
                            <Button Grid.Column="0" x:Name="OrderButton" Content="Ordenar por" FontSize="14"
                            ToolTip="Escolha um critério de ordenação"
                            Click="OrdenarButton_Click"
                            Style="{StaticResource OrderButtonStyle}"
                            HorizontalAlignment="Left"/>

                            <!-- Combobox com direção da ordenação -->
                            <ComboBox Grid.Column="1" x:Name="OrdemComboBox" SelectedIndex="0" FontSize="14"
                              Style="{StaticResource ComboBoxSearchStyle}" HorizontalAlignment="Right" >
                                <ComboBoxItem Content="Crescente" Tag="asc"/>
                                <ComboBoxItem Content="Decrescente" Tag="desc"/>
                            </ComboBox>
                        </Grid>

                        <!-- Filtro por Cliente -->
                        <TextBlock Text="Filtrar por Cliente" FontWeight="Bold" Margin="10,5,0,5" Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="ClienteComboBox" 
                          Style="{StaticResource ComboBoxSearchStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"
                          HorizontalAlignment="Stretch"
                          Margin="10,0"
                          DisplayMemberPath="Nome" 
                          SelectedValuePath="Id"/>

                        <!-- Filtro por Produto -->
                        <TextBlock Text="Filtrar por Produto" FontWeight="Bold" Margin="10,10,0,5" Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="ProdutosVendidosComboBox" 
                          Style="{StaticResource ComboBoxSearchStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"
                          HorizontalAlignment="Stretch"
                          Margin="10,0"
                          DisplayMemberPath="Nome" 
                          SelectedValuePath="Id"/>

                        <!-- Filtro por Nota Fiscal -->
                        <TextBlock Text="Filtrar por Nota Fiscal" FontWeight="Bold" Margin="10,10,0,5" Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="NotaFiscalComboBox" 
                          Style="{StaticResource ComboBoxSearchStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"
                          HorizontalAlignment="Stretch"
                          Margin="10,0"
                          DisplayMemberPath="NotaFiscal" 
                          SelectedValuePath="Id"/>

                        <!-- Filtro por Tipo de Pagamento -->
                        <TextBlock Text="Filtrar por Tipo de Pagamento" FontWeight="Bold" Margin="10,10,0,5" Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="TipoPagamentoComboBox" 
                          Style="{StaticResource ComboBoxSearchStyle}" 
                          Background="{StaticResource PanelBackgroundBrush}"
                          HorizontalAlignment="Stretch"
                          Margin="10,0,10,10">
                            <ComboBoxItem Content="Todos" IsSelected="True"/>
                            <ComboBoxItem Content="À vista"/>
                            <ComboBoxItem Content="Parcelado"/>
                        </ComboBox>

                        <!-- Filtro por Período -->
                        <TextBlock Text="Filtrar por Período" FontWeight="Bold" Margin="10,0,0,5" Foreground="{StaticResource TextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="10,0,10,10">
                            <Border BorderBrush="{StaticResource PanelBackgroundBrush}" Margin="0,0,10,0" Width="140" BorderThickness="5" CornerRadius="15" Background="{StaticResource PanelBackgroundBrush}">
                                <DatePicker x:Name="DataInicioPicker" SelectedDate="{Binding FiltroDataInicio}" Style="{StaticResource DatePickerStyle}"/>
                            </Border>
                            <Border BorderBrush="{StaticResource PanelBackgroundBrush}" Margin="0,0,0,0" Width="140" BorderThickness="5" CornerRadius="15" Background="{StaticResource PanelBackgroundBrush}">
                                <DatePicker x:Name="DataFimPicker" SelectedDate="{Binding FiltroDataFim}" Style="{StaticResource DatePickerStyle}"/>
                            </Border>
                        </StackPanel>

                        <!-- Botões de Ação -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Aplicar Filtro" Click="AplicarFiltroButton_Click" 
                            Style="{StaticResource EmphasisButtonStyle}" 
                            Width="150" FontSize="14" />
                            <Button Content="Limpar" Click="LimparFiltroButton_Click" 
                            Style="{StaticResource EmphasisButtonStyle}" 
                            Background="{StaticResource HoverBackgroundBrush}"
                            Width="100" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>

        <!-- Popup de Ordenar -->
        <Popup x:Name="OrdenarPopup" Placement="Bottom" StaysOpen="False" PlacementTarget="{Binding ElementName=OrderButton}">
            <Border Background="{StaticResource PanelBackgroundBrush}" Padding="15">
                <Border Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15">
                    <StackPanel Background="Transparent" Margin="0">
                        <!-- Opções de Ordenação -->
                        <Button Content="Preço" Tag="preco" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                        <Button Content="Produto" Tag="produto" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                        <Button Content="Cliente" Tag="cliente" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                        <Button Content="Recente" Tag="recente" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                        <Button Content="Antigo" Tag="antigo" Click="OrdenacaoItem_Click" Style="{StaticResource FilterItemStyle}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
    </Grid>
</UserControl>