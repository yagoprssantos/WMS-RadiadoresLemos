<UserControl x:Class="WMS_RadiadoresLemos_WPF.src.Views.VendasUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.src.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <WrapPanel Margin="10">
            <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Padding="10" Margin="10" Width="300" Height="Auto">
                <StackPanel>
                    <TextBlock Text="Nota Fiscal" Style="{StaticResource VendasTitleTextBox}" />
                    <Separator Margin="15, 0, 15, 10" />
                    <TextBlock Text="Cliente: ID/Nome" Style="{StaticResource VendasTextBox}" />
                    <TextBlock Text="Pedido: X" Style="{StaticResource VendasTextBox}" />
                    <TextBlock Text="Data da Compra: XX/XX/XX" Style="{StaticResource VendasTextBox}" />
                    <TextBlock Text="Valor Total: R$ X.XXX,XX" Style="{StaticResource VendasTextBox}" />
                    <Button Content="Detalhes" Style="{StaticResource EmphasisButtonStyle}" Width="175" Margin="10" Click="DetalhesButton_Click"/>
                </StackPanel>
            </Border>
        </WrapPanel>
    </ScrollViewer>
</UserControl>
