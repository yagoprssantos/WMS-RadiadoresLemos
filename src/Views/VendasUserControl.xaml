<UserControl x:Class="WMS_RadiadoresLemos_WPF.src.Views.VendasUserControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.src.Views" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de Filtros/Botões -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox x:Name="cmbOrdenar" Style="{StaticResource ComboBoxStyle}" Width="200" Margin="0,0,15,0" SelectionChanged="CmbOrdenar_SelectionChanged">
                    <ComboBoxItem Content="Ordenar por" IsSelected="True" Tag="default"/>
                    <ComboBoxItem Content="Data (mais recente)" Tag="data_desc"/>
                    <ComboBoxItem Content="Data (mais antiga)" Tag="data_asc"/>
                    <ComboBoxItem Content="Valor (maior)" Tag="valor_desc"/>
                    <ComboBoxItem Content="Valor (menor)" Tag="valor_asc"/>
                    <ComboBoxItem Content="Cliente (A-Z)" Tag="cliente_asc"/>
                    <ComboBoxItem Content="Cliente (Z-A)" Tag="cliente_desc"/>
                </ComboBox>

                <Button Content="Nova Transação" Style="{StaticResource EmphasisButtonStyle}" Width="180" Height="45" Click="NovaTransacaoButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Conteúdo Principal -->
        <ScrollViewer Grid.Row="1">
            <WrapPanel x:Name="vendasContainer" Margin="10">
                <!-- Os itens de venda serão adicionados aqui dinamicamente -->
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>