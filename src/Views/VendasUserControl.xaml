<UserControl x:Class="WMS_RadiadoresLemos_WPF.src.Views.VendasUserControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS_RadiadoresLemos_WPF.src.Views" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de Filtros/Botões -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox Style="{StaticResource ComboBoxStyle}" Width="200" Margin="0,0,15,0">
                    <ComboBoxItem Content="Ordenar por" IsSelected="True"/>
                    <ComboBoxItem Content="Data (mais recente)"/>
                    <ComboBoxItem Content="Data (mais antiga)"/>
                    <ComboBoxItem Content="Valor (maior)"/>
                    <ComboBoxItem Content="Valor (menor)"/>
                    <ComboBoxItem Content="Cliente (A-Z)"/>
                    <ComboBoxItem Content="Cliente (Z-A)"/>
                    <ComboBoxItem Content="Pedido"/>
                </ComboBox>

                <Button Content="Nova Transação" Style="{StaticResource EmphasisButtonStyle}" Width="180" Height="45" Click="NovaTransacaoButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Conteúdo Principal -->
        <ScrollViewer Grid.Row="1">
            <WrapPanel Margin="10">
                <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="15" Padding="15" Margin="5" Width="240" Height="Auto">
                    <StackPanel>
                        <TextBlock Text="Nota Fiscal" Style="{StaticResource VendasTitleTextBox}" FontSize="16"/>
                        <Separator Margin="10, 2, 10, 5" />
                        <TextBlock Text="Cliente: ID/Nome" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                        <TextBlock Text="Pedido: X" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                        <TextBlock Text="Data da Compra: XX/XX/XX" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                        <TextBlock Text="Valor Total: R$ X.XXX,XX" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                        <Button Content="Detalhes" Style="{StaticResource EmphasisButtonStyle}" FontSize="16" Width="120" Margin="4"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="15" Padding="15" Margin="5" Width="240" Height="Auto">
                    <StackPanel>
                        <TextBlock Text="Nota Fiscal" Style="{StaticResource VendasTitleTextBox}" FontSize="16"/>
                        <Separator Margin="10, 2, 10, 5" />
                        <TextBlock Text="Cliente: ID/Nome" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                        <TextBlock Text="Pedido: X" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                        <TextBlock Text="Data da Compra: XX/XX/XX" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                        <TextBlock Text="Valor Total: R$ X.XXX,XX" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                        <Button Content="Detalhes" Style="{StaticResource EmphasisButtonStyle}" FontSize="16" Width="120" Margin="4"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="15" Padding="15" Margin="5" Width="240" Height="Auto">
                    <StackPanel>
                        <TextBlock Text="Nota Fiscal" Style="{StaticResource VendasTitleTextBox}" FontSize="16"/>
                        <Separator Margin="10, 2, 10, 5" />
                        <TextBlock Text="Cliente: ID/Nome" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                        <TextBlock Text="Pedido: X" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                        <TextBlock Text="Data da Compra: XX/XX/XX" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                        <TextBlock Text="Valor Total: R$ X.XXX,XX" Style="{StaticResource VendasTextBox}" FontSize="14"/>
                        <Button Content="Detalhes" Style="{StaticResource EmphasisButtonStyle}" FontSize="16" Width="120" Margin="4"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>