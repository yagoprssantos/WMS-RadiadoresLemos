<Window x:Class="WMS_RadiadoresLemos_WPF.src.Views.SenhaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2005"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Senha" Height="200" Width="300"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock x:Name="TituloTextBlock"
                   Text="Digite a senha:"
                   FontSize="16" 
                   FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Campo de Senha -->
        <PasswordBox x:Name="SenhaPasswordBox"
                     Grid.Row="1"
                     Style="{StaticResource {x:Type PasswordBox}}"
                     Background="{StaticResource PanelBackgroundBrush}"
                     Foreground="{StaticResource TextBrush}"
                     Margin="0,10"
                     Padding="5"
                     KeyDown="SenhaPasswordBox_KeyDown"/>

        <!-- Botões -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Content="Cancelar" 
                    Style="{StaticResource CancelButtonStyle}"
                    Width="100" 
                    Height="35" 
                    Margin="0,0,10,0"
                    Click="Cancelar_Click"/>
            <Button Content="Confirmar" 
                    Style="{StaticResource EmphasisButtonStyle}"
                    Width="100" 
                    Height="35"
                    Click="Confirmar_Click"/>
        </StackPanel>
    </Grid>
</Window> 