<Window x:Class="WMS_RadiadoresLemos_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controle de Estoque" 
        Height="700" Width="1000"
        MinHeight="700" MinWidth="1000"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" MaxWidth="300"/>
            <ColumnDefinition Width="194"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu Lateral -->
        <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" Grid.ColumnSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Perfil do Usuário -->
                <Grid Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}" Margin="20, 25, 15, 5" x:Name="Perfil">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="50" Height="50" Margin="0,0,10,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/src/Resources/Images/user.png" Stretch="Uniform"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NomeUsuarioTextBlock" Text="Usuário 1" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="CargoTextBlock" Text="ADMIN" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="MatriculaTextBlock" Text="Matrícula" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Itens do Menu -->
                <StackPanel Grid.Row="1" x:Name="MenuItemsPanel">
                    <Separator Margin="15"/>
                    <Button x:Name="BtnAdicionar" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="IconAdicionar" Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Style="{StaticResource MenuIconStyle}"/>
                            <TextBlock x:Name="TextAdicionar" Style="{StaticResource MenuItemTextStyle}"><Run Language="pt-br" Text="Adicionar"/></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnVendas" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="IconVendas" Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M12,3C12.55,3 13,3.45 13,4C13,4.55 12.55,5 12,5C11.45,5 11,4.55 11,4C11,3.45 11.45,3 12,3M7,7H17V5H19V19H5V5H7V7M7.5,13.5L9,12L11,14L15.5,9.5L17,11L11,17L7.5,13.5Z" Style="{StaticResource MenuIconStyle}"/>
                            <TextBlock x:Name="TextVendas" Style="{StaticResource MenuItemTextStyle}"><Run Language="pt-br" Text="Vendas"/></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRegistro" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="IconRegistro" Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M11,7V13L16,15.5L17,14.5L12,12V7H11Z" Style="{StaticResource MenuIconStyle}"/>
                            <TextBlock x:Name="TextRegistro" Style="{StaticResource MenuItemTextStyle}"><Run Language="pt-br" Text="Registro"/></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnEstoque" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="IconEstoque" Data="M3,3 L21,3 M21,3 L21,21 M21,21 L3,21 M3,21 L3,3 M5,5 L19,19 M19,5 L5,19" Style="{StaticResource MenuIconStyle}" Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                            <TextBlock x:Name="TextEstoque" Style="{StaticResource MenuItemTextStyle}"><Run Language="pt-br" Text="Estoque"/></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDashboard" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="IconDashboard" Data="M4,17V21H8V17H4M10,13V21H14V13H10M16,9V21H20V9H16" Style="{StaticResource MenuIconStyle}" StrokeThickness="1" Height="20" Stretch="Fill"/>
                            <TextBlock x:Name="TextDashboard" Style="{StaticResource MenuItemTextStyle}"><Run Language="pt-br" Text="Relatório"/></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnNotificacoes" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="IconNotificacoes" Data="M21,19V20H3V19L5,17V11C5,7.9 7.03,5.17 10,4.29C10,4.19 10,4.1 10,4A2,2 0 0,1 12,2A2,2 0 0,1 14,4C14,4.1 14,4.19 14,4.29C16.97,5.17 19,7.9 19,11V17L21,19M14,21A2,2 0 0,1 12,23A2,2 0 0,1 10,21" Style="{StaticResource MenuIconStyle}"/>
                            <TextBlock x:Name="TextNotificacoes" Text="Notificações" Style="{StaticResource MenuItemTextStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Rodapé do Menu -->
                <StackPanel Grid.Row="2" x:Name="MenuItemsFooterPanel">
                    <Separator Margin="15"/>
                    <Button x:Name="BtnConfiguracoes" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="IconConfiguracoes" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Style="{StaticResource MenuIconStyle}"/>
                            <TextBlock x:Name="TextConfiguracoes" Text="Configurações" Style="{StaticResource MenuItemTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSair" Style="{StaticResource MenuButtonStyle}" Click="LogoutButton_Click" Margin="0, 0, 0, 30">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="IconSair"  Data="M17,17L7,17V14L2,18L7,22V19H19V13H17M7,7H17V10L22,6L17,2V5H5V11H7V7Z" Style="{StaticResource MenuIconStyle}"/>
                            <TextBlock x:Name="TextSair" Text="Sair" Style="{StaticResource MenuItemTextStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="11*"/>
                <RowDefinition Height="32*"/>
            </Grid.RowDefinitions>

            <!-- Botões de Navegação -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,15,0,0">
                <Button Style="{StaticResource NavigationButtonStyle}" Margin="0, 0, 10, 0">
                    <Grid Width="50" Height="50">
                        <Ellipse Fill="Transparent"/>
                        <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Style="{StaticResource NavegationIconStyle}" HorizontalAlignment="Left" Margin="16,0,0,0" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource NavigationButtonStyle}" Margin="0, 0, 10, 0">
                    <Grid Width="50" Height="50">
                        <Ellipse Fill="Transparent"/>
                        <Path Data="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z" Style="{StaticResource NavegationIconStyle}" HorizontalAlignment="Left" Margin="16,0,0,0"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource NavigationButtonStyle}">
                    <Grid Width="50" Height="50">
                        <Ellipse Fill="Transparent"/>
                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Style="{StaticResource NavegationIconStyle}" HorizontalAlignment="Left" Margin="16,0,0,0"/>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Título e Ícone -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15,0,0">
                <Image x:Name="IconImage" Width="30" Height="30" Source="{Binding SelectedTabIcon}" Margin="0,0,10,0"/>
                <TextBlock x:Name="TitleTextBlock" Text="{Binding SelectedTabTitle}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>

            <!-- Área de Conteúdo -->
            <ContentControl x:Name="ContentArea" Margin="15,0,15,20" Grid.Row="1" Grid.RowSpan="2"/>
        </Grid>


        <!-- Tela de Loading -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Name="LoadingScreen" Background="#80000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Sincronizando com Banco de Dados..." Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Esta ação pode demorar alguns minutos" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <ProgressBar Width="500" Height="20" IsIndeterminate="True" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
