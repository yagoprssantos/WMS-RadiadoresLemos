<Window x:Class="WMS_RadiadoresLemos_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controle de Estoque" 
        Height="700" Width="1000"
        MinHeight="700" MinWidth="1000"
        WindowState="Maximized"
        Background="{StaticResource SecondaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200" MaxWidth="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Painel de Navegação -->
        <DockPanel Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}">
            <StackPanel Name="BarraLateral" Margin="10" DockPanel.Dock="Top">
                <!-- Botão para abrir a aba de Registro -->
                <Button Name="BtnRegistro" Content="Registro de Entrada/Saída" Click="RegistroEntradaSaida_Click" FontSize="16" Visibility="Visible">
                    <Button.ToolTip>
                        <ToolTip Content="Registrar entrada e saída de produtos"/>
                    </Button.ToolTip>
                </Button>
                <!-- Botão para abrir a aba de Estoque -->
                <Button Name="BtnEstoque" Content="Controle de Estoque" Click="ControleEstoque_Click" FontSize="16" Visibility="Visible">
                    <Button.ToolTip>
                        <ToolTip Content="Visualizar e gerenciar o estoque"/>
                    </Button.ToolTip>
                </Button>
                <!-- Botão para abrir o Dashboard -->
                <Button Name="BtnDashboard" Content="Dashboard" Click="Dashboard_Click" FontSize="16" Visibility="Visible">
                    <Button.ToolTip>
                        <ToolTip Content="Exibir o dashboard"/>
                    </Button.ToolTip>
                </Button>
                <!-- Botão para abrir a aba de Notificações -->
                <Button Name="BtnNotificacoes" Content="Notificações" Click="Notificacoes_Click" FontSize="16" Visibility="Visible">
                    <Button.ToolTip>
                        <ToolTip Content="Configurar notificações do sistema"/>
                    </Button.ToolTip>
                </Button>
                <!-- Botão para abrir a aba de Usuários -->
                <Button Name="BtnUsuarios" Content="Gerenciar Usuários" Click="Usuarios_Click" FontSize="16" Visibility="Visible">
                    <Button.ToolTip>
                        <ToolTip Content="Gerenciar usuários do sistema"/>
                    </Button.ToolTip>
                </Button>
                <!-- Botão para abrir a aba de Banco de Dados -->
                <Button Name="BtnBancoDados" Content="Banco de Dados" Click="BancoDados_Click" FontSize="16" Visibility="Visible">
                    <Button.ToolTip>
                        <ToolTip Content="Gerenciar o banco de dados"/>
                    </Button.ToolTip>
                </Button>
            </StackPanel>

            <!-- Perfil -->
            <Grid Margin="20, 0, 20, 50" Name="Perfil" VerticalAlignment="Bottom" DockPanel.Dock="Bottom" Background="{StaticResource BackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Name="NomeUsuarioTextBlock" Text="Nome do Usuário" FontSize="16" Foreground="{StaticResource ButtonForegroundBrush}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontWeight="Bold" Margin="15"/>
                <TextBlock Name="MatriculaTextBlock" Text="Matrícula" FontSize="12" Foreground="{StaticResource ButtonForegroundBrush}" Grid.Column="0" Grid.ColumnSpan="2" Margin="15,5,0,10" Grid.Row="1" />
                <Button Name="BtnLogout" Content="Logout" Click="LogoutButton_Click" FontSize="16" 
                        Width="100" Grid.Row="2" Grid.Column="2"
                        Style="{StaticResource CancelButtonStyle}">
                    <Button.ToolTip>
                        <ToolTip Content="Sair do sistema"/>
                    </Button.ToolTip>
                </Button>
            </Grid>
        </DockPanel>

        <!-- Área de Conteúdo -->
        <ContentControl Grid.Column="1" Name="ContentArea" Margin="10, 10, 10, 40"/>

        <!-- Tela de Loading -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Name="LoadingScreen" Background="#80000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Sincronizando com Banco de Dados..." Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Esta ação pode demorar alguns minutos" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <ProgressBar Width="500" Height="20" IsIndeterminate="True" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Barra de Status -->
        <StatusBar Name="StatusBar" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Background="{StaticResource PrimaryBrush}" FontSize="16">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Informações de Status -->
            <StatusBarItem Name="StatusBarItem" Foreground="{StaticResource ButtonForegroundBrush}" HorizontalAlignment="Left" Grid.Column="0" Margin="15, 0, 0, 0"/>

            <!-- Ícone de Notificação -->
            <StatusBarItem Grid.Column="2" Margin="0, 0, 20, 0">
                <Button Name="NotificationButton" 
                 Content="🔔" 
                 Click="NotificationButton_Click" 
                 MouseEnter="NotificationButton_MouseEnter"
                 Visibility="Visible"
                 Padding="0" Margin="0" FontSize="16"
                 Foreground="White" Background="Transparent"
                 HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button.ToolTip>
                        <ToolTip Name="NotificationToolTip" />
                    </Button.ToolTip>
                </Button>
            </StatusBarItem>

            <!-- Ícone de Conexão -->
            <StatusBarItem Grid.Column="3" Margin="0, 0, 20, 0">
                <Button Name="ConnectionButton" 
                 Click="ConnectionButton_Click"
                 MouseEnter="ConnectionButton_MouseEnter"
                 Visibility="Visible"
                 Padding="0" Margin="0" FontSize="16"
                 Foreground="White" Background="Transparent"
                 HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Name="ConnectionIcon" Text="📶"/>
                            <TextBlock Name="ConnectionStatus" Text="Conectado" Margin="5,0,0,0" />
                        </StackPanel>
                    </Button.Content>
                    <Button.ToolTip>
                        <ToolTip Name="ConnectionToolTip" />
                    </Button.ToolTip>
                </Button>
            </StatusBarItem>

            <!-- Data e Hora -->
            <StatusBarItem Name="StatusBarDateTime" Foreground="{StaticResource ButtonForegroundBrush}" HorizontalAlignment="Right" Grid.Column="4"/>
        </StatusBar>

    </Grid>
</Window>
