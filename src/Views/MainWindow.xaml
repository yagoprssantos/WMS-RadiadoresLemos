<Window x:Class="WMS_RadiadoresLemos_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controle de Estoque" 
        Height="700" Width="1000"
        MinHeight="700" MinWidth="1000"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" MaxWidth="300"/>
            <ColumnDefinition Width="194"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu Lateral -->
        <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" Grid.ColumnSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Perfil do Usuário -->
                <Grid Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}" Margin="20, 25, 15, 5" x:Name="Perfil">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="50" Height="50" Margin="0,0,10,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/src/Resources/Images/user.png" Stretch="Uniform"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NomeUsuarioTextBlock" Text="Usuário 1" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="CargoTextBlock" Text="ADMIN" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="MatriculaTextBlock" Text="Matricula" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Itens do Menu -->
                <StackPanel Grid.Row="1" x:Name="MenuItemsPanel">
                    <Separator Margin="15"/>
                    <Button x:Name="BtnCompras" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconCompras" Source="/assets/Icons/NotSelected/ComprarNS.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TextCompras" Style="{StaticResource MenuItemTextStyle}"><Run Language="pt-br" Text="Compras"/></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnVendas" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconVendas" Source="/assets/Icons/NotSelected/PranchetaNS.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TextVendas" Style="{StaticResource MenuItemTextStyle}"><Run Language="pt-br" Text="Vendas"/></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRegistro" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconRegistro" Source="/assets/Icons/NotSelected/HistoricoNS.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TextRegistro" Style="{StaticResource MenuItemTextStyle}"><Run Language="pt-br" Text="Registro"/></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnEstoque" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconEstoque" Source="/assets/Icons/NotSelected/CaixaNS.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TextEstoque" Style="{StaticResource MenuItemTextStyle}"><Run Language="pt-br" Text="Estoque"/></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCadastro" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconCadastro" Source="/assets/Icons/NotSelected/CadastroNS.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TextCadastro" Style="{StaticResource MenuItemTextStyle}"><Run Language="pt-br" Text="Cadastrar"/></TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- Adicionar após o BtnCadastro -->
                    <!-- Substitua o botão de boletos por este: -->
                    <Button x:Name="BtnBoletos" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <!-- Usa ícone de cadastro temporariamente -->
                            <Image x:Name="IconBoletos" Source="/assets/Icons/NotSelected/CadastroNS.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TextBoletos" Style="{StaticResource MenuItemTextStyle}"><Run Language="pt-br" Text="Boletos (Teste)"/></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDashboard" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconDashboard" Source="/assets/Icons/NotSelected/GraficoNS.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TextDashboard" Style="{StaticResource MenuItemTextStyle}"><Run Language="pt-br" Text="Relatório"/></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnNotificacoes" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" ToolTip="Clique para ver as notificações">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconNotificacoes" Source="/assets/Icons/NotSelected/SinoNS.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TextNotificacoes" Text="Notificações" Style="{StaticResource MenuItemTextStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Rodapé do Menu -->
                <StackPanel Grid.Row="2" x:Name="MenuItemsFooterPanel">
                    <Separator Margin="15"/>
                    <Button x:Name="BtnConfiguracoes" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconConfiguracoes" Source="/assets/Icons/NotSelected/EngrenagemNS.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TextConfiguracoes" Text="Configurações" Style="{StaticResource MenuItemTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSair" Style="{StaticResource MenuButtonStyle}" Click="LogoutButton_Click" Margin="0, 0, 0, 30">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconSair" Source="/assets/Icons/NotSelected/SairNS.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TextSair" Text="Sair" Style="{StaticResource MenuItemTextStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="11*"/>
                <RowDefinition Height="32*"/>
            </Grid.RowDefinitions>

            <!-- Botões de Navegação -->
            <!-- Substitua o bloco de botões de navegação no MainWindow.xaml -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,15,0,0">
                <Button x:Name="PreviousButton" Style="{StaticResource NavigationButtonStyle}" Margin="0, 0, 10, 0" Click="PreviousButton_Click" ToolTip="Voltar">
                    <Grid Width="50" Height="50">
                        <Ellipse Fill="Transparent"/>
                        <Image Source="/assets/icons/Genericos/Seta.png" Width="30" Height="30" Margin="40,10,-20,10" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource NavigationButtonStyle}" Margin="0, 0, 10, 0" Click="NextButton_Click" ToolTip="Avançar">
                    <Grid Width="50" Height="50">
                        <Ellipse Fill="Transparent"/>
                        <Image Source="/assets/icons/Genericos/Seta.png" Width="30" Height="30" Margin="10,10,10,10" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Button>
                <Button x:Name="RefreshButton" Style="{StaticResource NavigationButtonStyle}" Click="RefreshButton_Click" ToolTip="Recarregar tela atual">
                    <Grid Width="50" Height="50">
                        <Ellipse Fill="Transparent"/>
                        <Image Source="/assets/icons/Genericos/Recarregar.png" Width="30" Height="30" Margin="10,10,10,10" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Título e Ícone -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15,0,0">
                <Image x:Name="IconImage" Width="30" Height="30" Margin="0,0,10,0"/>
                <TextBlock x:Name="TitleTextBlock" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>

            <!-- Área de Conteúdo -->
            <ContentControl x:Name="ContentArea" Margin="15,0,15,20" Grid.Row="1" Grid.RowSpan="2"/>
        </Grid>


        <!-- Tela de Loading -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Name="LoadingScreen" Background="#80000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Sincronizando com Banco de Dados..." Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Esta ação pode demorar alguns minutos" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <ProgressBar Width="500" Height="20" IsIndeterminate="True" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
