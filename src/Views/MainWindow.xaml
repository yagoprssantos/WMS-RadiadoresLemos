<Window x:Class="WMS_RadiadoresLemos_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controle de Estoque" 
        Height="700" Width="1000"
        MinHeight="700" MinWidth="1000"
        WindowState="Maximized"
        Background="{StaticResource SecondaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200" MaxWidth="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Painel de Navegação -->
        <DockPanel Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}">
            <StackPanel Name="BarraLateral" Margin="10" DockPanel.Dock="Top">
                <!-- Botão para abrir a aba de Registro -->
                <Button Content="Registro Entrada/Saida" Click="RegistroEntradaSaida_Click" FontSize="16">
                    <Button.ToolTip>
                        <ToolTip Content="Registrar entrada e saída de produtos"/>
                    </Button.ToolTip>
                </Button>
                <!-- Botão para abrir a aba de Estoque -->
                <Button Content="Controle de Estoque" Click="ControleEstoque_Click" FontSize="16">
                    <Button.ToolTip>
                        <ToolTip Content="Registrar entrada e saída de produtos"/>
                    </Button.ToolTip>
                </Button>
                <!-- Botão para abrir o Dashboard -->
                <Button Content="Dashboard" Click="Dashboard_Click" FontSize="16">
                    <Button.ToolTip>
                        <ToolTip Content="Exibir o dashboard"/>
                    </Button.ToolTip>
                </Button>
                <!-- Botão para abrir a aba de Banco de Dados -->
                <Button Content="Banco de Dados" Click="BancoDados_Click" FontSize="16">
                    <Button.ToolTip>
                        <ToolTip Content="Gerenciar o banco de dados"/>
                    </Button.ToolTip>
                </Button>
                <!-- Botão para abrir a aba de Usuários -->
                <Button Content="Usuários" Click="Usuarios_Click" FontSize="16">
                    <Button.ToolTip>
                        <ToolTip Content="Gerenciar usuários do sistema"/>
                    </Button.ToolTip>
                </Button>
                <!-- Botão para abrir a aba de Notificações -->
                <Button Content="Notificações" Click="Notificacoes_Click" FontSize="16">
                    <Button.ToolTip>
                        <ToolTip Content="Configurar notificações do sistema"/>
                    </Button.ToolTip>
                </Button>
            </StackPanel>


            <!-- Perfil -->
            <Grid Margin="20, 0, 20, 50" Name="Perfil" VerticalAlignment="Bottom" DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Nome do Usuário" FontSize="16" Foreground="{StaticResource ButtonForegroundBrush}" Grid.Row="0" Grid.Column="0" />
                <TextBlock Text="Matrícula" FontSize="12" Foreground="{StaticResource ButtonForegroundBrush}" Grid.Row="1" Grid.Column="0" />
                <Button Content="Logout" Click="LogoutButton_Click" FontSize="16" 
                        Margin="0, 10, 0, 0" Width="100" Grid.Row="2" Grid.Column="1"
                        Style="{StaticResource CancelButtonStyle}">
                    <Button.ToolTip>
                        <ToolTip Content="Sair do sistema"/>
                    </Button.ToolTip>
                </Button>
            </Grid>
        </DockPanel>

        <!-- Área de Conteúdo -->
        <ContentControl Grid.Column="1" Name="ContentArea" Margin="10, 10, 10, 40"/>

        <!-- Barra de Status -->
        <StatusBar Name="StatusBar" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Background="{StaticResource PrimaryBrush}" FontSize="16">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Informações de Status -->
            <StatusBarItem Name="StatusBarItem" Foreground="{StaticResource ButtonForegroundBrush}" HorizontalAlignment="Left" Grid.Column="0" Margin="15, 0, 0, 0"/>

            <!-- Botão para reconectar no centro da status bar -->
            <StatusBarItem Grid.Column="1">
                <Button Name="VerifyConnectionButton" 
                        Content="⭯"
                        Click="VerifyConnectionButton_Click" 
                        Visibility="Collapsed"
                        Padding="0" Margin="0" FontSize="16"
                        Foreground="White" Background="Transparent"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                </Button>
            </StatusBarItem>

            <!-- Ícone de Notificação -->
            <StatusBarItem Grid.Column="2" Margin="0, 0, 20, 0">
                <Button Name="NotificationButton" 
                        Content="🔔" 
                        Click="NotificationButton_Click" 
                        MouseEnter="NotificationButton_MouseEnter"
                        Visibility="Visible"
                        Padding="0" Margin="0" FontSize="16"
                        Foreground="White" Background="Transparent"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button.ToolTip>
                        <ToolTip Name="NotificationToolTip" />
                    </Button.ToolTip>
                </Button>
            </StatusBarItem>

            <!-- Data e Hora -->
            <StatusBarItem Name="StatusBarDateTime" Foreground="{StaticResource ButtonForegroundBrush}" HorizontalAlignment="Right" Grid.Column="3"/>
        </StatusBar>
    </Grid>
</Window>
