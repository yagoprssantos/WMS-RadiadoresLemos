<Window x:Class="WMS_RadiadoresLemos_WPF.ExcelWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Gerenciar Dados do Excel" Height="600" Width="800" SizeToContent="WidthAndHeight">
  <Grid Margin="15" Background="{StaticResource SecondaryBrush}">
      <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Título -->
      <TextBlock Text="Gerenciar Dados do Excel" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center" Grid.Row="0"/>

      <!-- Área principal -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="Importar Dados do Excel" Margin="5" Click="ImportarDados_Click" Style="{StaticResource EmphasisButtonStyle}" FontSize="14"/>
            <Button Content="Exportar Dados para Excel" Margin="5" Click="ExportarDados_Click" Style="{StaticResource EmphasisButtonStyle}" FontSize="14"/>
            <Button Content="Gerar Tabela Padrão" Margin="5" Click="GerarTabela_Click" Style="{StaticResource EmphasisButtonStyle}" FontSize="14"/>
       </StackPanel>

      <!-- Barra de progresso -->
      <StackPanel Grid.Row="2" Margin="10">
          <TextBlock Name="StatusMessage" Text="Status: Aguardando ação..." FontSize="14" Margin="0,5,0,5" HorizontalAlignment="Center"/>
          <ProgressBar Name="ProgressBar" Height="20" Minimum="0" Maximum="100" Value="0" Margin="0,5,0,0"/>
      </StackPanel>

        <!-- DataGrid para pré-visualização -->
        <StackPanel Grid.Row="3" Visibility="Collapsed" Margin="10">
            <TextBlock Text="Pré-visualização dos Dados Importados:" FontSize="16" FontWeight="Bold" Margin="10,20,10,5" HorizontalAlignment="Left"/>
            <DataGrid Name="PreviewDataGrid" AutoGenerateColumns="True" Margin="10" Background="White" Foreground="Black" IsReadOnly="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
            <Button Content="Confirmar Importação" Margin="10" HorizontalAlignment="Right" Click="ConfirmarImportacao_Click" Style="{StaticResource EmphasisButtonStyle}" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
