<Window x:Class="WMS_RadiadoresLemos_WPF.ExcelWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Gerenciar Dados do Excel"
      Height="630"
      Width="820"
      SizeToContent="WidthAndHeight"
      WindowStartupLocation="CenterScreen"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15">
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Gerenciar Dados do Excel"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                </Grid>

                <!-- Botões de Ação -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Button Content="Importar Dados do Excel"
                            Style="{StaticResource EmphasisButtonStyle}"
                            FontSize="14"
                            Click="ImportarDados_Click"/>
                    <Button Content="Exportar Dados para Excel"
                            Style="{StaticResource EmphasisButtonStyle}"
                            FontSize="14"
                            Click="ExportarDados_Click"/>
                    <Button Content="Gerar Tabela Padrão"
                            Style="{StaticResource EmphasisButtonStyle}"
                            FontSize="14"
                            Click="GerarTabela_Click"/>
                </StackPanel>

                <!-- Barra de Progresso -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Padding="10">
                        <StackPanel>
                            <TextBlock Name="StatusMessage"
                                       Text="Status: Aguardando ação..."
                                       FontSize="14"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,5"/>
                            <ProgressBar Name="ProgressBar"
                                         Height="20"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Margin="0,5,0,0"
                                         Background="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- DataGrid para Pré-visualização -->
                <StackPanel Grid.Row="3" Margin="0,0,0,20" Visibility="Collapsed" Name="PreviewPanel">
                    <TextBlock Text="Pré-visualização dos Dados Importados:"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,10"
                               HorizontalAlignment="Left"/>
                    <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Padding="10">
                        <DataGrid Name="PreviewDataGrid"
                                  AutoGenerateColumns="True"
                                  Background="{StaticResource SecondaryBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  Style="{StaticResource CustomDataGridStyle}"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Stretch"/>
                    </Border>
                    <Button Content="Confirmar Importação"
                            Style="{StaticResource EmphasisButtonStyle}"
                            FontSize="14"
                            HorizontalAlignment="Right"
                            Margin="10"
                            Click="ConfirmarImportacao_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
