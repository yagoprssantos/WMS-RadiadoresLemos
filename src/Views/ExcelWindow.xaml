<Window x:Class="WMS_RadiadoresLemos_WPF.ExcelWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Gerenciar Dados do Excel"
      Height="630"
      Width="820"
      WindowStartupLocation="CenterScreen"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15">
        <Border BorderBrush="{StaticResource PanelBackgroundBrush}" BorderThickness="1" CornerRadius="15" Padding="25" Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Gerenciar Dados do Excel"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                </Grid>

                <!-- Botões de Ação -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Button Content="Importar Dados do Excel"
                            Style="{StaticResource EmphasisButtonStyle}"
                            FontSize="14"
                            Click="ImportarDados_Click"/>
                    <Button Content="Exportar Dados para Excel"
                            Style="{StaticResource EmphasisButtonStyle}"
                            FontSize="14"
                            Click="ExportarDados_Click"/>
                    <Button Content="Gerar Tabela Padrão"
                            Style="{StaticResource EmphasisButtonStyle}"
                            FontSize="14"
                            Click="GerarTabela_Click"/>
                </StackPanel>

                <!-- Barra de Progresso -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Padding="10">
                        <StackPanel>
                            <TextBlock Name="StatusMessage"
                                       Text="Status: Aguardando ação..."
                                       FontSize="14"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,5"/>
                            <ProgressBar Name="ProgressBar"
                                         Height="20"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Margin="0,5,0,0"
                                         Background="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Pré-visualização de Dados -->
                <Grid Grid.Row="3" Margin="0,0,0,20" Visibility="Collapsed" Name="PreviewPanel" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- ComboBox para selecionar o modo de importação -->
                    <ComboBox Name="ImportModeComboBox" Grid.Row="0"
                              Style="{StaticResource ComboBoxStyle}"
                              Margin="0,0,0,15"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Adicionar Dados" />
                        <ComboBoxItem Content="Substituir Dados" />
                    </ComboBox>

                    <!-- Barra de Pesquisa, Filtro e Seleção de Tabela -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" Background="{StaticResource SecondaryBrush}" CornerRadius="18" Height="36" Margin="0,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                      Fill="{StaticResource TextBrush}" Width="23" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Fill" Margin="10,0,10,0"/>
                                <TextBox Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="5,0" Margin="0,0,10,0" TextChanged="SearchBox_TextChanged"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="2" x:Name="FiltrarButton" Content="Filtrar por" ToolTip="Filtrar" Style="{StaticResource FilterButtonStyle}" Click="FiltrarButton_Click"/>
                        <ComboBox Grid.Column="3" x:Name="TabelaComboBox" ToolTip="Selecionar Tabela" Style="{StaticResource ComboBoxStyle}" Margin="5,0,0,0" SelectionChanged="TabelaComboBox_SelectionChanged">
                        </ComboBox>
                    </Grid>

                    <!-- DataGrid para exibir os dados -->
                    <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Padding="10">
                        <DataGrid Name="PreviewDataGrid"
                                  AutoGenerateColumns="True"
                                  Background="{StaticResource SecondaryBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  Style="{StaticResource CustomDataGridStyle}"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Stretch"/>
                    </Border>
                    
                    <!-- Botões de ação -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Confirmar Importação" Click="ConfirmarImportacao_Click" Width="120" Height="40" Margin="10" Style="{StaticResource EmphasisButtonStyle}"/>
                        <Button Content="Cancelar" Click="Cancelar_Click" Width="120" Height="40" Margin="10" Style="{StaticResource CancelButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
