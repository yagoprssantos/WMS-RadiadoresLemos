<UserControl x:Class="WMS_RadiadoresLemos_WPF.ControleEstoqueUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TabControl>
            <!-- Aba de Cadastrar Produtos -->
            <TabItem Header="Cadastrar Produtos">

                <Grid Margin="10">
                    <TextBlock Text="Cadastrar Novo Produto" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Margin="0, 30, 0, 0">
                        <TextBox Name="NomeProduto" Text="Nome do Produto" Margin="0,0,0,10" 
                                 GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        <TextBox Name="TipoProduto" Text="Tipo do Produto" Margin="0,0,0,10" 
                                 GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        <TextBox Name="MarcaProduto" Text="Marca do Produto" Margin="0,0,0,10" 
                                 GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        <Button Content="Cadastrar Produto" Click="CadastrarProduto_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Aba de Gerenciar Produtos -->
            <TabItem Header="Gerenciar Produtos">
                <Grid Margin="10">
                    <TextBlock Text="Gerenciar Produtos" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel>
                        <ComboBox Name="SelecionarProduto" Margin="0,0,0,10">
                            <!-- Adicionar itens do banco de dados aqui -->
                        </ComboBox>
                        <ComboBox Name="SelecionarTipo" Margin="0,0,0,10">
                            <!-- Adicionar tipos do banco de dados aqui -->
                        </ComboBox>
                        <ComboBox Name="SelecionarMarca" Margin="0,0,0,10">
                            <!-- Adicionar marcas do banco de dados aqui -->
                        </ComboBox>
                        <TextBox Name="QuantidadeProduto" Text="Quantidade" Margin="0,0,0,10" 
                                 GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        <Button Content="Adicionar Quantidade" Click="AdicionarQuantidade_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Aba de Controle de Estoque -->
            <TabItem Header="Controle de Estoque">
                <Grid Margin="10">
                    <TextBlock Text="Controle de Estoque" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <!-- Adicionar controles específicos aqui -->
                </Grid>
            </TabItem>

            <!-- Aba de Visualizar Estoque -->
            <TabItem Header="Visualizar Estoque">
                <Grid Margin="10">
                    <TextBlock Text="Visualizar Estoque Atual" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid Name="EstoqueDataGrid" AutoGenerateColumns="True"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
