<UserControl x:Class="WMS_RadiadoresLemos_WPF.ControleEstoqueUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800"
             TextBlock.Foreground="White">

    <Grid >
        <TabControl>
            <!-- Aba de Cadastrar Produtos -->
            <TabItem Header="Cadastrar Produtos" Name="AbaCadastro" FontSize="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Width="500">
                            <TextBlock Text="Nome do Produto:" Margin="0,0,0,5"
                                       Foreground="White"/>
                            <TextBox Name="NomeProduto" Margin="0,0,0,15"/>

                            <TextBlock Text="Tipo do Produto:" Margin="0,0,0,5"
                                       Foreground="White"/>
                            <!-- ComboBox com texto escura -->
                            <ComboBox Name="TipoProduto" Margin="0,0,0,15">
                                <!-- Tipos de Produtos -->
                                <ComboBoxItem Content="Caixa"/>
                                <ComboBoxItem Content="Radiador"/>
                            </ComboBox>

                            <TextBlock Text="Marca do Produto:" Margin="0,0,0,5"
                                       Foreground="White"/>
                            <TextBox Name="MarcaProduto" Margin="0,0,0,15" PreviewTextInput="MarcaProduto_PreviewTextInput" DataObject.Pasting="MarcaProduto_Pasting"/>

                            <TextBlock Text="Código do Produto:" Margin="0,0,0,5"
                                       Foreground="White"/>
                            <TextBox Name="CodigoProduto" Margin="0,0,0,15"/>

                            <TextBlock Text="Quantidade Inicial:" Margin="0,0,0,5"
                                       Foreground="White"/>
                            <TextBox Name="QuantidadeInicial" Margin="0,0,0,15" PreviewTextInput="QuantidadeInicial_PreviewTextInput" DataObject.Pasting="QuantidadeInicial_Pasting"/>

                            <Button Content="Cadastrar Produto" Click="CadastrarProduto_Click" HorizontalAlignment="Center" Width="200" Margin="20"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Aba de Controle de Estoque -->
            <TabItem Header="Controle de Estoque" Name="AbaEstoque" FontSize="18">
                <DockPanel Margin="10">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" DockPanel.Dock="Bottom">
                        <!-- Botão discreto para atualizar a DataGrid -->
                        <Button Content="Editar Produto" Click="EditarProduto_Click" Width="150" Margin="10"/>
                        <Button Content="Alterar Quantidade" Click="AlterarQuantidade_Click" Width="200" Margin="10"/>
                        <Button Content="Deletar Produto" Click="DeletarProduto_Click" Width="150" Margin="10" Style="{StaticResource CancelButtonStyle}"/>
                    </StackPanel>


                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pesquisar:" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="White"/>
                        <TextBox Name="SearchBox" Grid.Column="1" 
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                        <Button Content="↺" ToolTip="Atualizar" Click="AtualizarDataGrid_Click" 
                                HorizontalAlignment="Center" VerticalAlignment="Top" 
                                Background="Transparent" Foreground="White" 
                                Padding="0" Margin="7, 0, 0, 0"
                                FontSize="33" Grid.Column="2"/>
                    </Grid>

                    <DataGrid Name="EstoqueDataGrid"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Margin="0,0,0,10"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Width="Auto" Height="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" IsReadOnly="False" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
