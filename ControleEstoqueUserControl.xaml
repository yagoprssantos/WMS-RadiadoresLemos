<UserControl x:Class="WMS_RadiadoresLemos_WPF.ControleEstoqueUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid>
        <TabControl>
            <!-- Aba de Cadastrar Produtos -->
            <TabItem Header="Cadastrar Produtos" FontSize="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Width="500">
                            <TextBlock Text="Nome do Produto:" Margin="0,0,0,5"/>
                            <TextBox Name="NomeProduto" Margin="0,0,0,15"/>

                            <TextBlock Text="Tipo do Produto:" Margin="0,0,0,5"/>
                            <TextBox Name="TipoProduto" Margin="0,0,0,15"/>

                            <TextBlock Text="Marca do Produto:" Margin="0,0,0,5"/>
                            <TextBox Name="MarcaProduto" Margin="0,0,0,15"/>

                            <TextBlock Text="Código do Produto:" Margin="0,0,0,5"/>
                            <TextBox Name="CodigoProduto" Margin="0,0,0,15"/>

                            <TextBlock Text="Quantidade Inicial:" Margin="0,0,0,5"/>
                            <TextBox Name="QuantidadeInicial" Margin="0,0,0,15"/>

                            <Button Content="Cadastrar Produto" Click="CadastrarProduto_Click" HorizontalAlignment="Center" Width="200" Margin="20"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Aba de Controle de Estoque -->
            <TabItem Header="Controle de Estoque" FontSize="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Width="Auto" Margin="0,10,0,0">

                            <DataGrid Name="EstoqueDataGrid" AutoGenerateColumns="True" Margin="0,0,0,10" Height="Auto" Width="Auto"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="Editar Produto" Click="EditarProduto_Click" Width="150" Margin="10"/>
                                <Button Content="Alterar Quantidade" Click="AlterarQuantidade_Click" Width="200" Margin="10"/>
                                <Button Content="Deletar Produto" Click="DeletarProduto_Click" Width="150" Margin="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
