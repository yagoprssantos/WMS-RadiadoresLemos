<Window x:Class="WMS_RadiadoresLemos_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controle de Estoque" 
        Height="700" Width="1000"
        MinHeight="700" MinWidth="1000"
        WindowState="Maximized"
        Background="{StaticResource SecondaryBrush}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200" MaxWidth="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Painel de Navegação -->
        <DockPanel Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}">
            <StackPanel Margin="10">
                <Button Content="Controle de Estoque" Click="ControleEstoque_Click" FontSize="16">
                    <Button.ToolTip>
                        <ToolTip Content="Registrar entrada e saída de produtos"/>
                    </Button.ToolTip>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Área de Conteúdo -->
        <ContentControl Grid.Column="1" Name="ContentArea" Margin="10, 10, 10, 40"/>

        <!-- Barra de Status -->
        <StatusBar Name="StatusBar" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Background="{StaticResource PrimaryBrush}" FontSize="16">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Informações de Status -->
            <StatusBarItem Name="StatusBarItem" Foreground="{StaticResource ButtonForegroundBrush}" HorizontalAlignment="Left" Grid.Column="0" Margin="5, 0, 0, 0"/>

            <!-- Botão para reconectar no centro da status bar -->
            <StatusBarItem Grid.Column="1">
                <Button Name="VerifyConnectionButton" 
                        Content="Reconectar"
                        Click="VerifyConnectionButton_Click" 
                        Visibility="Collapsed"
                        Width="200" Height="Auto" Margin="1, 0, 0, 0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                </Button>
            </StatusBarItem>

            <!-- Data e Hora -->
            <StatusBarItem Name="StatusBarDateTime" Foreground="{StaticResource ButtonForegroundBrush}" HorizontalAlignment="Right" Grid.Column="2"/>
        </StatusBar>
    </Grid>
</Window>
