<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WMS_RadiadoresLemos_WPF</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<ApplicationIcon>src/Resources/icon-WMS-radiadoreslemos.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Wallet\**" />
    <EmbeddedResource Remove="Wallet\**" />
    <None Remove="Wallet\**" />
    <Page Remove="Wallet\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="src\resources\icons\CaixaS.png" />
    <None Remove="src\resources\icons\EngrenagemS.png" />
    <None Remove="src\resources\icons\GraficoS.png" />
    <None Remove="src\resources\icons\historicos.png" />
    <None Remove="src\resources\icons\PlusS.png" />
    <None Remove="src\resources\icons\PranchetaS.png" />
    <None Remove="src\resources\icons\SairS.png" />
    <None Remove="src\resources\icons\SinoS.png" />
    <None Remove="src\Resources\Images\user.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="src\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="Google.Cloud.Firestore" Version="3.9.0" />
    <PackageReference Include="LiveCharts.Wpf" Version="0.9.7" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="assets\" />
    <Folder Include="src\Resources\Icons\" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="src\resources\icons\CaixaS.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="src\resources\icons\EngrenagemS.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="src\resources\icons\GraficoS.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="src\resources\icons\historicos.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="src\resources\icons\PlusS.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="src\resources\icons\PranchetaS.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="src\resources\icons\SairS.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="src\resources\icons\SinoS.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="src\Resources\Images\user.png" />
  </ItemGroup>

</Project>
