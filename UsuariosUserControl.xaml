<UserControl x:Class="WMS_RadiadoresLemos_WPF.UsuariosUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">

    <Grid Margin="20">
        <!-- Definindo as linhas do layout -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Pesquisa -->
            <RowDefinition Height="*"/>
            <!-- DataGrid para preencher o espaço -->
            <RowDefinition Height="Auto"/>
            <!-- Botões -->
        </Grid.RowDefinitions>

        <!-- Pesquisa de Usuários -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Pesquisar:" VerticalAlignment="Center" FontSize="18" Margin="0,0,10,0"/>
            <TextBox Name="SearchBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" FontSize="18" TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <!-- DataGrid para exibir os usuários -->
        <DataGrid x:Name="UsuariosDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" FontSize="18" 
                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" />
                <DataGridTextColumn Header="Permissão" Binding="{Binding Permissao}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botões de ação -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Adicionar Usuário" Width="195" Margin="5" Click="AdicionarUsuario_Click" FontSize="18"/>
            <Button Content="Editar Usuário" Width="150" Margin="5" Click="EditarUsuario_Click" FontSize="18"/>
            <Button Content="Deletar Usuário" Width="150" Margin="5" Click="DeletarUsuario_Click" FontSize="18"/>
        </StackPanel>
    </Grid>
</UserControl>
