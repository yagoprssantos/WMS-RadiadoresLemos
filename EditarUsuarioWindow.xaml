<Window x:Class="WMS_RadiadoresLemos_WPF.EditarUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Usuário" Height="250" Width="400">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Nome" />
            <TextBox Name="NomeTextBox" />
            <TextBlock Text="E-mail" />
            <TextBox Name="EmailTextBox" />
            <TextBlock Text="Permissão" />
            <ComboBox Name="PermissaoComboBox" Margin="0,5,0,0">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Usuário"/>
                <ComboBoxItem Content="Convidado"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Salvar" Width="80" Margin="5" Click="Salvar_Click"/>
                <Button Content="Cancelar" Width="80" Margin="5" Click="Cancelar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
